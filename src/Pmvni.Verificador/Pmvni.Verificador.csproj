<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console de verificação (desenvolvimento): usa o HostOculto do Pmvni.Composicao.Web. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWinUI>false</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RootNamespace>Pmvni.Verificador</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(VersaoWindowsAppSDK)" />
    <ProjectReference Include="..\Pmvni.Composicao\Pmvni.Composicao.csproj" />
    <ProjectReference Include="..\Pmvni.Composicao.Web\Pmvni.Composicao.Web.csproj" />
    <ProjectReference Include="..\Pmvni.Revisao\Pmvni.Revisao.csproj" />
  </ItemGroup>
</Project>
