<Project Sdk="Microsoft.NET.Sdk">
  <!-- Composição no WebView2 (sem WinUI): host oculto, documento, ponte tipada, impressão. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWinUI>false</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>Pmvni.Composicao.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(VersaoWindowsAppSDK)" />
    <ProjectReference Include="..\Pmvni.Composicao\Pmvni.Composicao.csproj" />
    <ProjectReference Include="..\Pmvni.Revisao\Pmvni.Revisao.csproj" />
    <ProjectReference Include="..\Pmvni.Legislacao\Pmvni.Legislacao.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gerado por web/paginador (npm run build) e commitado: dotnet build não precisa de Node. -->
    <EmbeddedResource Include="web\paginador.js" LogicalName="paginador.js" />
    <InternalsVisibleTo Include="Pmvni.Web.Testes" />
  </ItemGroup>
</Project>
