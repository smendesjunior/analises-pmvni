<UserControl x:Class="Pmvni.App.SeloEstado"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App"
  IsTabStop="False">
  <!-- Selo de estado das linhas dos cartões de Ajustes › Inteligência artificial (como o do WinStatusBar): verde com ✓ ("Configurada") ou neutro com ✗
       ("Não configurada"). As duas versões ficam prontas com ThemeResource e o código só troca qual aparece: acompanha o tema claro e o escuro sozinho. -->
  <Grid VerticalAlignment="Top" HorizontalAlignment="Right">
    <Border x:Name="SeloOk" CornerRadius="10" Padding="9,3,10,3" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <FontIcon Glyph="{x:Bind local:Glifos.Marca}" Style="{StaticResource PmvniIconeSeloSucesso}" AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock x:Name="TextoOk" Style="{StaticResource PmvniTextoSeloSucesso}"/>
      </StackPanel>
    </Border>
    <Border x:Name="SeloNeutro" CornerRadius="10" Padding="9,3,10,3" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <FontIcon Glyph="{x:Bind local:Glifos.NaoConfigurado}" Style="{StaticResource PmvniIconeSeloNeutro}" AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock x:Name="TextoNeutro" Style="{StaticResource PmvniSecondaryTextStyle}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
