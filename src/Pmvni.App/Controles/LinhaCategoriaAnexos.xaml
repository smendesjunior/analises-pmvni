<UserControl x:Class="Pmvni.App.LinhaCategoriaAnexos"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pmvni.App">
  <Grid x:Name="Linha" ColumnDefinitions="4*,5*,Auto" RowDefinitions="Auto,Auto,Auto"
        ColumnSpacing="12" Padding="12,8" SizeChanged="AjustarLinha"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
      <FontIcon x:Name="Icone" FontSize="18" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Nome" TextAlignment="Left" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Descricao" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="Zona" Grid.Column="1" Background="Transparent" MinHeight="50" AllowDrop="True"
          DragOver="Arrastar" DragLeave="Sair" Drop="Soltar">
      <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="4,3"
                 Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" IsHitTestVisible="False"/>
      <Rectangle x:Name="Realce" RadiusX="4" RadiusY="4" StrokeThickness="2" Visibility="Collapsed"
                 Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" IsHitTestVisible="False"/>
      <StackPanel Padding="8" Spacing="4" VerticalAlignment="Center">
        <StackPanel x:Name="Arquivos" Spacing="4"/>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" HorizontalAlignment="Center">
          <FontIcon Glyph="&#xE8B5;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock x:Name="Dica" Grid.Column="1" Text="Arraste e solte arquivos aqui" TextWrapping="Wrap" Style="{StaticResource PmvniSecondaryTextStyle}"/>
        </Grid>
      </StackPanel>
    </Grid>
    <Button x:Name="Botao" Width="160" Padding="8,4" Grid.Column="2" VerticalAlignment="Center" Content="Anexar arquivos"
            local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Anexar}"/>
  </Grid>
</UserControl>
