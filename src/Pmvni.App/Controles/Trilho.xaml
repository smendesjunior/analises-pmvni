<UserControl x:Class="Pmvni.App.Trilho"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Trilho de módulos (estilo Outlook/Store): ícone + rótulo, 64 px, indicador 3 x 16 no módulo ativo; Ajustes embaixo. -->
  <Grid Width="64" Padding="0,4,0,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel x:Name="Cima" Grid.Row="0" Spacing="2"/>
    <StackPanel x:Name="Baixo" Grid.Row="2" Spacing="2"/>
  </Grid>
</UserControl>
