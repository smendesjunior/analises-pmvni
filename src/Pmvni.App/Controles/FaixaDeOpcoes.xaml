<UserControl x:Class="Pmvni.App.FaixaDeOpcoes"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Faixa de opções: abas (SelectorBar) e, embaixo, os comandos da aba (CommandBar, rótulo à direita do ícone). -->
  <StackPanel Padding="8,0,8,2">
    <SelectorBar x:Name="Abas" SelectionChanged="AoMudarAba"/>
    <CommandBar x:Name="Barra" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True"
                Background="Transparent" OverflowButtonVisibility="Auto"/>
  </StackPanel>
</UserControl>
