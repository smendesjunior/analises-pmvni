<UserControl x:Class="Pmvni.App.FaixaDeOpcoes"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Faixa de opções: abas (SelectorBar) e, embaixo, o botão primário do módulo (o mesmo em todas as abas, como "Novo email")
       seguido dos comandos da aba (CommandBar, rótulo à direita do ícone). -->
  <!-- Correções 2026-11-15 (como o Outlook): abas compactas e, embaixo, os comandos numa faixa arredondada só, sem espaço vazio. -->
  <StackPanel Padding="0,0,0,6" Spacing="2">
    <SelectorBar Margin="0" x:Name="Abas" SelectionChanged="AoMudarAba" Padding="0" MinHeight="36"/>
    <Border Style="{StaticResource PmvniSuperficieElevada}" CornerRadius="8" Padding="8,4" Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="VagaPrimario" Grid.Column="0" Padding="0" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False"/>
        <Border Grid.Column="1" Visibility="{Binding Visibility, ElementName=VagaPrimario}" Width="1" Margin="6,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <CommandBar x:Name="Barra" Grid.Column="2" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True"
                    Background="Transparent" OverflowButtonVisibility="Auto">
          <CommandBar.Resources>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <x:Double x:Key="AppBarButtonContentHeight">16</x:Double>
            <!-- 3.2.2: o fundo do hover ocupa o botão inteiro (32 px), igual ao dos botões do início da faixa. -->
            <Thickness x:Key="AppBarButtonInnerBorderMargin">0</Thickness>
            <Thickness x:Key="AppBarToggleButtonInnerBorderMargin">0</Thickness>
            <x:Double x:Key="AppBarThemeCompactHeight">32</x:Double>
            <!-- Correções 2026-11-15: no modelo do WinUI o ícone e o rótulo (rótulo à direita) têm margem 16 em cima e 10 embaixo e ficam
                 3 px abaixo do centro do botão (o fundo ao passar o mouse aparecia acima do texto); aqui, 13 e 13. -->
            <Thickness x:Key="AppBarButtonContentViewboxMargin">8,8,0,8</Thickness>
            <!-- O botão comum usa a margem estática do WinUI (16/10). A mesma margem vertical nos alternadores
                 mantém o ícone e o texto dos dois tipos na mesma linha. -->
            <Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,16,12,10</Thickness>
            <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedDisabled" ResourceKey="AppBarToggleButtonBackgroundDisabled"/>
            <StaticResource x:Key="AppBarToggleButtonForegroundCheckedDisabled" ResourceKey="AppBarToggleButtonForegroundDisabled"/>
          </CommandBar.Resources>
        </CommandBar>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
