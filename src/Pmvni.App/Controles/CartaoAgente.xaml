<UserControl x:Class="Pmvni.App.CartaoAgente"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Um cartão de Ajustes › Inteligência artificial (desenho §12.8): o programa (escolher ou usar o padrão), a situação ("Testar" só roda
       comandos locais, nunca pede nada ao modelo), o acesso (conta do programa ou chave de API guardada pelo Windows) e o aviso. A janela
       (MainWindow.Agentes.cs) o preenche e reage aos botões pelos elementos internal. -->
  <Border Padding="16" CornerRadius="8" BorderThickness="1"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <StackPanel Spacing="14">
      <TextBlock x:Name="Titulo" x:FieldModifier="internal" Style="{StaticResource BodyStrongTextBlockStyle}"/>

      <StackPanel Spacing="6">
        <TextBlock x:Name="TextoPrograma" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="BotaoEscolherPrograma" x:FieldModifier="internal" Content="Escolher programa…"/>
          <Button x:Name="BotaoProgramaPadrao" x:FieldModifier="internal" Content="Usar o padrão"/>
        </StackPanel>
        <TextBlock x:Name="TextoMensagem" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock x:Name="TextoSituacao" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="TextoAvisosDoTeste" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Button x:Name="BotaoTestar" x:FieldModifier="internal" Content="Testar"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Acesso" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <!-- RadioButton soltos (e não o RadioButtons): o Click só vem do usuário, nunca da marcação feita pelo código. -->
        <RadioButton x:Name="OpcaoConta" x:FieldModifier="internal" Content="Usar minha conta (login do programa)"/>
        <RadioButton x:Name="OpcaoChave" x:FieldModifier="internal" Content="Usar chave de API"/>
        <TextBlock x:Name="TextoDicaChave" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel x:Name="PainelChave" x:FieldModifier="internal" Spacing="6" Visibility="Collapsed">
          <PasswordBox x:Name="CaixaChave" x:FieldModifier="internal" PlaceholderText="Cole a chave de API aqui" MaxWidth="420" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="BotaoGuardarChave" x:FieldModifier="internal" Content="Guardar chave"/>
            <Button x:Name="BotaoRemoverChave" x:FieldModifier="internal" Content="Remover chave"/>
          </StackPanel>
          <TextBlock x:Name="TextoChave" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock x:Name="TextoAviso" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
        <Button x:Name="BotaoReverAviso" x:FieldModifier="internal" Content="Rever aviso"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
