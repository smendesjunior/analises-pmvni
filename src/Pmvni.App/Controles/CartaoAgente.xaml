<UserControl x:Class="Pmvni.App.CartaoAgente"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Um cartão de Ajustes › Inteligência artificial (desenho §12.8; visual das correções 2026-11-15): linhas separadas por divisórias —
       Programa (escolher ou usar o padrão), Teste do agente ("Testar" só roda comandos locais), Acesso (conta do programa ou chave de API
       guardada no Cofre de Credenciais do Windows) e o aviso. A janela (MainWindow.Agentes.cs) o preenche pelos elementos internal. -->
  <StackPanel Spacing="0" Padding="4,0">
    <TextBlock x:Name="Titulo" x:FieldModifier="internal" Visibility="Collapsed"/>

    <StackPanel Spacing="8" Padding="0,4,0,14">
      <TextBlock Text="Programa" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <Border CornerRadius="4" Padding="10,6" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ThemeResource ControlFillColorDefaultBrush}">
        <TextBlock x:Name="TextoPrograma" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="BotaoEscolherPrograma" x:FieldModifier="internal" AutomationProperties.Name="Escolher programa…">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14"/><TextBlock Text="Escolher programa…"/></StackPanel>
        </Button>
        <Button x:Name="BotaoProgramaPadrao" x:FieldModifier="internal" Content="Usar o padrão"/>
      </StackPanel>
      <TextBlock x:Name="TextoMensagem" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed"
                 Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
    </StackPanel>
    <Border Style="{StaticResource PmvniAjusteDivisoria}"/>

    <Grid Padding="0,14" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="Teste do agente" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock x:Name="TextoSituacao" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}"/>
        <TextBlock x:Name="TextoAvisosDoTeste" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="BotaoTestar" x:FieldModifier="internal" Grid.Column="1" Content="Testar" MinWidth="110" VerticalAlignment="Center"/>
    </Grid>
    <Border Style="{StaticResource PmvniAjusteDivisoria}"/>

    <StackPanel Spacing="4" Padding="0,14">
      <TextBlock Text="Acesso" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <!-- RadioButton soltos (e não o RadioButtons): o Click só vem do usuário, nunca da marcação feita pelo código. -->
      <RadioButton x:Name="OpcaoConta" x:FieldModifier="internal" Content="Usar minha conta (login do programa)"/>
      <RadioButton x:Name="OpcaoChave" x:FieldModifier="internal" Content="Usar chave de API (guardada protegida pelo Windows, só neste usuário)"/>
      <TextBlock x:Name="TextoDicaChave" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
      <StackPanel x:Name="PainelChave" x:FieldModifier="internal" Spacing="6" Visibility="Collapsed">
        <PasswordBox x:Name="CaixaChave" x:FieldModifier="internal" PlaceholderText="Cole a chave de API aqui" MaxWidth="420" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="BotaoGuardarChave" x:FieldModifier="internal" Content="Guardar chave"/>
          <Button x:Name="BotaoRemoverChave" x:FieldModifier="internal" Content="Remover chave"/>
        </StackPanel>
        <TextBlock x:Name="TextoChave" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
    <Border Style="{StaticResource PmvniAjusteDivisoria}"/>

    <Grid Padding="0,14,0,4" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE946;" FontSize="18" VerticalAlignment="Center"/>
      <TextBlock x:Name="TextoAviso" x:FieldModifier="internal" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Button x:Name="BotaoReverAviso" x:FieldModifier="internal" Grid.Column="2" Content="Rever aviso" MinWidth="110" VerticalAlignment="Center"/>
    </Grid>
  </StackPanel>
</UserControl>
