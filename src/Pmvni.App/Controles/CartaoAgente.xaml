<UserControl x:Class="Pmvni.App.CartaoAgente"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Um cartão de Ajustes › Inteligência artificial no padrão da página "IAs e contas" do WinStatusBar (correções 2026-11-15): cabeçalho com o ícone,
       o nome do programa e Entrar/Sair à direita; o bloco da conta lida neste computador (avatar com as iniciais, nome, e-mail e o link da conta); e
       linhas ícone · título e descrição · valor ou selo, separadas por divisórias: Assinatura, Programa, Situação (Testar), os plugins do kit, Chave de
       API e Aviso. A página se explica pelas próprias linhas. A janela (MainWindow.Agentes.cs) o preenche pelos elementos internal. -->
  <UserControl.Resources>
    <Style x:Key="LinhaCartao" TargetType="Grid">
      <Setter Property="ColumnSpacing" Value="12"/>
      <Setter Property="RowSpacing" Value="8"/>
      <Setter Property="Padding" Value="0,10"/>
      <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    </Style>
    <Style x:Key="IconeLinha" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeSecundarioStyle}">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource PmvniAjusteGrupo}" Padding="16,14,16,6">
    <StackPanel>
      <TextBlock TextAlignment="Left" x:Name="Titulo" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource PmvniAjusteTitulo}"/>

      <!-- Cabeçalho: ícone · nome do programa · Entrar/Sair. -->
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon x:Name="LogoOpenAi" Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource PmvniIconeSecundarioStyle}" VerticalAlignment="Center" Visibility="Collapsed"/>
        <FontIcon x:Name="LogoClaude" Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource PmvniIconeSecundarioStyle}" VerticalAlignment="Center" Visibility="Collapsed"/>
        <FontIcon x:Name="LogoGemini" Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource PmvniIconeSecundarioStyle}" VerticalAlignment="Center" Visibility="Collapsed"/>
        <TextBlock TextAlignment="Left" x:Name="TextoServico" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PmvniAjusteTitulo}"/>
        <!-- Margem negativa: o texto de Entrar/Sair termina na mesma borda dos valores das linhas, sem perder a área de foco. -->
        <HyperlinkButton x:Name="BotaoConta" x:FieldModifier="internal" Grid.Column="2" Padding="8,4" Margin="0,0,-8,0" VerticalAlignment="Center"/>
      </Grid>

      <!-- Conta lida neste computador (nunca o token). -->
      <Grid ColumnSpacing="16" Margin="0,14,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <PersonPicture x:Name="FotoConta" x:FieldModifier="internal" Width="64" Height="64" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextAlignment="Left" x:Name="TextoNomeConta" x:FieldModifier="internal" TextTrimming="CharacterEllipsis" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextAlignment="Left" x:Name="TextoEmailConta" x:FieldModifier="internal"
                     TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}"/>
          <HyperlinkButton HorizontalAlignment="Right" x:Name="LinkConta" x:FieldModifier="internal" Padding="0,2,0,0"/>
        </StackPanel>
      </Grid>
      <TextBlock TextAlignment="Left" x:Name="TextoNotaConta" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" Visibility="Collapsed" Margin="0,0,0,10"/>

      <!-- Assinatura. -->
      <Grid Style="{StaticResource LinhaCartao}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Documento}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <TextBlock TextAlignment="Left" Grid.Column="1" Text="Assinatura" Style="{StaticResource PmvniAjusteTitulo}"/>
        <TextBlock TextAlignment="Left" x:Name="TextoAssinatura" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource PmvniAjusteAjuda}"/>
      </Grid>

      <!-- Programa: o achado neste computador ou o escolhido. -->
      <Grid Style="{StaticResource LinhaCartao}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Engrenagem}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextAlignment="Left" x:Name="TituloPrograma" x:FieldModifier="internal" Text="Programa" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoPrograma" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
          <TextBlock TextAlignment="Left" x:Name="TextoMensagem" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
        </StackPanel>
        <local:SeloEstado x:Name="SeloPrograma" x:FieldModifier="internal" Grid.Column="2"/>
        <StackPanel x:Name="PainelBotoesPrograma" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}">
          <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Editar}" x:Name="BotaoEscolherPrograma" x:FieldModifier="internal" Style="{StaticResource PmvniPainelBotaoPequeno}" Content="Alterar…"
                  local:Dicas.Descricao="Escolhe no computador o programa da IA, se o app não achou o certo."/>
          <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Restaurar}" x:Name="BotaoProgramaPadrao" x:FieldModifier="internal" Style="{StaticResource PmvniPainelBotaoPequeno}" Content="Usar padrão"/>
        </StackPanel>
      </Grid>

      <!-- Situação: consultada sozinha ao abrir a página; Testar confere de novo (só comandos locais, nada vai ao modelo). -->
      <Grid Style="{StaticResource LinhaCartao}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Situacao}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextAlignment="Left" Text="Situação" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoSituacao" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
          <TextBlock TextAlignment="Left" x:Name="TextoAvisosDoTeste" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
        </StackPanel>
        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Conferir}" x:Name="BotaoTestar" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource PmvniPainelBotaoPequeno}" Content="Testar" MinWidth="80" VerticalAlignment="Top"/>
      </Grid>

      <!-- Plugin analise (no Codex para o ChatGPT; no Claude Code para o Claude). -->
      <Grid x:Name="LinhaPluginAnalise" x:FieldModifier="internal" Style="{StaticResource LinhaCartao}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Ia}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextAlignment="Left" x:Name="TituloPluginAnalise" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoPluginAnalise" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoPluginAnaliseNovo" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
        </StackPanel>
        <local:SeloEstado x:Name="SeloPluginAnalise" x:FieldModifier="internal" Grid.Column="2"/>
      </Grid>

      <!-- Rota Claude (ou Gemini) do plugin analise no Codex (só nos cartões do Claude e do Gemini: é o que a análise deles usa). -->
      <Grid x:Name="LinhaPluginPro" x:FieldModifier="internal" Style="{StaticResource LinhaCartao}" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Ia}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextAlignment="Left" x:Name="TituloPluginPro" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoPluginPro" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoPluginProNovo" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
        </StackPanel>
        <local:SeloEstado x:Name="SeloPluginPro" x:FieldModifier="internal" Grid.Column="2"/>
      </Grid>

      <!-- Chave de API: conta do programa (padrão) ou chave guardada pelo editor, protegida pelo Windows (DPAPI). -->
      <Grid Style="{StaticResource LinhaCartao}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Chave}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextAlignment="Left" Text="Chave de API" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoChave" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}"/>
        </StackPanel>
        <local:SeloEstado x:Name="SeloChave" x:FieldModifier="internal" Grid.Column="2"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
          <!-- RadioButton soltos (e não o RadioButtons): o Click só vem do usuário, nunca da marcação feita pelo código. -->
          <RadioButton x:Name="OpcaoContaGemini" x:FieldModifier="internal" Content="Conta Google (login do Gemini, cota do plano)" Visibility="Collapsed"/>
          <RadioButton x:Name="OpcaoConta" x:FieldModifier="internal" Content="Usar minha conta (login do programa)"/>
          <RadioButton x:Name="OpcaoChave" x:FieldModifier="internal" Content="Usar chave de API (guardada protegida pelo Windows, só neste usuário)"/>
          <TextBlock TextAlignment="Left" x:Name="TextoDicaChave" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" Visibility="Collapsed"/>
          <!-- Só o Gemini, modo chave: o perfil da chave (com créditos ou gratuita). O plano de uma chave não é dedutível: o usuário escolhe. -->
          <StackPanel x:Name="PainelPerfil" x:FieldModifier="internal" Spacing="4" Visibility="Collapsed" Margin="0,4,0,0">
            <ComboBox x:Name="CaixaPerfil" x:FieldModifier="internal" Header="Perfil da chave" MinWidth="0" MaxWidth="420" HorizontalAlignment="Stretch"
                      local:Dicas.Descricao="Diz se a chave do Google AI Studio tem créditos (camada paga) ou é gratuita. A gratuita só serve para processos fictícios."/>
          </StackPanel>
          <!-- Só o Gemini: o modelo e o nível de cada etapa de IA no perfil que vale agora. -->
          <TextBlock TextAlignment="Left" x:Name="TextoMatriz" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" Visibility="Collapsed" IsTextSelectionEnabled="True"/>
          <StackPanel x:Name="PainelChave" x:FieldModifier="internal" Spacing="6" Visibility="Collapsed" Margin="0,4,0,0">
            <PasswordBox x:Name="CaixaChave" x:FieldModifier="internal" PlaceholderText="Cole a chave de API aqui" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Salvar}" x:Name="BotaoGuardarChave" x:FieldModifier="internal" Style="{StaticResource PmvniPainelBotaoPequeno}" Content="Guardar chave"
                      local:Dicas.Descricao="Guarda a chave de API protegida pelo Windows, só para este usuário."/>
              <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Excluir}" x:Name="BotaoRemoverChave" x:FieldModifier="internal" Style="{StaticResource PmvniPainelBotaoPequeno}" Content="Remover chave"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Aviso de privacidade aceito antes da primeira análise. -->
      <Grid Style="{StaticResource LinhaCartao}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind local:Glifos.Sobre}" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource IconeLinha}"/>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextAlignment="Left" Text="Aviso antes de analisar" Style="{StaticResource PmvniAjusteTitulo}"/>
          <TextBlock TextAlignment="Left" x:Name="TextoAviso" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}"/>
        </StackPanel>
        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Avisos}" x:Name="BotaoReverAviso" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource PmvniPainelBotaoPequeno}" Content="Rever aviso" VerticalAlignment="Top"
                local:Dicas.Descricao="Mostra de novo o aviso sobre o que é enviado à IA antes de analisar."/>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
