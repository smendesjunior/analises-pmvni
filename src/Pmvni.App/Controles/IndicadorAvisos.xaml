<UserControl x:Class="Pmvni.App.IndicadorAvisos"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Indicador de layout no rodapé (auditoria A2): "2 avisos de layout" ou "1 bloqueio"; abre a lista com "Ir à folha N". Some sem avisos. -->
  <UserControl.Resources>
    <Style x:Key="TextoCritico" TargetType="TextBlock" BasedOn="{StaticResource PmvniAjusteTitulo}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Style>
  </UserControl.Resources>
  <DropDownButton x:Name="Botao" x:FieldModifier="internal" Background="Transparent" BorderThickness="0" Padding="8,4"
                  VerticalAlignment="Center" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon x:Name="Icone" Glyph="{x:Bind local:Glifos.Avisos}" Style="{StaticResource PmvniIconeAcaoSecundario}" AutomationProperties.AccessibilityView="Raw"/>
      <TextBlock TextAlignment="Center" x:Name="Texto" x:FieldModifier="internal" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
    </StackPanel>
    <DropDownButton.Flyout>
      <Flyout x:Name="Lista" Placement="TopEdgeAlignedLeft">
        <ScrollViewer MaxHeight="360" MaxWidth="440" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Linhas" x:FieldModifier="internal" Spacing="10" Padding="0,0,8,0"/>
        </ScrollViewer>
      </Flyout>
    </DropDownButton.Flyout>
  </DropDownButton>
</UserControl>
