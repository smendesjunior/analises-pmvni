<UserControl x:Class="Pmvni.App.EstadoVazio"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Tela vazia de um módulo (auditoria M5): o ícone colorido do módulo (48 px), título, frase, um botão tonal e um secundário e, em
       Relatórios, os recentes que ainda existem. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="24">
    <Border x:Name="VagaIcone" Width="48" Height="48" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    <TextBlock x:Name="Titulo" x:FieldModifier="internal" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1" HorizontalAlignment="Center" MaxWidth="460"
               TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock x:Name="Frase" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" HorizontalAlignment="Center" MaxWidth="460"
               TextAlignment="Center" TextWrapping="Wrap"/>
    <StackPanel x:Name="Botoes" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="BotaoPrimario" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False" Visibility="Collapsed"/>
        <Button x:Name="BotaoSecundario" x:FieldModifier="internal" Visibility="Collapsed" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
    <StackPanel x:Name="AcoesAdicionais" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed"/>
    <!-- Recentes em lista (2026-11-17): ícone do relatório, nome e a pasta; a linha inteira é clicável, dentro de um cartão. -->
    <StackPanel x:Name="PainelRecentes" x:FieldModifier="internal" Spacing="6" Margin="0,18,0,0" Visibility="Collapsed" MinWidth="380">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <FontIcon Glyph="{x:Bind local:Glifos.Recentes}" Style="{StaticResource PmvniIconeAcaoSecundario}"
                  VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock Text="Recentes" Style="{StaticResource PmvniTituloSecao}" AutomationProperties.HeadingLevel="Level2"/>
      </StackPanel>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="4">
        <StackPanel x:Name="ListaRecentes" x:FieldModifier="internal" Spacing="2"/>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
