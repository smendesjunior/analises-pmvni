<Project Sdk="Microsoft.NET.Sdk">
  <!-- App WinUI 3 sem MSIX, autocontido, publicado como executável único. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Exigido pelo Windows App SDK para embutir o resources.pri no executável único. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- O MRT do app sem pacote procura resources.pri (ou <nome do exe>.pri) na pasta de extração;
         o .exe final é renomeado, então o .pri precisa se chamar resources.pri. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Recursos\app.ico</ApplicationIcon>
    <AssemblyName>Pmvni.App</AssemblyName>
    <RootNamespace>Pmvni.App</RootNamespace>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(VersaoWindowsAppSDK)" />
    <!-- Brilho arco-íris de "trabalhando" (2026-11-17): o desfoque das máscaras, como no WinStatusBar (mesma versão). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <ProjectReference Include="..\Pmvni.Composicao.Web\Pmvni.Composicao.Web.csproj" />
    <ProjectReference Include="..\Pmvni.Revisao\Pmvni.Revisao.csproj" />
    <ProjectReference Include="..\Pmvni.Agentes\Pmvni.Agentes.csproj" />
    <ProjectReference Include="..\Pmvni.Legislacao\Pmvni.Legislacao.csproj" />
    <ProjectReference Include="..\Pmvni.Imoveis\Pmvni.Imoveis.csproj" />
    <ProjectReference Include="..\Pmvni.Acompanhamento\Pmvni.Acompanhamento.csproj" />
  </ItemGroup>
  <!-- Carimbo da atualização automática (Atualizador.cs): o tools\build-release.ps1 passa -p:CompilacaoAtualizacao=aaaaMMddHHmmss.
       Sem ele (build de desenvolvimento), a atualização fica desligada. -->
  <ItemGroup Condition="'$(CompilacaoAtualizacao)' != ''">
    <AssemblyMetadata Include="CompilacaoAtualizacao" Value="$(CompilacaoAtualizacao)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ícones dos módulos (pacote Fluent de 2026-11-16), 64 e 128 px: o trilho e as telas vazias escolhem pelo tamanho. -->
    <EmbeddedResource Include="Recursos\Modulos\*.png" LogicalName="Pmvni.App.modulos.%(Filename)%(Extension)" />
    <!-- O ícone do app no cartão "Sobre" dos Ajustes (2026-11-17). -->
    <Content Include="Recursos\Provedores\*.svg;Recursos\app.ico" CopyToOutputDirectory="PreserveNewest"/>
    <EmbeddedResource Include="Recursos\icone-app.png" LogicalName="Pmvni.App.icone-app.png" />
  </ItemGroup>
</Project>
