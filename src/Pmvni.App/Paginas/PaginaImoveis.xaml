<UserControl x:Class="Pmvni.App.PaginaImoveis"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Microsoft.UI.Xaml.Controls"
  xmlns:local="using:Pmvni.App">
  <!-- Módulo Imóveis (2026-11-16): consulta à base QGIS escolhida em Ajustes › Pastas e fontes de dados. A pesquisa é uma linha só (Parâmetro ›
       Condição › valor digitável › lupa); cada resultado tem "Abrir relatório", que mostra o relatório cadastral e territorial (HTML A4)
       num WebView2 desta página. A pesquisa e os resultados ficam como estavam ao voltar. Quem preenche é a janela (MainWindow.Imoveis.cs). -->
  <Grid>
    <!-- ===== Pesquisa ===== -->
    <Grid x:Name="VistaPesquisa" x:FieldModifier="internal" Padding="24,16,24,12" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <!-- Título da página no padrão dos módulos: ícone de 20 px à esquerda e, ao lado, o título com o subtítulo alinhado a ele. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <FontIcon Glyph="{x:Bind local:Glifos.Mapa}" Style="{StaticResource PmvniIconeTituloPagina}" AutomationProperties.AccessibilityView="Raw"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Consulta de imóveis" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Localize inscrições municipais, consulte a situação cadastral e acesse os dados geográficos." TextWrapping="Wrap" Style="{StaticResource PmvniSecondaryTextStyle}"/>
          </StackPanel>
        </Grid>
        <Button x:Name="BotaoConfigurar" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Configurar pasta QGIS" local:Dicas.Descricao="Abre Ajustes › Pastas e fontes de dados para escolher a pasta dos arquivos QGIS.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Gerenciar}" FontSize="16"/><TextBlock Text="Configurar pasta QGIS"/></StackPanel>
        </Button>
      </Grid>

      <!-- Uma linha só: dois ComboBox e um TextBox livre, e a lupa (Enter também pesquisa). -->
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MaxWidth="280"/><ColumnDefinition Width="1.3*" MaxWidth="170"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="CaixaParametro" VerticalAlignment="Center" x:FieldModifier="internal" HorizontalAlignment="Stretch" PlaceholderText="Parâmetro" AutomationProperties.Name="Parâmetro da pesquisa"/>
        <ComboBox x:Name="CaixaCondicao" VerticalAlignment="Center" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Condição"/>
        <Grid Grid.Column="2">
          <TextBox Style="{StaticResource PmvniCampoPesquisa}" x:Name="CaixaValor" VerticalAlignment="Center" x:FieldModifier="internal" MaxLength="512" PlaceholderText="Digite o valor e tecle Enter" AutomationProperties.Name="Valor da pesquisa"/>
          <FontIcon Glyph="{x:Bind local:Glifos.Pesquisar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <Button x:Name="BotaoPesquisar" VerticalAlignment="Center" x:FieldModifier="internal" Grid.Column="3" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False" MinWidth="44"
                AutomationProperties.Name="Pesquisar" local:Dicas.Titulo="Pesquisar" local:Dicas.Atalho="Enter" local:Dicas.Descricao="Pesquisa no cadastro com o parâmetro, a condição e o valor.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Pesquisar}" FontSize="16"/><TextBlock Text="Pesquisar"/></StackPanel>
        </Button>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="PainelDeteccao" x:FieldModifier="internal" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
          <FontIcon Glyph="{x:Bind local:Glifos.Sobre}" FontSize="12" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center"/>
          <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="TextoDeteccao" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis"
                     AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
          <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" x:Name="TextoPasta" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis"/>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="6">
        <!-- Com "Detectar automaticamente": o que a pesquisa vai buscar (ou buscou), para o usuário entender o resultado. -->
        <InfoBar x:Name="Aviso" x:FieldModifier="internal" IsClosable="True" IsOpen="False"/>
        <!-- Quadro "trabalhando" no padrão da pílula da análise (2026-11-17): cantos circulares, barra e texto centralizados. -->
        <Border x:Name="Progresso" x:FieldModifier="internal" Visibility="Collapsed" CornerRadius="24" Padding="24,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <ProgressRing IsActive="True" Width="20" Height="20" VerticalAlignment="Center" local:Trabalhando.Automatico="False"/>
            <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="TextoProgresso" x:FieldModifier="internal" Text="Pesquisando…" TextAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/><TextBlock x:Name="TextoContagem" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}" TextWrapping="Wrap"
                   Text="Escolha um parâmetro e uma condição, digite o valor e tecle Enter."/></StackPanel>
        <local:PainelQuebra Grid.Column="1" HorizontalAlignment="Right" x:Name="ResumoVinculos" x:FieldModifier="internal" Espaco="8" EspacoLinhas="4" Visibility="Collapsed"/></Grid>
      </StackPanel>

      <Grid Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="CabecalhoTabela" x:FieldModifier="internal" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        <ListView x:Name="ListaResultados" x:FieldModifier="internal" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="Imóveis encontrados">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
          </ListView.ItemContainerStyle>
        </ListView>
        <StackPanel x:Name="Vazio" x:FieldModifier="internal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460" Padding="16">
          <FontIcon Glyph="{x:Bind local:Glifos.Mapa}" FontSize="64" Style="{StaticResource PmvniIconeSecundarioStyle}" HorizontalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock x:Name="TextoVazio" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
          <Button x:Name="BotaoConfigurarVazio" x:FieldModifier="internal" HorizontalAlignment="Center" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                  AutomationProperties.Name="Configurar pasta QGIS" local:Dicas.Descricao="Abre Ajustes › Pastas e fontes de dados para escolher a pasta dos arquivos QGIS.">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Gerenciar}" FontSize="16"/><TextBlock Text="Configurar pasta QGIS"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="4" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TextoPaginacao" x:FieldModifier="internal" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
        <Button x:Name="BotaoAnterior" x:FieldModifier="internal" Grid.Column="1" IsEnabled="False" AutomationProperties.Name="Página anterior dos resultados">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Anterior}" FontSize="16"/><TextBlock Text="Anterior"/></StackPanel>
        </Button>
        <Button x:Name="BotaoProxima" x:FieldModifier="internal" Grid.Column="2" IsEnabled="False" AutomationProperties.Name="Próxima página dos resultados">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Proximo}" FontSize="16"/><TextBlock Text="Próxima"/></StackPanel>
        </Button>
      </Grid>
    </Grid>

    <!-- ===== Relatório ===== -->
    <Grid x:Name="VistaRelatorio" x:FieldModifier="internal" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="12,6" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BotaoVoltar" x:FieldModifier="internal" Style="{StaticResource PmvniBarraButtonStyle}" AutomationProperties.Name="Voltar à pesquisa"
                local:Dicas.Titulo="Voltar à pesquisa" local:Dicas.Descricao="Volta à pesquisa, com os resultados como estavam.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Voltar}" FontSize="16"/><TextBlock Text="Voltar à pesquisa"/></StackPanel>
        </Button>
        <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="TituloRelatorio" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PmvniAjusteTitulo}" AutomationProperties.HeadingLevel="Level1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <!-- Cotas do lote no mapa (lados, domínio DNIT e eixo → terreno, largura da rua): ligadas por padrão; a escolha vale até fechar o app. -->
        <ToggleButton x:Name="BotaoCotas" x:FieldModifier="internal" Grid.Column="2" IsChecked="True" AutomationProperties.Name="Cotas no mapa"
                      local:Dicas.Titulo="Cotas no mapa" local:Dicas.Descricao="Mostra ou esconde as cotas do lote no mapa: lados do lote, faixa de domínio do DNIT e distância do eixo ao terreno (BR-262 perto) e largura da rua em frente, medidas na base.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Cotas}" FontSize="16"/><TextBlock Text="Cotas"/></StackPanel>
        </ToggleButton>
        <Button x:Name="BotaoImprimir" x:FieldModifier="internal" Grid.Column="3" AutomationProperties.Name="Imprimir o relatório"
                local:Dicas.Titulo="Imprimir" local:Dicas.Atalho="Ctrl+P" local:Dicas.Descricao="Abre as opções de impressão do relatório.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Imprimir}" FontSize="16"/><TextBlock Text="Imprimir"/></StackPanel>
        </Button>
        <Button x:Name="BotaoPdf" x:FieldModifier="internal" Grid.Column="4" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False" AutomationProperties.Name="Salvar o relatório em PDF" local:Dicas.Descricao="Escolhe onde salvar o relatório em PDF.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Exportar}" FontSize="16"/><TextBlock Text="Salvar PDF…"/></StackPanel>
        </Button>
      </Grid>
      <!-- O WebView2 do relatório é criado por código na primeira abertura, com a vista já visível (criado oculto, ele não desenhava). -->
      <Grid x:Name="HostLeitor" x:FieldModifier="internal" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
      <ProgressRing x:Name="ProgressoRelatorio" x:FieldModifier="internal" Grid.Row="1" IsActive="False" Width="40" Height="40" local:Trabalhando.Automatico="False"/>
    </Grid>
  </Grid>
</UserControl>
