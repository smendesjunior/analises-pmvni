<UserControl x:Class="Pmvni.App.PaginaNovoDespacho"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Novo despacho (desenho §10.2–§10.4, §10.7): no módulo Despachos, no lugar da lista enquanto está aberta. Coluna esquerda: passo 1
       (tipo, processo, relatório base, pasta da etapa) e passo 2 (cabeçalho e exigências, ou tipo de obra e área). Direita: as folhas
       A4 da prévia, no modelo do kit, editáveis no texto variável. Passo 3: as páginas do PDF gerado na pasta de trabalho, cada uma com a sua caixa "Conferi". Nada é
       gravado na pasta do processo antes de "Gravar na pasta do processo". Quem liga os controles é a janela (MainWindow.NovoDespacho.cs). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoBloqueio" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False"/>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
    </local:AreaDeAvisos>

    <!-- Passos 1 e 2. -->
    <Grid x:Name="PainelEdicao" x:FieldModifier="internal" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="380" MinWidth="300"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <StackPanel Padding="20,14,20,20" Spacing="12">
          <TextBlock x:Name="TextoTitulo" x:FieldModifier="internal" Text="Novo despacho" Style="{StaticResource SubtitleTextBlockStyle}"/>
          <TextBlock Text="1. Origem" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <ComboBox x:Name="CaixaTipo" x:FieldModifier="internal" Header="Tipo" HorizontalAlignment="Stretch" AutomationProperties.Name="Tipo do despacho"/>
          <ComboBox x:Name="CaixaProcesso" x:FieldModifier="internal" Header="Processo" HorizontalAlignment="Stretch" AutomationProperties.Name="Processo"/>
          <!-- Relatório base: os achados na pasta do processo, "Sem relatório" ou um escolhido à mão (.pmvrel de qualquer pasta, ou o
               dados.json da análise do kit, importado para um .pmvrel novo antes de usar). -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="CaixaRelatorio" x:FieldModifier="internal" Header="Relatório base (.pmvrel)" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Relatório base"/>
            <Button x:Name="BotaoEscolherRelatorio" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Bottom"
                    AutomationProperties.Name="Escolher o arquivo do relatório"
                    local:Dicas.Titulo="Escolher arquivo…" local:Dicas.Descricao="Usa um relatório (.pmvrel) de qualquer pasta, ou o dados.json da análise.">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="14"/><TextBlock Text="Escolher arquivo…"/></StackPanel>
            </Button>
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="CaixaEtapa" x:FieldModifier="internal" Header="Pasta da etapa" HorizontalAlignment="Stretch" AutomationProperties.Name="Pasta da etapa"/>
            <Button x:Name="BotaoNovaPasta" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Bottom" AutomationProperties.Name="Criar pasta nova"
                    local:Dicas.Titulo="Nova pasta…" local:Dicas.Descricao="Cria uma pasta de etapa nova no processo para guardar este despacho.">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8F4;" FontSize="14"/><TextBlock Text="Nova pasta…"/></StackPanel>
            </Button>
          </Grid>
          <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                     Text="O relatório é opcional. Anexado, entram só os itens que não atendem; sem ele, escreva as exigências ou peça à IA. Um relatório de outra pasta entra pelo Escolher arquivo. A data é a da pasta da etapa."/>

          <StackPanel x:Name="PainelConteudo" x:FieldModifier="internal" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="2. Conteúdo" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
            <TextBox x:Name="CaixaProtocolo" x:FieldModifier="internal" Header="Protocolo nº" AutomationProperties.Name="Protocolo"/>
            <TextBox x:Name="CaixaRequerente" x:FieldModifier="internal" Header="Requerente" AutomationProperties.Name="Requerente"/>
            <TextBox x:Name="CaixaAssunto" x:FieldModifier="internal" Header="Assunto" AutomationProperties.Name="Assunto"/>
            <StackPanel x:Name="PainelExigencias" x:FieldModifier="internal" Spacing="10"/>
            <Button x:Name="BotaoAdicionarExigencia" x:FieldModifier="internal" AutomationProperties.Name="Adicionar exigência"
                    local:Dicas.Descricao="Acrescenta uma exigência em branco para você escrever.">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Adicionar exigência"/></StackPanel>
            </Button>
            <StackPanel x:Name="PainelAprovacao" x:FieldModifier="internal" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="Tipo de obra" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <CheckBox x:Name="CaixaObraNova" x:FieldModifier="internal" Content="obra nova"/>
              <CheckBox x:Name="CaixaAlteracao" x:FieldModifier="internal" Content="alteração de obra"/>
              <CheckBox x:Name="CaixaAmpliacao" x:FieldModifier="internal" Content="ampliação de obra"/>
              <TextBox x:Name="CaixaArea" x:FieldModifier="internal" Header="Área total a construir (m²)" PlaceholderText="ex.: 210,52"
                       AutomationProperties.Name="Área total a construir" Margin="0,6,0,0"/>
              <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                         Text="O editor não preenche o tipo de obra nem a área: os dois vêm do projeto aprovado."/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- A prévia no modelo oficial (correções 2026-11-15): uma folha A4 por página, com cabeçalho, tarja e rodapé lidos do DOCX do kit; o
           texto variável se edita clicando nele na folha. Atualizada a cada mudança. -->
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" HorizontalAlignment="Center">
          <!-- Instrução para a IA (como o Copilot do Word): modifica o despacho em edição. -->
          <Border Width="794" Margin="0,0,0,12" Padding="12,4,6,4" CornerRadius="22" BorderThickness="1"
                  BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE945;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
              <TextBox x:Name="CaixaInstrucao" x:FieldModifier="internal" Grid.Column="1" BorderThickness="0" Background="Transparent" AcceptsReturn="False"
                       TextWrapping="Wrap" PlaceholderText="Descreva o que mudar no despacho (ex.: junte os itens de cotas; cite o art. 12 da LC 70)"
                       AutomationProperties.Name="Instrução para a IA modificar o despacho"/>
              <ProgressRing x:Name="AnelInstrucao" x:FieldModifier="internal" Grid.Column="2" IsActive="False" Width="18" Height="18" Visibility="Collapsed"/>
              <Button x:Name="BotaoAplicarInstrucao" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" CornerRadius="16"
                      AutomationProperties.Name="Aplicar a instrução" local:Dicas.Titulo="Pedir à IA" local:Dicas.Atalho="Enter"
                      local:Dicas.Descricao="Manda a instrução escrita ao lado para a IA mudar o despacho.">
                <FontIcon Glyph="&#xE724;" FontSize="14"/>
              </Button>
            </Grid>
          </Border>
          <TextBlock Text="Prévia no modelo oficial. Clique no protocolo, requerente, assunto, data, grupos ou exigências para editar; o resto é texto fixo do modelo. As páginas finais são conferidas no PDF."
                     Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Width="794" Margin="0,0,0,8"/>
          <StackPanel x:Name="Folhas" x:FieldModifier="internal" Spacing="16" AutomationProperties.Name="Prévia do despacho"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Passo 3: conferência das páginas do PDF (ou o aviso de que sai só o DOCX). -->
    <Grid x:Name="PainelConferencia" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Padding="20,12,20,6" Spacing="8">
        <TextBlock x:Name="TextoTituloConferencia" x:FieldModifier="internal" Text="3. Conferência" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <InfoBar x:Name="AvisoErros" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False" Title="O despacho gerado não passou na validação"/>
        <InfoBar x:Name="AvisoSemPdf" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="False" Title="Sem PDF"/>
        <TextBlock x:Name="TextoFontes" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="TextoPaginas" x:FieldModifier="internal" VerticalAlignment="Center"/>
          <Button x:Name="BotaoMarcarTodas" x:FieldModifier="internal" Content="Marcar todas" Visibility="Collapsed"
                  local:Dicas.Descricao="Marca todas as páginas do PDF como conferidas."/>
        </StackPanel>
      </StackPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListaPaginas" x:FieldModifier="internal" Padding="24" Spacing="18" HorizontalAlignment="Center"/>
      </ScrollViewer>
    </Grid>

    <!-- Espera (gerar, gravar): Cancelar interrompe a geração e apaga a pasta de trabalho. -->
    <Grid x:Name="Espera" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8">
        <ProgressRing x:Name="Anel" x:FieldModifier="internal" IsActive="False" Width="32" Height="32"/>
        <TextBlock x:Name="TextoEspera" x:FieldModifier="internal" HorizontalAlignment="Center"/>
        <Button x:Name="BotaoInterromper" x:FieldModifier="internal" Content="Cancelar" HorizontalAlignment="Center"
                local:Dicas.Descricao="Interrompe a geração e apaga a pasta de trabalho."/>
      </StackPanel>
    </Grid>

    <!-- Rodapé: o que falta preencher, acima de "Gerar e conferir" (seta como ícone: o Narrador não lê "triângulo"). -->
    <Grid Grid.Row="2" Padding="20,8,20,12" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="PainelFaltando" x:FieldModifier="internal" Grid.Column="0" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="Falta preencher:" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        <TextBlock x:Name="TextoFaltando" x:FieldModifier="internal" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button x:Name="BotaoCancelar" x:FieldModifier="internal" Content="Cancelar"
                local:Dicas.Descricao="Fecha o novo despacho sem gravar nada."/>
        <Button x:Name="BotaoVoltar" x:FieldModifier="internal" Content="Voltar e editar" Visibility="Collapsed"
                local:Dicas.Descricao="Volta para a edição do despacho, antes de gravar."/>
        <Button x:Name="BotaoGerar" x:FieldModifier="internal" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                AutomationProperties.Name="Gerar e conferir"
                local:Dicas.Descricao="Gera o DOCX e o PDF do despacho e mostra as páginas para conferir.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Gerar e conferir"/>
            <FontIcon Glyph="&#xE72A;" FontSize="12"/>
          </StackPanel>
        </Button>
        <Button x:Name="BotaoGravar" x:FieldModifier="internal" Content="Gravar na pasta do processo" Style="{StaticResource AccentButtonStyle}"
                IsEnabled="False" Visibility="Collapsed"
                local:Dicas.Descricao="Grava o despacho conferido na pasta da etapa do processo."/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
