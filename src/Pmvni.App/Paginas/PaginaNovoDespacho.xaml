<UserControl x:Class="Pmvni.App.PaginaNovoDespacho"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Novo despacho (desenho §10.2–§10.4, §10.7): no módulo Despachos, no lugar da lista enquanto está aberta. Coluna esquerda: passo 1
       (tipo, processo, relatório base, pasta da etapa) e passo 2 (cabeçalho e exigências, ou tipo de obra e área). Direita: as folhas
       A4 da prévia, no modelo do kit, editáveis no texto variável. Passo 3: as páginas do PDF gerado na pasta de trabalho, cada uma com a sua caixa "Conferi". Nada é
       gravado na pasta do processo antes de "Gravar na pasta do processo". Quem liga os controles é a janela (MainWindow.NovoDespacho.cs). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoBloqueio" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False"/>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
    </local:AreaDeAvisos>

    <!-- Passos 1 e 2. -->
    <Grid x:Name="PainelEdicao" x:FieldModifier="internal" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="420" MinWidth="300"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="1" Style="{StaticResource PmvniPainelLateral}" Margin="6" RowDefinitions="*,Auto"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <!-- Cartões de origem e conteúdo com os estilos de painel de Estilos.xaml. -->
        <StackPanel Padding="16,14,16,20" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TextoTitulo" x:FieldModifier="internal" Text="Novo despacho" Style="{StaticResource PmvniTituloPaginaStyle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <Border Grid.Column="1" Background="Transparent">
              <Button x:Name="FecharOrigem" x:FieldModifier="internal" Width="32" Height="32" Padding="0"
                      IsEnabled="{Binding IsEnabled, ElementName=BotaoCancelar}" AutomationProperties.Name="Fechar novo despacho"
                      local:Dicas.Descricao="Fecha o novo despacho sem gravar.">
                <FontIcon Glyph="{x:Bind local:Glifos.Fechar}" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
              </Button>
            </Border>
          </Grid>
          <TextBlock Text="Defina a origem e os documentos de referência." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>

          <Border Style="{StaticResource PmvniPainelCartao}">
            <StackPanel>
              <Border Style="{StaticResource PmvniPainelCartaoCabecalho}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Style="{StaticResource PmvniSeloPasso}"><TextBlock Text="1" Style="{StaticResource PmvniNumeroPasso}"/></Border>
                  <TextBlock Text="Origem" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level2"/>
                </StackPanel>
              </Border>
              <StackPanel Style="{StaticResource PmvniPainelCartaoCorpo}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Tipo" Style="{StaticResource PmvniPainelRotulo}"/>
                  <ComboBox x:Name="CaixaTipo" x:FieldModifier="internal" HorizontalAlignment="Stretch" AutomationProperties.Name="Tipo do despacho"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Processo" Style="{StaticResource PmvniPainelRotulo}"/>
                  <ComboBox x:Name="CaixaProcesso" x:FieldModifier="internal" HorizontalAlignment="Stretch" AutomationProperties.Name="Processo"/>
                  <Grid ColumnSpacing="6" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="BotaoNovoProcesso" x:FieldModifier="internal" Content="Criar processo…" HorizontalAlignment="Stretch" AutomationProperties.Name="Criar um processo novo"
                            local:Dicas.Titulo="Criar processo…" local:Dicas.Descricao="Cria a pasta de um processo novo (número, ano e requerente) e já o escolhe para o despacho."/>
                    <Button x:Name="BotaoSemProcesso" x:FieldModifier="internal" Grid.Column="1" Content="Sem processo" HorizontalAlignment="Stretch" AutomationProperties.Name="Despacho sem processo vinculado"
                            local:Dicas.Titulo="Prosseguir sem processo" local:Dicas.Descricao="Libera o modelo para preencher na folha, sem ligar a um processo; o despacho é gravado em Documentos › Despachos sem processo."/>
                  </Grid>
                </StackPanel>
                <Border Style="{StaticResource PmvniPainelSeparador}"/>
                <!-- Relatório base: os achados na pasta do processo, "Sem relatório" ou um escolhido à mão (.rpmvni de qualquer pasta, ou o
                     dados.json da análise do kit, importado para um .rpmvni novo antes de usar). -->
                <StackPanel Spacing="4">
                  <TextBlock Text="Documentos de referência" Style="{StaticResource PmvniPainelCartaoTitulo}"/>
                  <TextBlock Text="Relatório base" Style="{StaticResource PmvniPainelRotulo}"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="11*"/><ColumnDefinition Width="10*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="CaixaRelatorio" x:FieldModifier="internal" ToolTipService.ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Stretch" AutomationProperties.Name="Relatório base"/>
                    <Button x:Name="BotaoEscolherRelatorio" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Escolher o arquivo do relatório"
                            local:Dicas.Titulo="Escolher arquivo…" local:Dicas.Descricao="Usa um relatório (.rpmvni) de qualquer pasta, ou o dados.json da análise.">
                      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Abrir}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Escolher arquivo…"/></StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Pasta da etapa" Style="{StaticResource PmvniPainelRotulo}"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="11*"/><ColumnDefinition Width="10*"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="CaixaEtapa" x:FieldModifier="internal" ToolTipService.ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Stretch" AutomationProperties.Name="Pasta da etapa"/>
                    <Button x:Name="BotaoNovaPasta" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Criar pasta nova"
                            local:Dicas.Titulo="Criar pasta…" local:Dicas.Descricao="Cria uma pasta de etapa nova no processo para guardar este despacho.">
                      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Adicionar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Criar pasta…"/></StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="{x:Bind local:Glifos.Sobre}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}"
                                VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock Text="Como funciona" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level3"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                               Text="O relatório é opcional. Anexado, entram só os itens que não atendem; sem ele, escreva as exigências ou peça à IA. Use Escolher arquivo… para um relatório de outra pasta. A data é a da pasta da etapa."/>
                  </StackPanel>
                </Border>

              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="PainelConteudo" x:FieldModifier="internal" Style="{StaticResource PmvniPainelCartao}" Visibility="Collapsed">
            <StackPanel>
              <Border Style="{StaticResource PmvniPainelCartaoCabecalho}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Style="{StaticResource PmvniSeloPasso}"><TextBlock Text="2" Style="{StaticResource PmvniNumeroPasso}"/></Border>
                  <TextBlock Text="Conteúdo" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level2"/>
                </StackPanel>
              </Border>
              <StackPanel Style="{StaticResource PmvniPainelCartaoCorpo}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Protocolo nº" Style="{StaticResource PmvniPainelRotulo}"/>
                  <TextBox x:Name="CaixaProtocolo" x:FieldModifier="internal" AutomationProperties.Name="Protocolo"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Requerente" Style="{StaticResource PmvniPainelRotulo}"/>
                  <TextBox x:Name="CaixaRequerente" x:FieldModifier="internal" AutomationProperties.Name="Requerente"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Assunto" Style="{StaticResource PmvniPainelRotulo}"/>
                  <TextBox x:Name="CaixaAssunto" x:FieldModifier="internal" AutomationProperties.Name="Assunto" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Style="{StaticResource PmvniPainelSeparador}"/>
                <StackPanel x:Name="PainelExigencias" x:FieldModifier="internal" Spacing="10"/>
                <Button x:Name="BotaoAdicionarExigencia" x:FieldModifier="internal" AutomationProperties.Name="Adicionar exigência" HorizontalAlignment="Stretch"
                        local:Dicas.Titulo="Adicionar exigência…" local:Dicas.Descricao="Abre a caixa para escrever uma exigência.">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Adicionar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Adicionar exigência…"/></StackPanel>
                </Button>
                <StackPanel x:Name="PainelAprovacao" x:FieldModifier="internal" Spacing="6" Visibility="Collapsed">
                  <TextBlock Text="Tipo de obra" Style="{StaticResource PmvniPainelRotulo}"/>
                  <CheckBox x:Name="CaixaObraNova" x:FieldModifier="internal" Content="obra nova"/>
                  <CheckBox x:Name="CaixaAlteracao" x:FieldModifier="internal" Content="alteração de obra"/>
                  <CheckBox x:Name="CaixaAmpliacao" x:FieldModifier="internal" Content="ampliação de obra"/>
                  <TextBlock Text="Área total a construir (m²)" Style="{StaticResource PmvniPainelRotulo}" Margin="0,6,0,0"/>
                  <TextBox x:Name="CaixaArea" x:FieldModifier="internal" PlaceholderText="ex.: 210,52" AutomationProperties.Name="Área total a construir"/>
                  <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                             Text="O editor não preenche o tipo de obra nem a área: os dois vêm do projeto aprovado."/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
        <Border Grid.Row="1" Padding="16,8" Visibility="{Binding Visibility, ElementName=BotaoAutomatico}">                <!-- Correção automática (2026-11-16): só no tipo Correção; a janela mostra e liga o botão. -->
                <Button x:Name="BotaoAutomatico" x:FieldModifier="internal" HorizontalAlignment="Stretch" Visibility="Collapsed"
                        AutomationProperties.Name="Criar automaticamente a partir do relatório"
                        local:Dicas.Titulo="Criar automaticamente a partir do relatório"
                        local:Dicas.Descricao="Monta o despacho com todos os itens pendentes do relatório (não atende, falta comprovar e informações divergentes) e vai direto para a conferência.">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Relatorio}" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Criar automaticamente a partir do relatório" TextWrapping="Wrap"/></StackPanel>
                </Button>
        </Border></Grid>

      <!-- A prévia no modelo oficial (correções 2026-11-15): uma folha A4 por página, com cabeçalho, tarja e rodapé lidos do DOCX do kit; o
           texto variável se edita clicando nele na folha. Atualizada a cada mudança. -->
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" HorizontalAlignment="Center">
          <!-- Instrução para a IA (como o Copilot do Word): modifica o despacho em edição. -->
          <Border Width="794" Margin="0,0,0,12" Padding="12,4,6,4" CornerRadius="22" BorderThickness="1"
                  BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
              <TextBox x:Name="CaixaInstrucao" x:FieldModifier="internal" Grid.Column="1" BorderThickness="0" Background="Transparent" AcceptsReturn="False"
                       TextWrapping="Wrap" PlaceholderText="Descreva o que mudar no despacho. Ex.: junte os itens de cotas."
                       AutomationProperties.Name="Instrução para a IA modificar o despacho"/>
              <ProgressRing x:Name="AnelInstrucao" x:FieldModifier="internal" Grid.Column="2" AutomationProperties.Name="Aplicando a instrução com IA" AutomationProperties.LiveSetting="Polite" IsActive="False" Width="18" Height="18" Visibility="Collapsed"/>
              <Button x:Name="BotaoAplicarInstrucao" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                      Width="32" Height="32" MinWidth="0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      AutomationProperties.Name="Aplicar a instrução" local:Dicas.Titulo="Pedir à IA" local:Dicas.Atalho="Enter"
                      local:Dicas.Descricao="Manda a instrução escrita ao lado para a IA mudar o despacho.">
                <FontIcon Glyph="{x:Bind local:Glifos.Avancar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
              </Button>
            </Grid>
          </Border>
          <TextBlock Text="Prévia no modelo oficial. Clique no protocolo, requerente, assunto, data, grupos ou exigências para editar; o resto é texto fixo do modelo. As páginas finais são conferidas no PDF."
                     Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Width="794" Margin="0,0,0,8"/>
          <StackPanel x:Name="Folhas" x:FieldModifier="internal" Spacing="16" AutomationProperties.Name="Prévia do despacho"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Passo 3: conferência das páginas do PDF (ou o aviso de que sai só o DOCX). -->
    <Grid x:Name="PainelConferencia" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Padding="20,12,20,6" Spacing="8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Border x:Name="SeloConferencia" x:FieldModifier="internal" Style="{StaticResource PmvniSeloPasso}"><TextBlock Text="3" Style="{StaticResource PmvniNumeroPasso}"/></Border>
          <TextBlock TextAlignment="Center" x:Name="TextoTituloConferencia" x:FieldModifier="internal" Text="Conferência" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1"/>
        </StackPanel>
        <InfoBar x:Name="AvisoErros" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False" Title="O despacho gerado não passou na validação"/>
        <InfoBar x:Name="AvisoSemPdf" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="False" Title="Sem PDF"/>
        <TextBlock x:Name="TextoFontes" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="TextoPaginas" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"/>
          <Button x:Name="BotaoMarcarTodas" x:FieldModifier="internal" Content="Marcar todas as páginas" Visibility="Collapsed"
                  local:Dicas.Descricao="Marca todas as páginas do PDF como conferidas."/>
        </StackPanel>
      </StackPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ListaPaginas" x:FieldModifier="internal" Padding="24" Spacing="18" HorizontalAlignment="Center"/>
      </ScrollViewer>
    </Grid>

    <!-- Espera (gerar, gravar): Cancelar interrompe a geração e apaga a pasta de trabalho. -->
    <Grid x:Name="Espera" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8">
        <ProgressRing x:Name="Anel" x:FieldModifier="internal" IsActive="False" Width="32" Height="32"/>
        <TextBlock x:Name="TextoEspera" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="BotaoInterromper" x:FieldModifier="internal" Content="Cancelar geração" HorizontalAlignment="Center"
                local:Dicas.Descricao="Interrompe a geração e apaga a pasta de trabalho."/>
      </StackPanel>
    </Grid>

    <!-- Rodapé: requisitos da etapa e ações na ordem de tabulação. -->
    <Grid Grid.Row="2" Padding="20,8,20,12" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="PainelFaltando" x:FieldModifier="internal" Grid.Column="0" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock TextAlignment="Center" Text="Falta preencher:" Style="{StaticResource PmvniTextoErroStyle}"/>
        <TextBlock x:Name="TextoFaltando" x:FieldModifier="internal" Style="{StaticResource PmvniTextoErroStyle}" TextAlignment="Left" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Border Background="Transparent" Visibility="{Binding Visibility, ElementName=BotaoGerar}">
          <Button x:Name="BotaoGerar" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False" IsEnabled="False"
                  AutomationProperties.Name="Gerar e conferir"
                  local:Dicas.Descricao="Gera o documento Word e o PDF do despacho e mostra as páginas para conferir.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Conferir}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Gerar e conferir"/>
            </StackPanel>
          </Button>
        </Border>
        <Border Background="Transparent" Visibility="{Binding Visibility, ElementName=BotaoGravar}">
          <Button x:Name="BotaoGravar" x:FieldModifier="internal" Content="Gravar na pasta do processo" Style="{StaticResource PmvniBotaoPrimarioStyle}"
                  local:Brilho.Ativo="False" IsEnabled="False" Visibility="Collapsed"
                  local:Dicas.Descricao="Grava o despacho conferido na pasta da etapa do processo."/>
        </Border>
        <Border Background="Transparent" Visibility="{Binding Visibility, ElementName=BotaoVoltar}">
          <Button x:Name="BotaoVoltar" x:FieldModifier="internal" Content="Voltar e editar" Visibility="Collapsed"
                  local:Dicas.Descricao="Volta para a edição do despacho, antes de gravar."/>
        </Border>
        <Border Background="Transparent">
          <Button x:Name="BotaoCancelar" x:FieldModifier="internal" Content="Cancelar"
                  local:Dicas.Descricao="Fecha o novo despacho sem gravar nada."/>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
