<UserControl x:Class="Pmvni.App.PaginaRelatorios"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Microsoft.UI.Xaml.Controls"
  xmlns:local="using:Pmvni.App">
  <!-- Módulo Relatórios: avisos, painel lateral (Seções | Excluídos | Histórico), as folhas A4 (WebView2, criado uma vez),
       Propriedades do item selecionado e o rodapé (zoom, folha X de Y). -->
  <Grid Padding="0,12,0,0">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="RodapeEmUmaLinha">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="RodapeEmDuasLinhas">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="GrupoZoom.(Grid.ColumnSpan)" Value="4"/>
            <Setter Target="IndicadorLayout.(Grid.Row)" Value="1"/>
            <Setter Target="IndicadorLayout.(Grid.Column)" Value="0"/>
            <Setter Target="TextoComposicao.(Grid.Row)" Value="1"/>
            <Setter Target="TextoComposicao.(Grid.Column)" Value="1"/>
            <Setter Target="TextoComposicao.(Grid.ColumnSpan)" Value="2"/>
            <Setter Target="PainelFolha.(Grid.Row)" Value="1"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Avisos (InfoBar) que pedem ação imediata e o resultado das operações (no máximo 2 à vista; o resto em "+n"). Os de layout (largura,
         blocos que não cabem, conteúdo além da borda) vão para o indicador do rodapé; com Ajustes › Geral › Aparência › "Faixas no topo", voltam
         para cá (AvisoLargura, AvisoEstouro, AvisoForaDaArea). -->
    <!-- Correções 2026-11-15: afastada da borda arredondada da área das páginas (antes encostava no canto e no trilho). -->
    <local:AreaDeAvisos RecuoAberto="0,0,0,12" x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <!-- Tarefa 10: conflito na gravação (com as duas saídas), somente leitura (trava de outro, perdida, esquema novo) e diário com falha. -->
      <InfoBar x:Name="AvisoConflito" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False"
               Title="Conflito: o arquivo mudou no disco">
        <InfoBar.Content>
          <StackPanel local:AcoesDeAviso.AutoOcultar="True" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.SalvarComo}" x:Name="BotaoSalvarCopia" x:FieldModifier="internal" Content="Salvar como cópia" Style="{StaticResource PmvniBotaoPrimarioStyle}"
                    local:Dicas.Descricao="Grava as suas alterações num arquivo novo, sem mexer no arquivo que mudou no disco."/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atualizar}" x:Name="BotaoRecarregar" x:FieldModifier="internal" Content="Recarregar"
                    local:Dicas.Descricao="Deixa de lado o que está na tela e abre a versão que está no disco."/>
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
      <!-- Onda 1, item 1: a última alteração está no relatório mas a tela não foi recomposta; a exportação fica bloqueada até recompor. -->
      <InfoBar x:Name="AvisoDesatualizado" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False"
               Title="As folhas não mostram a última alteração">
        <InfoBar.Content>
          <StackPanel local:AcoesDeAviso.AutoOcultar="True" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atualizar}" x:Name="BotaoRecompor" x:FieldModifier="internal" Content="Recompor" Style="{StaticResource PmvniBotaoPrimarioStyle}"
                    local:Dicas.Descricao="Refaz as folhas com a última alteração; depois disso o PDF pode ser exportado."/>
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
      <InfoBar x:Name="AvisoSomenteLeitura" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="True"
               Title="Somente leitura"/>
      <InfoBar x:Name="AvisoDiario" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="True"
               Title="O diário de recuperação não está sendo gravado"/>
      <InfoBar x:Name="AvisoLargura" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True" Tag="fixo"/>
      <InfoBar x:Name="AvisoEstouro" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="False"/>
      <InfoBar x:Name="AvisoBloqueio" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="True"
               Title="Exportação bloqueada"/>
      <InfoBar x:Name="AvisoForaDaArea" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True" Tag="fixo"/>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
    </local:AreaDeAvisos>

    <Grid x:Name="CorpoRelatorio" Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Painel lateral (recolhível por Exibir › Painel lateral): abas Seções, Excluídos (n) e Histórico. -->
      <Grid x:Name="PainelNavegacao" x:FieldModifier="internal" Grid.Column="0" Width="{StaticResource PmvniLarguraPainelSecoes}" Style="{StaticResource PmvniPainelLateral}" Padding="0,4,0,4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Arrastar a borda muda a largura do painel (correção 2026-11-16). -->
        <local:AlcaDeLargura Borda="Right"/>
        <SelectorBar x:Name="AbasPainel" x:FieldModifier="internal" Grid.Row="0" Margin="12,0,12,2">
          <SelectorBarItem x:Name="AbaSecoes" x:FieldModifier="internal" Text="Seções" IsSelected="True"/>
          <SelectorBarItem x:Name="AbaExcluidos" x:FieldModifier="internal" Text="Excluídos (0)"/>
          <SelectorBarItem x:Name="AbaHistorico" x:FieldModifier="internal" Text="Histórico"/>
        </SelectorBar>
        <!-- Painel de navegação (correções 2026-11-15): pesquisa por texto ou situação e filtro rápido dos apontamentos. Os botões do
             filtro são montados pela janela (FiltroNavegacao.Ordem), com a contagem de cada situação. -->
        <StackPanel x:Name="PainelFiltros" x:FieldModifier="internal" Grid.Row="1" Spacing="8" Margin="12,4,12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}"/>
            <TextBlock Text="Seções do relatório" Style="{StaticResource PmvniTituloSecao}" AutomationProperties.HeadingLevel="Level2"/>
          </StackPanel>
          <TextBlock Text="Navegue pelas folhas e exigências da análise" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
          <Grid><TextBox Style="{StaticResource PmvniCampoPesquisa}" x:Name="CaixaFiltroSecoes" x:FieldModifier="internal" PlaceholderText="Pesquisar seção ou item"
                   AutomationProperties.Name="Pesquisar nas seções e itens"/><FontIcon Glyph="{x:Bind local:Glifos.Pesquisar}" Style="{StaticResource PmvniIconeSecundarioStyle}" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" FontSize="16"/></Grid>
          <Expander Header="Filtrar por situação" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="4" x:Name="BotoesFiltro" x:FieldModifier="internal" AutomationProperties.Name="Filtro rápido de apontamentos"/>
          </Expander>
        </StackPanel>
        <ListView x:Name="ListaNavegacao" x:FieldModifier="internal" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  Padding="6,0,6,8" AutomationProperties.Name="Seções e itens do relatório">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="MinHeight" Value="30"/>
              <Setter Property="Padding" Value="2,0,2,0"/>
              <Setter Property="Margin" Value="0,1,0,1"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ItemNavegacao">
              <!-- Nome acessível e dica com o texto inteiro (A3, A4, M10): o Narrador lê "Item 07, Recuos, Não atende, alterado, folha 4".
                   Correções 2026-11-15 (painel de navegação): número numa coluna própria, título em até duas linhas e a etiqueta de
                   situação embaixo dele; a folha numa coluna fixa à direita; o item selecionado com fundo mais claro e barra fina; as
                   seções com seta para recolher e o contador de itens. Clicar na etiqueta abre o menu das situações. -->
              <Grid MinHeight="40" ColumnSpacing="5" Padding="0,6,8,6" CornerRadius="9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{x:Bind FundoLinha, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Rotulo}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PmvniRailIndicatorStyle}" Visibility="{x:Bind IndicadorVisivel, Mode=OneWay}"/>
                <Border Grid.Column="0" VerticalAlignment="Stretch" Margin="0,4" CornerRadius="2" Background="{x:Bind CorSituacao}" Visibility="{x:Bind SituacaoVisivel}"/>
                <FontIcon Grid.Column="1" Glyph="{x:Bind IconeSecao}" Visibility="{x:Bind IconeSecaoVisivel, Mode=OneWay}" FontSize="16"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Numero}" Visibility="{x:Bind NumeroVisivel}" Style="{StaticResource PmvniSecondaryTextStyle}" Margin="0,1,0,0" VerticalAlignment="Top"/>
                <Button Grid.Column="1" Visibility="{x:Bind ChevronVisivel, Mode=OneWay}" Tag="{x:Bind}" Click="AoClicarChevron"
                        Width="24" Height="32" Padding="0" VerticalAlignment="Top" Style="{StaticResource PmvniBarraButtonStyle}"
                        AutomationProperties.Name="{x:Bind NomeChevron, Mode=OneWay}" local:Dicas.Descricao="Mostra ou esconde os itens desta seção.">
                  <FontIcon Glyph="{x:Bind GlifoChevron, Mode=OneWay}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}"/>
                </Button>
                <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextAlignment="Left" Text="{x:Bind Titulo}" Style="{x:Bind local:PaginaRelatorios.EstiloDoTitulo(Secao)}" MaxLines="{x:Bind LinhasTitulo}"
                               TextWrapping="{x:Bind QuebraTitulo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Visibility="{x:Bind ContagemVisivel, Mode=OneWay}" CornerRadius="9" Padding="7,0,7,1" VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                      <TextBlock Text="{x:Bind ContagemTexto, Mode=OneWay}" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                    </Border>
                  </Grid>
                  <!-- 2026-11-17 (pedido do usuário): embaixo do título, a etiqueta da situação no visual do relatório e, se o item mudou,
                       "RESULTADO ORIGINAL ALTERADO" (cor de destaque do app, não vermelho: vermelho é só da situação). -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:EtiquetaSituacao Situacao="{x:Bind Situacao}" Tag="{x:Bind}" Click="AoClicarEtiqueta" HorizontalAlignment="Left"/>
                    <TextBlock Text="Resultado original alterado" Visibility="{x:Bind AlteradoVisivel}" Style="{StaticResource PmvniTextoDestaqueStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="O resultado original deste item foi alterado na revisão."/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{x:Bind FolhaTexto}" Style="{StaticResource PmvniSecondaryTextStyle}"
                           VerticalAlignment="Top" Margin="0,2,0,0" TextAlignment="Right" HorizontalAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="12,8" ColumnSpacing="6" Visibility="{Binding Visibility, ElementName=ListaNavegacao}">
          <TextBlock x:Name="ContagemNavegacao" TextAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
          <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.MaisOpcoes}" x:Name="MaisItens" Grid.Column="1" Content="Ver mais itens" Click="AvancarNavegacao"
                  AutomationProperties.Name="Ver mais itens"/>
        </Grid>
        <!-- Excluídos: cada linha com o número original, o título e Restaurar (as linhas são montadas pela janela). -->
        <ListView x:Name="ListaExcluidos" x:FieldModifier="internal" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  Padding="6,0,6,8" Visibility="Collapsed" AutomationProperties.Name="Itens excluídos"/>
        <TextBlock x:Name="TextoSemExcluidos" x:FieldModifier="internal" Grid.Row="2" Visibility="Collapsed" Margin="16,12"
                   Text="Nenhum item excluído." Style="{StaticResource PmvniSecondaryTextStyle}"/>
        <!-- Histórico do pacote (historico.jsonl), mais recente primeiro. -->
        <ListView x:Name="ListaHistorico" x:FieldModifier="internal" Grid.Row="2" SelectionMode="None" Visibility="Collapsed"
                  Padding="6,0,6,8" AutomationProperties.Name="Histórico de alterações">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,4"/>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <!-- Centro: o relatório inteiro, em folhas A4 empilhadas (a página web desenha as folhas sobre o fundo cinza). -->
      <Grid Grid.Column="1" x:Name="AreaCentral" x:FieldModifier="internal">
        <controls:WebView2 x:Name="Navegador" x:FieldModifier="internal"/>
        <Grid x:Name="Espera" x:FieldModifier="internal" Canvas.ZIndex="10" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,10"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="22">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <ProgressRing x:Name="Anel" x:FieldModifier="internal" IsActive="False" Width="24" Height="24"/>
              <TextBlock x:Name="TextoEspera" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
        </Grid>
        <!-- Nada aberto (M5): ícone do módulo, Novo relatório, Abrir e os recentes. -->
        <local:EstadoVazio x:Name="TextoVazio" x:FieldModifier="internal"/>
      </Grid>

      <!-- Propriedades do item selecionado (recolhível por Exibir › Propriedades). O original aparece aqui, lado a lado com o
           revisado (Original ⇄), nunca nas folhas. As partes que dependem do item (campos, histórico) são montadas pela janela. -->
      <Grid x:Name="PainelPropriedades" x:FieldModifier="internal" Grid.Column="2" Width="{StaticResource PmvniLarguraPropriedades}"
            Style="{StaticResource PmvniPainelLateral}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Arrastar a borda muda a largura do painel (correção 2026-11-16). -->
        <local:AlcaDeLargura Borda="Left"/>
        <Grid Grid.Row="0" Padding="12" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock TextAlignment="Left" x:Name="PropTitulo" x:FieldModifier="internal" Text="Propriedades" Style="{StaticResource PmvniAjusteTitulo}" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Name="PropId" x:FieldModifier="internal" Text="" Style="{StaticResource PmvniSecondaryTextStyle}" IsTextSelectionEnabled="True"/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.MaisOpcoes}" x:Name="PropTextosOcultos" x:FieldModifier="internal" Content="Conteúdo oculto" Margin="0,6,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <Button x:Name="BotaoFecharPropriedades" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniBarraButtonStyle}"
                  AutomationProperties.Name="Fechar as propriedades" VerticalAlignment="Top" Width="32" Height="32" Padding="0"
                  local:Dicas.Descricao="Esconde este painel; ele volta em Exibir › Propriedades.">
            <FontIcon Glyph="{x:Bind local:Glifos.Fechar}" FontSize="16"/>
          </Button>
        </Grid>
        <TextBlock x:Name="PropVazio" x:FieldModifier="internal" Grid.Row="1" Margin="16,8" TextWrapping="Wrap"
                   Text="Selecione um item nas folhas ou na lista de seções." Style="{StaticResource PmvniSecondaryTextStyle}"/>
        <ScrollViewer x:Name="PropRolagem" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed">
          <!-- Correções 2026-11-16: seções em cartões com cabeçalho (Estado, Esquadrias, Conteúdo, Histórico), rótulos pequenos
               acima de cada valor e separadores; os estilos (PmvniPainel…, Estilos.xaml) servem também ao painel do Novo despacho. -->
          <StackPanel x:Name="PropConteudo" x:FieldModifier="internal" Padding="12,4,12,16" Spacing="12">

            <!-- ESTADO: no PDF, situação, justificativa e IA. -->
            <Border Style="{StaticResource PmvniPainelCartao}">
              <StackPanel>
                <Border Style="{StaticResource PmvniPainelCartaoCabecalho}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Estado" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level3"/>
                  </StackPanel>
                </Border>
                <StackPanel Style="{StaticResource PmvniPainelCartaoCorpo}">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="No PDF" Style="{StaticResource PmvniPainelRotulo}"/>
                    <CheckBox x:Name="PropNoPdf" x:FieldModifier="internal" Grid.Column="1" Content="Sai no relatório" MinWidth="0" MinHeight="28" Padding="6,0,0,0"
                              AutomationProperties.Name="No PDF"
                              local:Dicas.Descricao="Desmarcado, o item sai do relatório (continua em Excluídos e pode voltar)."/>
                  </Grid>
                  <Border Style="{StaticResource PmvniPainelSeparador}"/>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Situação" Style="{StaticResource PmvniPainelRotulo}"/>
                    <ComboBox x:Name="PropSituacao" x:FieldModifier="internal" HorizontalAlignment="Stretch" AutomationProperties.Name="Situação revisada"/>
                    <TextBlock x:Name="PropSituacaoOriginal" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border Style="{StaticResource PmvniPainelSeparador}"/>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Justificativa" Style="{StaticResource PmvniPainelRotulo}"/>
                    <TextBox x:Name="PropJustificativa" x:FieldModifier="internal" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56"
                             PlaceholderText="Por que a situação mudou, ou o que rever no item (Enter aplica)" AutomationProperties.Name="Justificativa"/>
                    <TextBlock x:Name="PropJustificativaAviso" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed"
                               Text="A situação mudou: a justificativa é exigida para exportar."/>
                  </StackPanel>
                  <Border Style="{StaticResource PmvniPainelSeparador}"/>
                  <!-- A IA reajusta o item inteiro a partir da justificativa (com ou sem mudança de situação), pelo Codex com o modelo de
                       Ajustes › Inteligência artificial. Enquanto espera: anel, tempo e Cancelar. -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Inteligência artificial" Style="{StaticResource PmvniPainelRotulo}"/>
                    <TextBlock x:Name="PropAjustarAviso" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed"/>
                    <StackPanel Spacing="8">
                      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" x:Name="PropAjustarTexto" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource PmvniBotaoPrimarioStyle}"
                              AutomationProperties.Name="{x:Bind PropAjustarRotulo.Text, Mode=OneWay}"
                              local:Dicas.Descricao="A IA reajusta o item inteiro (verificação, providência, base legal, referência e, se a justificativa pedir, a situação), com o texto curto como o original. Um Desfazer volta tudo.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon x:Name="PropAjustarIcone" x:FieldModifier="internal" FontSize="16"/>
                          <TextBlock x:Name="PropAjustarRotulo" x:FieldModifier="internal" Text="Ajustar o item com a IA"/>
                        </StackPanel>
                      </Button>
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.NaoConfigurado}" x:Name="PropAjustarCancelar" x:FieldModifier="internal" Content="Cancelar" Visibility="Collapsed"
                              AutomationProperties.Name="Cancelar a consulta à IA"
                              local:Dicas.Descricao="Interrompe a consulta à IA; nada muda no relatório."/>
                    </StackPanel>
                    <StackPanel x:Name="PropAjustarProgresso" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                      <ProgressRing x:Name="PropAjustarAnel" x:FieldModifier="internal" IsActive="False" Width="16" Height="16"/>
                      <TextBlock x:Name="PropAjustarEstado" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ESQUADRIAS (só numa linha de AMBIENTE): janelas e portas com largura × altura editáveis e a conta em tempo real. Montado pela janela. -->
            <Border x:Name="PropEsquadrias" x:FieldModifier="internal" Style="{StaticResource PmvniPainelCartao}" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource PmvniPainelCartaoCabecalho}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Esquadrias" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level3"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="PropEsquadriasCorpo" x:FieldModifier="internal" Style="{StaticResource PmvniPainelCartaoCorpo}"/>
              </StackPanel>
            </Border>

            <!-- CONTEÚDO: os campos de texto, editáveis aqui mesmo. Montado pela janela. -->
            <Border Style="{StaticResource PmvniPainelCartao}">
              <StackPanel>
                <Border Style="{StaticResource PmvniPainelCartaoCabecalho}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Conteúdo" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level3"/>
                  </StackPanel>
                </Border>
                <StackPanel Style="{StaticResource PmvniPainelCartaoCorpo}">
                  <StackPanel x:Name="PropCampos" x:FieldModifier="internal" Spacing="12"/>
                  <Border Style="{StaticResource PmvniPainelSeparador}"/>
                  <Button x:Name="PropRestaurarOriginal" x:FieldModifier="internal" HorizontalAlignment="Left"
                          AutomationProperties.Name="Restaurar original"
                          local:Dicas.Descricao="Desfaz as edições deste item e volta ao texto original recebido da IA.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="{x:Bind local:Glifos.Desfazer}" FontSize="16"/>
                      <TextBlock Text="Restaurar original"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- HISTÓRICO do item. -->
            <Border Style="{StaticResource PmvniPainelCartao}">
              <StackPanel>
                <Border Style="{StaticResource PmvniPainelCartaoCabecalho}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Histórico" Style="{StaticResource PmvniPainelCartaoTitulo}" AutomationProperties.HeadingLevel="Level3"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="PropHistorico" x:FieldModifier="internal" Padding="12,10,12,12" Spacing="6"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Rodapé (o mesmo padrão da Legislação, M4): zoom com ícones e atalhos na dica, o indicador de layout (A2), a situação da composição e
         "Folha n de M" com caixa para ir direto à folha. -->
    <Grid x:Name="BarraRodape" Grid.Row="2" RowDefinitions="Auto,Auto" MinHeight="40" Padding="12,4,12,0" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="GrupoZoom" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="BotaoMenos" x:FieldModifier="internal" Width="32" Height="32" Padding="0" Style="{StaticResource PmvniBarraButtonStyle}" AutomationProperties.Name="Diminuir o zoom"
                ToolTipService.ToolTip="Abra um relatório para mudar o zoom." IsEnabled="False">
          <FontIcon Glyph="{x:Bind local:Glifos.Diminuir}" FontSize="16"/>
        </Button>
        <Slider x:Name="ControleZoom" x:FieldModifier="internal" Width="104" Minimum="50" Maximum="300" Value="100"
                StepFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" IsEnabled="False"
                AutomationProperties.Name="Zoom do relatório em porcentagem" ToolTipService.ToolTip="Arraste para ajustar o zoom do relatório"/>
        <TextBlock x:Name="TextoZoom" x:FieldModifier="internal" Text="100 %" Style="{StaticResource PmvniSecondaryTextStyle}" Width="52" TextAlignment="Center" VerticalAlignment="Center"/>
        <Button x:Name="BotaoMais" x:FieldModifier="internal" Width="32" Height="32" Padding="0" Style="{StaticResource PmvniBarraButtonStyle}" AutomationProperties.Name="Aumentar o zoom"
                ToolTipService.ToolTip="Abra um relatório para mudar o zoom." IsEnabled="False">
          <FontIcon Glyph="{x:Bind local:Glifos.Aumentar}" FontSize="16"/>
        </Button>
        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Ajustar}" x:Name="BotaoLargura" x:FieldModifier="internal" Style="{StaticResource PmvniBarraButtonStyle}" Content="Ajustar largura" Margin="10,0,0,0"
                ToolTipService.ToolTip="Abra um relatório para ajustar a largura." IsEnabled="False"/>
        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.PaginaInteira}" x:Name="BotaoPagina" x:FieldModifier="internal" Style="{StaticResource PmvniBarraButtonStyle}" Content="Página inteira"
                ToolTipService.ToolTip="Abra um relatório para ver a página inteira." IsEnabled="False"/>
      </StackPanel>
      <local:IndicadorAvisos x:Name="IndicadorLayout" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center"/>
      <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="TextoComposicao" x:FieldModifier="internal" Grid.Column="2" Text="" Style="{StaticResource PmvniSecondaryTextStyle}"
                 VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
      <StackPanel x:Name="PainelFolha" x:FieldModifier="internal" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="Folha" Style="{StaticResource PmvniPainelRotulo}" VerticalAlignment="Center"/>
        <NumberBox x:Name="CaixaFolha" x:FieldModifier="internal" MinWidth="72" Minimum="1" Maximum="1" Value="1" SpinButtonPlacementMode="Hidden"
                   AutomationProperties.Name="Ir à folha" ToolTipService.ToolTip="Digite o número da folha e tecle Enter"/>
        <TextBlock x:Name="TextoFolha" x:FieldModifier="internal" Text="" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
