<UserControl x:Class="Pmvni.App.SeletoresPerfilPlugin"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="LinhaSeletor" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
  </UserControl.Resources>
  <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="2">
    <StackPanel>
      <Button x:Name="EscolherModelo" Style="{StaticResource LinhaSeletor}">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Modelo"/>
          <TextBlock Grid.Column="1" x:Name="ModeloAtual" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
          <Path Grid.Column="2" Width="10" Height="14" VerticalAlignment="Center" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" Data="M1,5 L5,1 L9,5 M1,9 L5,13 L9,9" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
      </Button>
      <Border Height="1" Margin="10,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
      <Button x:Name="EscolherNivel" Style="{StaticResource LinhaSeletor}">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Inteligência"/>
          <TextBlock Grid.Column="1" x:Name="NivelAtual" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
          <Path Grid.Column="2" Width="10" Height="14" VerticalAlignment="Center" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" Data="M1,5 L5,1 L9,5 M1,9 L5,13 L9,9" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</UserControl>

