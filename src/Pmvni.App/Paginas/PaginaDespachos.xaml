<UserControl x:Class="Pmvni.App.PaginaDespachos"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Módulo Despachos (desenho §9): os despachos que já existem nas pastas dos processos (de todos ou só do processo escolhido em
       Processos), com tipo, data e número. O Novo despacho abre a sua página no lugar desta (PaginaNovoDespacho). As linhas e os botões são
       ligados pela janela (MainWindow.Pastas.cs e MainWindow.NovoDespacho.cs). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoPasta" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="False" Title="">
        <InfoBar.ActionButton>
          <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Engrenagem}" x:Name="BotaoAbrirAjustes" x:FieldModifier="internal" Content="Abrir Ajustes"
                  local:Dicas.Descricao="Abre os Ajustes para escolher a pasta onde ficam os processos."/>
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
      <!-- Depois de gravar um despacho (Novo despacho ou Gerar PDF): o que foi gravado e onde, com os botões para abrir. -->
      <InfoBar x:Name="AvisoGravado" x:FieldModifier="internal" Severity="Success" IsOpen="False" IsClosable="True" Title="Despacho gravado" Tag="fixo">
        <InfoBar.Content>
          <StackPanel local:AcoesDeAviso.AutoOcultar="True" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoAbrirDocxGravado" x:FieldModifier="internal" Content="Abrir no Word"
                    local:Dicas.Descricao="Abre no Word o despacho que acabou de ser gravado."/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoAbrirPdfGravado" x:FieldModifier="internal" Content="Abrir PDF"
                    local:Dicas.Descricao="Abre o PDF do despacho que acabou de ser gravado."/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.AbrirPasta}" x:Name="BotaoMostrarGravado" x:FieldModifier="internal" Content="Mostrar no Explorador"
                    local:Dicas.Descricao="Abre a pasta do despacho gravado no Explorador de Arquivos."/>
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
    </local:AreaDeAvisos>

    <Grid Grid.Row="1" Visibility="Collapsed" Padding="20,10,16,6" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="TextoContagem" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" AutomationProperties.Name="Quantidade de despachos"/>
      <ProgressRing x:Name="Anel" x:FieldModifier="internal" Grid.Column="1" IsActive="False" Width="18" Height="18"/>
    </Grid>

    <ListView x:Name="ListaDespachos" x:FieldModifier="internal" Grid.Row="2" Visibility="Collapsed" SelectionMode="Single" Padding="12,0,12,8"
              AutomationProperties.Name="Despachos">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ItemDespacho">
          <StackPanel Padding="0,5" Spacing="1" AutomationProperties.Name="{x:Bind NomeAcessivel}">
            <TextBlock TextAlignment="Center" Text="{x:Bind Titulo}" Style="{StaticResource PmvniAjusteTitulo}" Visibility="{x:Bind EhGrupo}" Margin="0,8,0,0"/>
            <TextBlock Text="{x:Bind Titulo}" Visibility="{x:Bind EhDespacho}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Titulo}"/>
            <TextBlock Text="{x:Bind Detalhe}" Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="{x:Bind EhDespacho}" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind Detalhe}"/>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!-- Lista vazia (M5): a tela vazia do módulo (ícone, título, frase e botões). A janela escreve o texto e a visibilidade em
         TextoListaVazia (guardado fora da tela); a frase e a visibilidade da tela vazia seguem esse texto. -->
    <local:EstadoVazio x:Name="Vazio" x:FieldModifier="internal" Grid.Row="2"/>
    <Border Grid.Row="2" Visibility="Collapsed">
      <TextBlock x:Name="TextoListaVazia" x:FieldModifier="internal" Visibility="Collapsed"/>
    </Border>
  </Grid>
</UserControl>
