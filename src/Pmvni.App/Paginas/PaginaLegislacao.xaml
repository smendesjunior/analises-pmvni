<UserControl x:Class="Pmvni.App.PaginaLegislacao"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Microsoft.UI.Xaml.Controls"
  xmlns:local="using:Pmvni.App">
  <!-- Módulo Legislação (desenho §11.4): painel com Leis · Marcadores · Resultados, o PDF num WebView2 (criado uma vez, com a sandbox do
       host leg.pmvni.invalid) e o rodapé "Página N de M", ◂ ▸ e a escala. Quem preenche e reage é a janela (MainWindow.Legislacao.cs). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoSemTexto" x:FieldModifier="internal" Severity="Informational" IsClosable="True" Tag="fixo"
               Message="Este PDF não tem texto pesquisável: a pesquisa e a cópia de texto não funcionam nele."/>
      <InfoBar x:Name="AvisoErro" x:FieldModifier="internal" Severity="Error" IsClosable="True"/>
      <InfoBar x:Name="AvisoSemCopia" x:FieldModifier="internal" Severity="Warning" IsClosable="True"
               Message="A cópia deste PDF não foi encontrada na pasta do editor. Use Substituir arquivo… em Ajustes › Legislação."/>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsClosable="True"/>
      <!-- A anexação começada aqui (ou em Ajustes) mostra o andamento e o Cancelar também neste módulo (desenho §11.1/§11.4). -->
      <Grid x:Name="ProgressoAnexo" x:FieldModifier="internal" ColumnSpacing="12" Padding="12,6" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="TextoProgressoAnexo" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
          <ProgressBar x:Name="BarraProgressoAnexo" x:FieldModifier="internal" IsIndeterminate="True" local:Trabalhando.Automatico="False"/>
        </StackPanel>
        <Button x:Name="BotaoCancelarAnexo" x:FieldModifier="internal" Grid.Column="1" Content="Cancelar"
                AutomationProperties.Name="Cancelar a anexação" local:Dicas.Titulo="Cancelar"
                local:Dicas.Descricao="Para de anexar os PDFs; os que já entraram continuam na biblioteca."/>
      </Grid>
    </local:AreaDeAvisos>

    <Grid Grid.Row="1" Margin="8" ColumnSpacing="10" RowDefinitions="Auto,*" RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Padding="12,6"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Livro}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Acervo de legislação" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1"/></StackPanel><TextBlock Grid.Column="1" x:Name="TotalAcervo" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Row="1" x:Name="Painel" x:FieldModifier="internal" Width="320" Padding="4" Style="{StaticResource PmvniPainelLateral}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <SelectorBar x:Name="AbasPainel" x:FieldModifier="internal" Margin="8,0,8,2">
          <SelectorBarItem x:Name="AbaLeis" x:FieldModifier="internal" Text="Leis" IsSelected="True"/>
          <SelectorBarItem x:Name="AbaMarcadores" x:FieldModifier="internal" Text="Marcadores" IsEnabled="False" AutomationProperties.Name="Marcadores" local:Dicas.Descricao="Abra um PDF que tenha marcadores para habilitar esta aba."/>
          <SelectorBarItem x:Name="AbaResultados" x:FieldModifier="internal" Text="Resultados" IsEnabled="False" AutomationProperties.Name="Resultados" local:Dicas.Descricao="Pesquise em todas as leis para mostrar os resultados."/>
        </SelectorBar>

        <Grid x:Name="VistaLeis" x:FieldModifier="internal" Grid.Row="1">
          <!-- Lista nova (2026-11-16): filtro, cartões das esferas (Federal, Estadual, Municipal), botões de tipo e um cartão por lei; a lei
               aberta mostra, no próprio cartão, os tópicos com os artigos resumidos. Quem monta é a janela (MainWindow.ListaLeis.cs). -->
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="10,6,10,8">
            <TextBox Style="{StaticResource PmvniCampoPesquisa}" x:Name="FiltroLeis" x:FieldModifier="internal" PlaceholderText="Filtrar por título, arquivo ou conteúdo"
                   AutomationProperties.Name="Filtrar as leis"/>
            <FontIcon Glyph="{x:Bind local:Glifos.Pesquisar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
          </Grid>
          <Grid x:Name="CartoesEsferas" x:FieldModifier="internal" Grid.Row="1" Margin="10,0,10,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          </Grid>
          <Grid x:Name="BotoesTipos" x:FieldModifier="internal" Grid.Row="2" Margin="10,0,10,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*"/><ColumnDefinition/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
          </Grid>
          <ListView x:Name="ListaLeis" x:FieldModifier="internal" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True"
                    Padding="4,2,4,8" AutomationProperties.Name="Leis anexadas" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"/>
          <TextBlock x:Name="NenhumaLeiFiltro" x:FieldModifier="internal" Grid.Row="3" Margin="14,12" TextWrapping="Wrap" Visibility="Collapsed"
                     Style="{StaticResource PmvniSecondaryTextStyle}" Text="Nenhuma lei com este filtro."/>
          <StackPanel x:Name="VazioLeis" x:FieldModifier="internal" Grid.Row="3" Visibility="Collapsed" Padding="14,8" Spacing="10">
            <FontIcon Glyph="{x:Bind local:Glifos.Livro}" FontSize="48" Style="{StaticResource PmvniIconeSecundarioStyle}" HorizontalAlignment="Left" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock TextWrapping="Wrap" Text="Nenhuma lei anexada ainda." Style="{StaticResource PmvniSecondaryTextStyle}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button MinHeight="36" HorizontalAlignment="Stretch" Padding="5,3" x:Name="BotaoAnexar" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False" AutomationProperties.Name="Anexar PDFs…">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Anexar}" FontSize="16"/><TextBlock Text="Anexar PDFs…"/></StackPanel>
              </Button>
              <Button Grid.Column="1" MinHeight="36" HorizontalAlignment="Stretch" Padding="5,3" x:Name="BotaoAbrirAjustes" x:FieldModifier="internal" Content="Gerenciar anexos"
                      AutomationProperties.Name="Gerenciar anexos" local:Dicas.Descricao="Abre os ajustes da Legislação para renomear, reler ou remover leis anexadas."/>
            </Grid>
          </StackPanel>
        </Grid>

        <TreeView x:Name="ArvoreMarcadores" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed" SelectionMode="None"
                  Padding="4,0,4,8" AutomationProperties.Name="Marcadores do PDF"/>

        <Grid x:Name="VistaResultados" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock TextAlignment="Center" x:Name="TextoResultados" x:FieldModifier="internal" Margin="12,6,12,4" TextWrapping="Wrap"
                     Style="{StaticResource PmvniAjusteTitulo}" AutomationProperties.HeadingLevel="Level2"/>
          <TextBlock x:Name="AvisoResultados" x:FieldModifier="internal" Grid.Row="1" Margin="12,0,12,6" TextWrapping="Wrap" Visibility="Collapsed"
                     Style="{StaticResource PmvniSecondaryTextStyle}"/>
          <ListView x:Name="ListaResultados" x:FieldModifier="internal" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                    Padding="4,0,4,8" AutomationProperties.Name="Resultados da pesquisa em todas as leis"/>
        </Grid>
      </Grid>

      <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- Correções 2026-11-15: leitura padronizada (processador interno do texto da lei) ou o PDF original. -->
        <SelectorBar x:Name="ModoLeitura" x:FieldModifier="internal" Margin="12,6,12,0" Visibility="Collapsed">
          <SelectorBarItem x:Name="ModoPadronizado" x:FieldModifier="internal" Text="Leitura padronizada" IsSelected="True">
            <SelectorBarItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Livro}" FontSize="16"/></SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem x:Name="ModoPdf" x:FieldModifier="internal" Text="PDF original">
            <SelectorBarItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Original}" FontSize="16"/></SelectorBarItem.Icon>
          </SelectorBarItem>
        </SelectorBar>
        <controls:WebView2 x:Name="Leitor" x:FieldModifier="internal" Grid.Row="1" Opacity="0" AutomationProperties.Name="PDF da lei"/>
        <!-- 2026-11-16: os tópicos e artigos resumidos saíram da coluna "Neste documento" e ficam no cartão da lei, na lista. -->
        <Grid x:Name="VistaPadronizada" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed">
          <ScrollViewer x:Name="RolagemPadronizada" x:FieldModifier="internal" VerticalScrollBarVisibility="Auto" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" RequestedTheme="Light">
            <StackPanel x:Name="TextoPadronizado" x:FieldModifier="internal" MaxWidth="900" Padding="48,32" Spacing="10"/>
          </ScrollViewer>
        </Grid>
        <TextBlock x:Name="TextoNadaAberto" x:FieldModifier="internal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="24" Style="{StaticResource PmvniSecondaryTextStyle}"
                   Text="Escolha uma lei na lista para ler."/>
      </Grid>
    </Grid>

    <!-- Rodapé (o mesmo padrão de Relatórios, M4): zoom com ícones e atalhos na dica, "Página n de M" com caixa e a escala. -->
    <Grid Grid.Row="2" MinHeight="44" Padding="12,4" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Página" Style="{StaticResource PmvniPainelRotulo}"/>
      <NumberBox x:Name="CaixaPagina" x:FieldModifier="internal" Grid.Column="1" MinWidth="72" Minimum="1" Maximum="1" Value="1"
                 SpinButtonPlacementMode="Hidden" IsEnabled="False" AutomationProperties.Name="Página"/>
      <TextBlock x:Name="TextoTotalPaginas" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource PmvniSecondaryTextStyle}" Text="de 0"/>
      <Button x:Name="BotaoPaginaAnterior" x:FieldModifier="internal" Grid.Column="3" Style="{StaticResource PmvniBarraButtonStyle}" Width="32" Height="32" Padding="0" IsEnabled="False"
              AutomationProperties.Name="Página anterior">
        <FontIcon Glyph="{x:Bind local:Glifos.Anterior}" FontSize="16"/>
      </Button>
      <Button x:Name="BotaoPaginaProxima" x:FieldModifier="internal" Grid.Column="4" Style="{StaticResource PmvniBarraButtonStyle}" Width="32" Height="32" Padding="0" IsEnabled="False"
              AutomationProperties.Name="Próxima página">
        <FontIcon Glyph="{x:Bind local:Glifos.Proximo}" FontSize="16"/>
      </Button>
      <Button x:Name="BotaoZoomMenos" x:FieldModifier="internal" Grid.Column="6" Style="{StaticResource PmvniBarraButtonStyle}" Width="32" Height="32" Padding="0" IsEnabled="False"
              AutomationProperties.Name="Diminuir o zoom">
        <FontIcon Glyph="{x:Bind local:Glifos.Diminuir}" FontSize="16"/>
      </Button>
      <Button x:Name="BotaoZoomMais" x:FieldModifier="internal" Grid.Column="8" Style="{StaticResource PmvniBarraButtonStyle}" Width="32" Height="32" Padding="0" IsEnabled="False"
              AutomationProperties.Name="Aumentar o zoom">
        <FontIcon Glyph="{x:Bind local:Glifos.Aumentar}" FontSize="16"/>
      </Button>
      <TextBlock x:Name="TextoEscala" x:FieldModifier="internal" Grid.Column="7" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
    </Grid>
    <Grid x:Name="Consulta" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,Auto,*">
      <Border Margin="8,2,8,6" Padding="6" CornerRadius="8" BorderThickness="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">
        <AppBarButton x:Name="VoltarPortal" Label="Voltar" IsEnabled="False" AutomationProperties.Name="Voltar" Click="VoltarNaConsulta">
          <AppBarButton.Icon><FontIcon Glyph="{x:Bind local:Glifos.Voltar}" FontSize="16"/></AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="AvancarPortal" Label="Avançar" IsEnabled="False" AutomationProperties.Name="Avançar" Click="AvancarNaConsulta">
          <AppBarButton.Icon><FontIcon Glyph="{x:Bind local:Glifos.Avancar}" FontSize="16"/></AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="PararPortal" Label="Parar" Icon="Stop" IsEnabled="False" AutomationProperties.Name="Parar carregamento" Click="PararConsulta"/>
        <AppBarButton Label="Atualizar" AutomationProperties.Name="Atualizar" local:Dicas.Descricao="Recarrega a página do Leis.org." Click="AtualizarConsulta">
          <AppBarButton.Icon><FontIcon Glyph="{x:Bind local:Glifos.Atualizar}" FontSize="16"/></AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="InicioPortal" Label="Página inicial" IsEnabled="False" AutomationProperties.Name="Página inicial" Click="InicioConsulta">
          <AppBarButton.Icon><FontIcon Glyph="{x:Bind local:Glifos.Inicio}" FontSize="16"/></AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton x:Name="SalvarPortal" Label="Salvar PDF…" IsEnabled="False" AutomationProperties.Name="Salvar PDF" Click="SalvarConsulta">
          <AppBarButton.Icon><FontIcon Glyph="{x:Bind local:Glifos.Exportar}" FontSize="16"/></AppBarButton.Icon>
        </AppBarButton>
        <AppBarButton Label="Voltar ao acervo" AutomationProperties.Name="Voltar ao acervo de legislação" local:Dicas.Descricao="Fecha a consulta ao Leis.org e mostra as leis anexadas." Click="FecharConsulta">
          <AppBarButton.Icon><FontIcon Glyph="{x:Bind local:Glifos.Livro}" FontSize="16"/></AppBarButton.Icon>
        </AppBarButton>
        </CommandBar>
      </Border>
      <TextBlock Grid.Row="1" x:Name="EstadoPortal" Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed"/>
      <WebView2 Grid.Row="2" x:Name="Portal" AutomationProperties.Name="Leis.org"/>
    </Grid>
  </Grid>
</UserControl>
