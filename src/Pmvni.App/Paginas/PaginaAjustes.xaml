<UserControl x:Class="Pmvni.App.PaginaAjustes"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Módulo Ajustes (desenho §9, §10.10, §12.8; auditoria da interface §3): no padrão do WinStatusBar, um menu de 8 categorias
       (CategoriasAjustes.Menu; "Sobre e suporte" no rodapé) e, em cada página, título, frase de ajuda e grupos de cartões. Cada linha tem o
       título e a ajuda à esquerda e o controle numa coluna de 240 à direita (empilha abaixo de 540 px: LinhaAjuste). Tudo grava na hora
       (barra "Alterações salvas automaticamente"). Quem preenche e reage é a janela (MainWindow.Ajustes.cs e as outras partes). -->
  <UserControl.Resources>
    <!-- Uma linha por anexo (LinhaAnexo): o título vale ao sair da caixa ou com Enter; a esfera, ao escolher. -->
    <DataTemplate x:Key="ModeloLinhaAnexo" x:DataType="local:LinhaAnexo">
      <Grid Padding="12,10" RowSpacing="6" ColumnSpacing="8" CornerRadius="6" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox Text="{x:Bind Titulo}" IsEnabled="{x:Bind Editavel}" LostFocus="AoSairDoTitulo" KeyDown="AoTeclarNoTitulo"
                 AutomationProperties.Name="Título da lei" ToolTipService.ToolTip="Título usado na lista e nas citações (até 200 caracteres)"/>
        <ComboBox Grid.Column="1" MinWidth="140" IsEnabled="{x:Bind Editavel}" SelectedIndex="{x:Bind local:PaginaAjustes.IndiceDaEsfera(Esfera)}"
                  SelectionChanged="AoMudarEsfera" AutomationProperties.Name="Esfera da lei">
          <x:String>Federal</x:String>
          <x:String>Estadual</x:String>
          <x:String>Municipal</x:String>
          <x:String>Outras</x:String>
        </ComboBox>
        <TextBlock TextAlignment="Left" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniSecondaryTextStyle}"
                   Text="{x:Bind Detalhe}"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,2" CornerRadius="4"
                  Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind local:PaginaAjustes.VisivelSe(Selo)}">
            <TextBlock TextAlignment="Left" Text="{x:Bind Selo}" Style="{StaticResource CaptionTextBlockStyle}"/>
          </Border>
          <Button Grid.Column="1" Content="Substituir arquivo…" Click="AoSubstituir" AutomationProperties.Name="Substituir o arquivo desta lei"
                  local:Dicas.Titulo="Substituir arquivo…" local:Dicas.Descricao="Troca o PDF desta lei por outro arquivo escolhido no computador."/>
          <Button Grid.Column="2" Content="Excluir" Click="AoExcluir" AutomationProperties.Name="Excluir esta lei"
                  local:Dicas.Titulo="Excluir" local:Dicas.Descricao="Tira esta lei da biblioteca do app; o PDF original não é apagado."/>
        </Grid>
      </Grid>
    </DataTemplate>

    <!-- Linha de um cartão: título + ajuda | controle (240). -->
    <Style x:Key="Linha" TargetType="Grid">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="ColumnSpacing" Value="20"/>
      <Setter Property="RowSpacing" Value="8"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <NavigationView x:Name="Menu" x:FieldModifier="internal" PaneDisplayMode="Left" OpenPaneLength="228" CompactPaneLength="48"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    SelectionChanged="AoEscolherCategoria" AutomationProperties.Name="Categorias dos ajustes">
      <NavigationView.PaneHeader><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,8"><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="23" Height="21.36"><Path Canvas.Left="-10" Canvas.Top="-10.82" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M16.57,21.5 C16.57,18.78 18.78,16.57 21.5,16.57 C24.22,16.57 26.43,18.78 26.43,21.5 C26.43,24.22 24.22,26.43 21.5,26.43 C18.78,26.43 16.57,24.22 16.57,21.5 Z M21.5,24.79 C19.69,24.79 18.22,23.31 18.22,21.5 C18.22,19.69 19.69,18.21 21.5,18.21 C23.31,18.21 24.79,19.69 24.79,21.5 C24.79,23.31 23.31,24.79 21.5,24.79 Z"/><Path Canvas.Left="-10" Canvas.Top="-10.82" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M32.39,18.81 C32.6,18.93 32.74,19.14 32.79,19.37 C33.07,20.78 33.07,22.22 32.79,23.63 C32.74,23.86 32.6,24.06 32.39,24.18 L29.33,25.93 L29.31,29.38 C29.31,29.62 29.2,29.85 29.02,30.01 C27.91,30.95 26.64,31.66 25.26,32.13 C25.17,32.16 25.08,32.18 24.99,32.18 C24.85,32.18 24.71,32.14 24.59,32.07 L21.5,30.34 L18.41,32.08 C18.21,32.19 17.97,32.21 17.75,32.14 C16.37,31.68 15.09,30.95 13.98,30.01 C13.8,29.85 13.68,29.63 13.68,29.39 L13.67,25.94 L10.61,24.19 C10.4,24.07 10.26,23.87 10.21,23.64 C9.93,22.23 9.93,20.78 10.21,19.37 C10.26,19.14 10.4,18.94 10.61,18.82 L13.67,17.07 L13.69,13.62 C13.69,13.38 13.8,13.15 13.98,12.99 C15.09,12.05 16.36,11.33 17.74,10.86 C17.96,10.79 18.21,10.82 18.41,10.93 L21.5,12.66 L24.59,10.93 C24.79,10.82 25.03,10.8 25.25,10.87 C26.63,11.33 27.91,12.05 29.02,12.99 C29.2,13.15 29.31,13.37 29.31,13.61 L29.33,17.07 L32.39,18.81 Z M31.25,22.95 L28.32,24.62 C28.19,24.69 28.08,24.8 28.01,24.93 C27.95,25.03 27.88,25.14 27.82,25.24 C27.74,25.37 27.7,25.52 27.7,25.67 L27.68,28.98 C26.89,29.6 26.02,30.1 25.08,30.45 L22.12,28.8 C22,28.73 21.86,28.7 21.72,28.7 L21.7,28.7 C21.58,28.7 21.44,28.7 21.32,28.7 C21.17,28.7 21.03,28.73 20.9,28.8 L17.94,30.46 C17,30.11 16.12,29.61 15.33,28.99 L15.32,25.69 C15.32,25.54 15.27,25.39 15.19,25.26 C15.13,25.16 15.07,25.05 15.01,24.94 C14.94,24.81 14.83,24.7 14.7,24.63 L11.76,22.95 C11.61,21.99 11.61,21.01 11.76,20.05 L14.69,18.38 C14.82,18.31 14.93,18.2 15,18.07 C15.06,17.97 15.12,17.86 15.18,17.76 C15.26,17.63 15.31,17.48 15.31,17.33 L15.33,14.02 C16.12,13.4 16.99,12.9 17.93,12.55 L20.89,14.2 C21.02,14.27 21.16,14.3 21.31,14.3 C21.43,14.3 21.56,14.3 21.68,14.3 C21.83,14.3 21.97,14.27 22.1,14.2 L25.06,12.54 C26,12.89 26.88,13.39 27.67,14.01 L27.68,17.31 C27.68,17.46 27.73,17.61 27.81,17.74 C27.87,17.84 27.93,17.95 27.99,18.06 C28.06,18.19 28.17,18.3 28.3,18.37 L31.24,20.05 C31.39,21.01 31.39,21.99 31.24,22.95 L31.25,22.95 Z"/></Canvas></Viewbox><StackPanel Grid.Column="1"><TextBlock TextAlignment="Left" Text="Configurações" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock TextAlignment="Left" Text="Preferências do editor" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></Grid></NavigationView.PaneHeader>
      <ScrollViewer x:Name="Rolagem" x:FieldModifier="internal" Padding="24,12,24,24" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <!-- Conteúdo alinhado à esquerda, logo depois do menu, até 1000 px (como as Configurações do Windows e o WinStatusBar). -->
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1280"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock TextAlignment="Left" x:Name="TituloCategoria" Style="{StaticResource PmvniAjusteTituloPagina}"/>
              <TextBlock TextAlignment="Left" x:Name="DescricaoCategoria" Style="{StaticResource PmvniAjusteAjuda}"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="10,4" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
              <TextBlock TextAlignment="Left" Text="{Binding Text, ElementName=TextoSalvo}" Style="{StaticResource CaptionTextBlockStyle}"/>
            </Border>
          </Grid>
          <Grid x:Name="Paginas">

          <!-- ===== 1. Geral ===== -->
          <StackPanel x:Name="CategoriaGeral" Tag="geral" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Ao abrir" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Ao abrir o editor" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Módulo mostrado ao abrir." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaAbrirEm" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Ao abrir o editor"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Lembrar tamanho e posição da janela" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Reabre do jeito que estava; desligado, abre com 1600 x 1000." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarJanela" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Lembrar tamanho e posição da janela"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Arquivos" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Arquivos recentes" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Quantos aparecem em Arquivo › Recentes." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <ComboBox x:Name="CaixaRecentes" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteEscolha}" AutomationProperties.Name="Quantidade de arquivos recentes"/>
                  <Button x:Name="BotaoLimparRecentes" x:FieldModifier="internal" Content="Limpar lista" HorizontalAlignment="Right" AutomationProperties.Name="Limpar a lista de recentes"
                          local:Dicas.Titulo="Limpar lista" local:Dicas.Descricao="Esvazia a lista de relatórios recentes; os arquivos não são apagados."/>
                </StackPanel>
              </Grid>
            </StackPanel></Border>
          </StackPanel>

          <!-- ===== 2. Aparência ===== -->
          <StackPanel x:Name="CategoriaAparencia" Tag="aparencia" Spacing="12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE737;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Janela" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Tema" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Muda só a janela do editor. As folhas do relatório continuam brancas, como saem no PDF." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaTema" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Tema"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Rótulos da faixa" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Automático esconde os rótulos em janelas estreitas (menos de 1000 px)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaRotulosFaixa" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Rótulos da faixa"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Avisos de layout" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Onde aparecem &quot;reduzido N %&quot;, &quot;além da borda&quot; e blocos maiores que a página." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaAvisosLayout" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Avisos de layout"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== 3. Relatórios e revisão ===== -->
          <StackPanel x:Name="CategoriaRelatorios" Tag="relatorios" Spacing="12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="20" Height="18.46"><Path Canvas.Left="-0" Canvas.Top="-9.27" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M2.31,9.27 L17.69,9.27 C18.96,9.27 20,10.31 20,11.58 L20,22.35 C20,23.62 18.96,24.65 17.69,24.65 L2.31,24.65 C1.04,24.65 0,23.62 0,22.35 L0,11.58 C0,10.31 1.04,9.27 2.31,9.27 Z M18.46,22.35 C18.46,22.78 18.12,23.12 17.69,23.12 L2.31,23.12 C1.88,23.12 1.54,22.78 1.54,22.35 L1.54,11.58 C1.54,11.15 1.88,10.81 2.31,10.81 L17.69,10.81 C18.12,10.81 18.46,11.15 18.46,11.58 L18.46,22.35 Z"/><Path Canvas.Left="-0" Canvas.Top="-9.27" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M13.85,26.96 C13.85,27.39 13.51,27.73 13.08,27.73 L6.92,27.73 C6.49,27.73 6.15,27.39 6.15,26.96 C6.15,26.53 6.49,26.19 6.92,26.19 L13.08,26.19 C13.51,26.19 13.85,26.53 13.85,26.96 Z"/></Canvas></Viewbox><TextBlock TextAlignment="Left" Text="Tela" Style="{StaticResource PmvniTituloSecao}"/></StackPanel>
            <local:PainelCartoesAjustes>
<Border Style="{StaticResource PmvniAjusteGrupo}">
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="17" Height="17"><Path Canvas.Left="-8.5" Canvas.Top="-8.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M25.5,9.27 L25.5,13.91 C25.5,14.34 25.16,14.68 24.73,14.68 C24.3,14.68 23.95,14.34 23.95,13.91 L23.95,11.14 L19.86,15.23 C19.56,15.53 19.07,15.53 18.77,15.23 C18.47,14.93 18.47,14.44 18.77,14.14 L22.86,10.05 L20.09,10.05 C19.66,10.05 19.32,9.7 19.32,9.27 C19.32,8.84 19.66,8.5 20.09,8.5 L24.73,8.5 C25.16,8.5 25.5,8.84 25.5,9.27 Z"/><Path Canvas.Left="-8.5" Canvas.Top="-8.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M10.05,22.86 L14.14,18.77 C14.44,18.47 14.93,18.47 15.23,18.77 C15.53,19.07 15.53,19.56 15.23,19.86 L11.14,23.95 L13.91,23.95 C14.34,23.95 14.68,24.3 14.68,24.73 C14.68,25.16 14.34,25.5 13.91,25.5 L9.27,25.5 C8.84,25.5 8.5,25.16 8.5,24.73 L8.5,20.09 C8.5,19.66 8.84,19.32 9.27,19.32 C9.7,19.32 10.05,19.66 10.05,20.09 L10.05,22.86 Z"/><Path Canvas.Left="-8.5" Canvas.Top="-8.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M23.95,20.09 C23.95,19.66 24.3,19.32 24.73,19.32 C25.16,19.32 25.5,19.66 25.5,20.09 L25.5,24.73 C25.5,25.16 25.16,25.5 24.73,25.5 L20.09,25.5 C19.66,25.5 19.32,25.16 19.32,24.73 C19.32,24.3 19.66,23.95 20.09,23.95 L22.86,23.95 L18.77,19.86 C18.47,19.56 18.47,19.07 18.77,18.77 C19.07,18.47 19.56,18.47 19.86,18.77 L23.95,22.86 L23.95,20.09 Z"/><Path Canvas.Left="-8.5" Canvas.Top="-8.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M13.91,10.05 L11.14,10.05 L15.23,14.14 C15.53,14.44 15.53,14.93 15.23,15.23 C14.93,15.53 14.44,15.53 14.14,15.23 L10.05,11.14 L10.05,13.91 C10.05,14.34 9.7,14.68 9.27,14.68 C8.84,14.68 8.5,14.34 8.5,13.91 L8.5,9.27 C8.5,8.84 8.84,8.5 9.27,8.5 L13.91,8.5 C14.34,8.5 14.68,8.84 14.68,9.27 C14.68,9.7 14.34,10.05 13.91,10.05 Z"/></Canvas></Viewbox><TextBlock TextAlignment="Left" Text="Zoom ao abrir" Style="{StaticResource PmvniAjusteTitulo}"/></StackPanel><TextBlock TextAlignment="Left" Text="Como as folhas aparecem ao abrir um relatório." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ComboBox x:Name="CaixaZoomInicial" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Zoom ao abrir"/>
              </Grid></Border>
<Border Style="{StaticResource PmvniAjusteGrupo}"><Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
