<UserControl x:Class="Pmvni.App.PaginaAjustes"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Módulo Ajustes (desenho §9, §10.10): tema, intervalo do salvamento automático, pasta de processos, pasta do kit PMVNI (com a situação dos
       modelos de despacho), pasta de recuperação (só o caminho) e versões. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="32,20,32,32" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Ajustes" Style="{StaticResource TitleTextBlockStyle}"/>

      <StackPanel Spacing="6">
        <TextBlock Text="Tema" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                   Text="Muda só a janela do editor. As folhas do relatório continuam brancas, como saem no PDF."/>
        <!-- RadioButton soltos no mesmo grupo (e não o RadioButtons): o Click só vem do usuário, nunca da marcação feita pelo código. -->
        <StackPanel x:Name="OpcoesTema" x:FieldModifier="internal" AutomationProperties.Name="Tema">
          <RadioButton GroupName="tema" Content="Seguir o sistema" Tag="sistema"/>
          <RadioButton GroupName="tema" Content="Claro" Tag="claro"/>
          <RadioButton GroupName="tema" Content="Escuro" Tag="escuro"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Salvamento automático" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                   Text="O relatório é gravado sozinho depois deste tempo sem alterações (e também ao trocar de arquivo e ao fechar)."/>
        <ComboBox x:Name="CaixaIntervalo" x:FieldModifier="internal" MinWidth="180" AutomationProperties.Name="Intervalo do salvamento automático"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Pasta de processos" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                   Text="É a pasta que os módulos Processos e Despachos leem (uma subpasta por ano, e dentro dela uma pasta por processo). O editor só lê essa pasta: nunca move, renomeia nem apaga nada nela."/>
        <TextBlock x:Name="TextoPastaProcessos" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="BotaoEscolherPasta" x:FieldModifier="internal" Content="Escolher pasta…" AutomationProperties.Name="Escolher a pasta de processos"/>
          <Button x:Name="BotaoPastaPadrao" x:FieldModifier="internal" Content="Usar a pasta padrão" AutomationProperties.Name="Usar a pasta de processos padrão"/>
        </StackPanel>
        <TextBlock x:Name="TextoAvisoPasta" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Pasta do kit PMVNI" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                   Text="De onde o Novo despacho lê os modelos oficiais (pelo registro TEMPLATES_OFICIAIS.json) e os textos fixos. O editor só lê o kit: nada é copiado nem gravado nele."/>
        <TextBlock x:Name="TextoPastaKit" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="BotaoEscolherKit" x:FieldModifier="internal" Content="Escolher pasta…" AutomationProperties.Name="Escolher a pasta do kit PMVNI"/>
          <Button x:Name="BotaoKitPadrao" x:FieldModifier="internal" Content="Usar a pasta padrão" AutomationProperties.Name="Usar a pasta do kit padrão"/>
        </StackPanel>
        <TextBlock x:Name="TextoModelos" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Pasta de recuperação" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"
                   Text="Aqui ficam as alterações ainda não gravadas, para o caso de uma queda. O app apaga sozinho o que ficou guardado há mais de 30 dias."/>
        <TextBlock x:Name="TextoPastaRecuperacao" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Versões" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock x:Name="TextoVersoes" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
