              <Grid Padding="16" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="ImagemApp" x:FieldModifier="internal" Width="56" Height="56" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock TextAlignment="Left" Text="Análise de Projetos – PMVNI" Style="{StaticResource PmvniTituloSecao}" IsTextSelectionEnabled="True"/>
                  <TextBlock TextAlignment="Left" x:Name="TextoSobreVersao" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="0,6,0,0" IsTextSelectionEnabled="True"
                             Text="Editor dos relatórios de análise de projetos da Secretaria Municipal de Obras de Venda Nova do Imigrante: revisão dos relatórios, despachos, processos, acompanhamento da tramitação, legislação, consulta de imóveis na base QGIS e os sistemas da Prefeitura, com análise por Claude e Codex."/>
                </StackPanel>
              </Grid>
            </Border>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock TextAlignment="Left" Text="Desenvolvedor" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoDesenvolvedor" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock TextAlignment="Left" Text="Direitos autorais" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoDireitos" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock TextAlignment="Left" Text="Sistema" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoSistema" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock TextAlignment="Left" Text="Runtime" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoRuntime" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Pasta de dados" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Ajustes, legislação anexada, recuperação, cópias da planilha e registro de erros." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <TextBlock TextAlignment="Left" x:Name="TextoPastaDados" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock TextAlignment="Left" Text="Tecnologias" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Windows App SDK (WinUI 3), .NET e WebView2"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Ícones" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Segoe Fluent Icons e Fluent UI System Icons (licença MIT)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <TextBlock TextAlignment="Left" Grid.Column="1" VerticalAlignment="Center" Text="Microsoft"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Componentes" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="PDF.js (Apache-2.0), PdfPig (Apache-2.0), PDFsharp (MIT), NetTopologySuite (BSD) e LibreOffice para o PDF dos despachos." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Sobre}" x:Name="BotaoLicencaPdfJs" x:FieldModifier="internal" Grid.Column="1" Content="Licença do PDF.js" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            local:Dicas.Descricao="Mostra a licença do PDF.js, usado no leitor da legislação."/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Marcas" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Claude e Anthropic, ChatGPT, Codex e OpenAI, Excel, Windows e demais nomes e logotipos pertencem aos respectivos proprietários. O editor não é afiliado a essas empresas." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <TextBlock TextAlignment="Left" Grid.Column="1" VerticalAlignment="Center" Text="Avisos legais"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>
          </Grid>
        </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>

    <!-- Barra inferior (como o WinStatusBar): tudo grava na hora. -->
    <Border Grid.Row="1" Padding="24,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="{x:Bind local:Glifos.Marca}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
        <TextBlock TextAlignment="Left" x:Name="TextoSalvo" x:FieldModifier="internal" Text="Alterações salvas automaticamente" Style="{StaticResource PmvniAjusteAjuda}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
