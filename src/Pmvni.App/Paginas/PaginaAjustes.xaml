                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== Fontes de dados (2026-11-16): a pasta QGIS do módulo Imóveis ===== -->
          <StackPanel x:Name="CategoriaFontesDados" Tag="fontes_dados" Spacing="12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE707;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Base QGIS" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <StackPanel Padding="16,12" Spacing="6">
                <TextBlock TextAlignment="Left" Text="Pasta dos arquivos QGIS" Style="{StaticResource PmvniAjusteTitulo}"/>
                <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="A pasta da base municipal (a que tem o Mapa PDM.qgz, as pastas shapes, 2025_10, SHAPE_LOTEAMENTOS e BASE_CADASTRAL_AUXILIAR). O editor só lê esses arquivos: nunca grava, move nem apaga nada nela."/>
                <TextBox x:Name="CaixaPastaQgis" x:FieldModifier="internal" IsReadOnly="True" PlaceholderText="Nenhuma pasta escolhida" AutomationProperties.Name="Pasta dos arquivos QGIS"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button x:Name="BotaoEscolherQgis" x:FieldModifier="internal" Content="Selecionar pasta…" Style="{StaticResource PmvniBotaoPrimarioStyle}" AutomationProperties.Name="Selecionar a pasta dos arquivos QGIS"
                          local:Dicas.Titulo="Selecionar pasta…" local:Dicas.Descricao="Escolhe a pasta da base QGIS municipal que o módulo Imóveis consulta."/>
                  <Button x:Name="BotaoVerificarQgis" x:FieldModifier="internal" Content="Verificar acesso e arquivos" AutomationProperties.Name="Verificar acesso e arquivos da pasta QGIS"
                          local:Dicas.Titulo="Verificar acesso e arquivos" local:Dicas.Descricao="Confere se a pasta abre e quais camadas e bases foram encontradas."/>
                  <Button x:Name="BotaoAbrirQgis" x:FieldModifier="internal" Content="Abrir" AutomationProperties.Name="Abrir a pasta QGIS no Explorador"
                          local:Dicas.Titulo="Abrir" local:Dicas.Descricao="Abre a pasta QGIS no Explorador de Arquivos."/>
                </StackPanel>
                <Border x:Name="ProgressoQgis" x:FieldModifier="internal" Visibility="Collapsed" CornerRadius="24" Padding="24,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <ProgressRing IsActive="True" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" Text="Verificando a pasta QGIS…" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                  </StackPanel>
                </Border>
                <InfoBar x:Name="ResultadoQgis" x:FieldModifier="internal" IsClosable="True" IsOpen="False"/>
              </StackPanel>
            </StackPanel></Border>
            <!-- Sites da Prefeitura (2026-11-17): login persistente até "Sair"; linhas montadas em MainWindow.Sites.cs. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Sites da Prefeitura" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" TextWrapping="Wrap" Text="Entre uma vez pelo próprio site (Essencial, GPI, Alfresco): o app guarda o acesso, protegido pelo Windows só para este usuário, e o mantém ativo até você clicar em Sair. Para o caso de o servidor encerrar a sessão por conta própria, guarde também o usuário e a senha: o app entra sozinho quando o site pedir."/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel x:Name="PainelSites" x:FieldModifier="internal"/></Border>
            <!-- Acompanhamento de processos (2026-11-17): a planilha padrão que o módulo mostra e atualiza. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEB05;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Acompanhamento de processos" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <StackPanel Padding="16,12" Spacing="6">
                    <TextBlock TextAlignment="Left" Text="Planilha de acompanhamento" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="A planilha do Excel no modelo padrão (ACOMPANHAMENTO DE PROCESSOS). O módulo Acompanhamento mostra todas as colunas dela, com as listas e as cores configuradas, e grava nela tudo o que você muda no app. Antes de cada gravação, uma cópia de segurança vai para a pasta de dados do editor."/>
                    <TextBox x:Name="CaixaPlanilhaAcompanhamento" x:FieldModifier="internal" IsReadOnly="True" PlaceholderText="Nenhuma planilha escolhida" AutomationProperties.Name="Planilha de acompanhamento de processos"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button x:Name="BotaoEscolherPlanilha" x:FieldModifier="internal" Content="Selecionar planilha…" Style="{StaticResource PmvniBotaoPrimarioStyle}" AutomationProperties.Name="Selecionar a planilha de acompanhamento"
                              local:Dicas.Titulo="Selecionar planilha…" local:Dicas.Descricao="Escolhe a planilha .xlsx do acompanhamento de processos."/>
                      <Button x:Name="BotaoVerificarPlanilha" x:FieldModifier="internal" Content="Verificar" AutomationProperties.Name="Verificar a planilha de acompanhamento"
                              local:Dicas.Titulo="Verificar" local:Dicas.Descricao="Lê a planilha e mostra as colunas, listas e processos encontrados."/>
                      <Button x:Name="BotaoAbrirPlanilha" x:FieldModifier="internal" Content="Abrir no Excel" AutomationProperties.Name="Abrir a planilha no Excel"
                              local:Dicas.Titulo="Abrir no Excel" local:Dicas.Descricao="Abre a planilha de acompanhamento no Excel."/>
                    </StackPanel>
                    <InfoBar x:Name="ResultadoPlanilha" x:FieldModifier="internal" IsClosable="True" IsOpen="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Preencher local e autor sozinho" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Quando a coluna Local ou Profissional está vazia, o editor procura no relatório analisado, na consulta QGIS e nas pranchas do processo e grava o que achar. Nunca troca o que já foi digitado." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarDetectarAcompanhamento" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Preencher local e autor sozinho"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== 5. Despachos e PDF ===== -->
          <StackPanel x:Name="CategoriaDespachos" Tag="despachos" Spacing="12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE7C3;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="LibreOffice" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <StackPanel Padding="16,12" Spacing="6">
                <TextBlock TextAlignment="Left" Text="LibreOffice" Style="{StaticResource PmvniAjusteTitulo}"/>
                <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="Gera o PDF dos despachos (sobre uma cópia do DOCX; o Word nunca é usado). Sem ele, sai só o DOCX."/>
                <TextBlock TextAlignment="Left" x:Name="TextoSoffice" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button x:Name="BotaoTestarSoffice" x:FieldModifier="internal" Content="Testar" AutomationProperties.Name="Testar o LibreOffice"
                          local:Dicas.Titulo="Testar" local:Dicas.Descricao="Confere se o LibreOffice abre e converte para PDF neste computador."/>
                  <Button x:Name="BotaoEscolherSoffice" x:FieldModifier="internal" Content="Escolher…" AutomationProperties.Name="Escolher o programa do LibreOffice"
                          local:Dicas.Titulo="Escolher…" local:Dicas.Descricao="Escolhe no computador o programa do LibreOffice (soffice.exe)."/>
                  <Button x:Name="BotaoSofficeAutomatico" x:FieldModifier="internal" Content="Procurar automaticamente" AutomationProperties.Name="Achar o LibreOffice sozinho"
                          local:Dicas.Titulo="Procurar automaticamente" local:Dicas.Descricao="Volta a procurar o LibreOffice instalado (desfaz uma escolha manual)."/>
                </StackPanel>
                <TextBlock TextAlignment="Left" x:Name="TextoTesteSoffice" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
              </StackPanel>
            </StackPanel></Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE74E;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Depois de gravar" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Abrir o PDF depois de gravar" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Abre o PDF do despacho no programa padrão assim que ele é gravado na pasta do processo." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ToggleSwitch x:Name="AlternarAbrirPdf" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Abrir o PDF depois de gravar"/>
              </Grid>
            </StackPanel></Border>
            <!-- Profissional responsável (2026-11-17): o bloco de assinatura dos despachos e dos relatórios gerados, individual de cada profissional. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Profissional responsável" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel Padding="16,12" Spacing="8">
              <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" TextWrapping="Wrap" Text="O nome e os dados que aparecem abaixo da linha de assinatura dos despachos e no fim dos relatórios gerados. Campo vazio mantém o texto do modelo."/>
              <local:PainelCartoesAjustes>
                <TextBox x:Name="CaixaProfissionalNome" x:FieldModifier="internal" Header="Nome" PlaceholderText="ex.: FULANO DE TAL" AutomationProperties.Name="Nome do profissional"/>
                <TextBox x:Name="CaixaProfissionalProfissao" x:FieldModifier="internal" Header="Profissão" PlaceholderText="ex.: ARQUITETO E URBANISTA" AutomationProperties.Name="Profissão"/>
                <TextBox x:Name="CaixaProfissionalRegistro" x:FieldModifier="internal" Header="Registro profissional" PlaceholderText="ex.: CAU/ES A000000-0" AutomationProperties.Name="Registro profissional (CAU ou CREA)"/>
                <TextBox x:Name="CaixaProfissionalMatricula" x:FieldModifier="internal" Header="Matrícula" PlaceholderText="ex.: 123456" AutomationProperties.Name="Matrícula"/>
              </local:PainelCartoesAjustes>
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="BotaoSalvarProfissional" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" Content="Salvar dados" AutomationProperties.Name="Salvar os dados do profissional"
                        local:Dicas.Titulo="Salvar dados" local:Dicas.Descricao="Grava nome, profissão, registro e matrícula; valem a partir do próximo despacho e relatório."/>
                <TextBlock TextAlignment="Left" x:Name="TextoProfissionalSalvo" x:FieldModifier="internal" VerticalAlignment="Center" Style="{StaticResource PmvniAjusteAjuda}"/>
              </StackPanel>
            </StackPanel></Border>
            <!-- Assinatura digital (2026-11-16): o certificado que assina o PDF dos despachos. A senha nunca aparece aqui nem vai para o ajustes.json. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE9D5;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Assinatura digital" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <StackPanel Padding="16,12" Spacing="6">
                <TextBlock TextAlignment="Left" Text="Certificado digital" Style="{StaticResource PmvniAjusteTitulo}"/>
                <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="Com um certificado escolhido, o PDF de cada despacho sai assinado digitalmente, com a assinatura visível logo acima da linha de assinatura. Sem certificado, o PDF sai como sempre."/>
                <TextBlock TextAlignment="Left" x:Name="TextoAssinatura" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button x:Name="BotaoEscolherCertificado" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" Content="Escolher arquivo…" AutomationProperties.Name="Escolher o arquivo do certificado digital"
                          local:Dicas.Titulo="Escolher arquivo…" local:Dicas.Descricao="Escolhe o arquivo do certificado digital (.pfx ou .p12)."/>
                  <Button x:Name="BotaoCertificadoWindows" x:FieldModifier="internal" Content="Certificado do Windows…" AutomationProperties.Name="Usar um certificado do repositório do Windows"
                          local:Dicas.Titulo="Certificado do Windows…" local:Dicas.Descricao="Usa um certificado instalado no Windows, em token ou em cartão; a senha é pedida pelo próprio dispositivo."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button x:Name="BotaoConferirCertificado" x:FieldModifier="internal" Content="Conferir" AutomationProperties.Name="Conferir o certificado digital"
                          local:Dicas.Titulo="Conferir" local:Dicas.Descricao="Pede a senha e mostra o titular e a validade do certificado; nada é assinado."/>
                  <Button x:Name="BotaoRemoverCertificado" x:FieldModifier="internal" Content="Remover" AutomationProperties.Name="Deixar de assinar os despachos"
                          local:Dicas.Titulo="Remover" local:Dicas.Descricao="Deixa de assinar os despachos e apaga a senha lembrada; o arquivo do certificado não é apagado."/>
                </StackPanel>
                <TextBlock TextAlignment="Left" x:Name="TextoConferenciaCertificado" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
              </StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Lembrar a senha neste computador" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Desligado, a senha do arquivo é pedida a cada assinatura. Ligado, ela fica guardada cifrada, só para este usuário do Windows." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ToggleSwitch x:Name="AlternarLembrarSenha" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Lembrar a senha do certificado neste computador"/>
              </Grid>
            </StackPanel></Border>
            <Expander Header="Avançado" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="6">
                <TextBlock TextAlignment="Left" Text="Perfil do LibreOffice" Style="{StaticResource PmvniAjusteTitulo}"/>
                <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="O editor usa um perfil próprio do LibreOffice. Se a conversão para PDF travar sempre, apague o perfil: o próximo PDF demora perto de um minuto, enquanto ele é criado de novo."/>
                <TextBlock TextAlignment="Left" x:Name="TextoPerfilSoffice" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                <Button x:Name="BotaoRedefinirPerfil" x:FieldModifier="internal" Content="Redefinir perfil" AutomationProperties.Name="Redefinir o perfil do LibreOffice"
                        local:Dicas.Titulo="Redefinir perfil" local:Dicas.Descricao="Apaga o perfil do LibreOffice usado pelo editor; use se a conversão para PDF travar."/>
              </StackPanel>
            </Expander>
          </StackPanel>

          <!-- ===== 6. Legislação ===== -->
          <StackPanel x:Name="CategoriaLegislacao" Tag="legislacao" Spacing="12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Pesquisa" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Pesquisar em" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="O alvo da pesquisa ao abrir uma lei no leitor." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ComboBox x:Name="CaixaEscopo" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Pesquisar em"/>
              </Grid>
            </StackPanel></Border>
            <!-- Leis anexadas (desenho §11.1): uma linha por anexo (título e esfera editáveis, arquivo, tamanho, páginas, data, selo,
                 Substituir arquivo… e Excluir). "Anexar PDFs…" fica sempre à mão (também com a lista vazia). -->
            <Border Style="{StaticResource PmvniAjusteGrupo}" Padding="16,12"><StackPanel x:Name="SecaoLegislacao" x:FieldModifier="internal" Spacing="8">
              <TextBlock TextAlignment="Left" Text="Leis anexadas" Style="{StaticResource PmvniTituloSecao}"/>
              <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}"
                         Text="Anexe os PDFs das leis que você consulta. O editor guarda uma cópia de cada um na pasta de dados dele e nunca altera o arquivo original. Nada é enviado para fora do computador."/>
              <TextBlock TextAlignment="Left" x:Name="TextoTotalLegislacao" x:FieldModifier="internal" TextWrapping="Wrap"/>
              <TextBlock TextAlignment="Left" x:Name="TextoSomenteLeituraLegislacao" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed"
                         Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <StackPanel.Resources>
                  <ResourceDictionary Source="ms-appx:///Recursos/CoresTonais.xaml"/>
                </StackPanel.Resources>
                <Button x:Name="BotaoAnexarLegislacao" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}"
                        AutomationProperties.Name="Anexar PDFs das leis"
                        local:Dicas.Titulo="Anexar PDFs…" local:Dicas.Descricao="Acrescenta leis em PDF à biblioteca; o editor guarda uma cópia e não muda o original.">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE723;" FontSize="16"/>
                    <TextBlock TextAlignment="Left" Text="Anexar PDFs…"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <Grid x:Name="ProgressoLegislacao" x:FieldModifier="internal" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" x:Name="TextoProgressoLegislacao" x:FieldModifier="internal" TextWrapping="Wrap"/>
                  <ProgressBar x:Name="BarraProgressoLegislacao" x:FieldModifier="internal" IsIndeterminate="True"/>
                </StackPanel>
                <Button x:Name="BotaoCancelarLegislacao" x:FieldModifier="internal" Grid.Column="1" Content="Cancelar"
                        AutomationProperties.Name="Cancelar a anexação"
                        local:Dicas.Titulo="Cancelar" local:Dicas.Descricao="Para de anexar os PDFs; os que já entraram continuam na biblioteca."/>
              </Grid>
              <local:AreaDeAvisos RecuoAberto="0,0,0,12">
                <InfoBar x:Name="AvisoLegislacao" x:FieldModifier="internal" IsClosable="True"/>
                <InfoBar x:Name="AvisosAcervoLegislacao" x:FieldModifier="internal" IsClosable="True" Severity="Warning"/>
              </local:AreaDeAvisos>
              <!-- IsEnabled do ContentControl vale para os controles das linhas: catálogo só leitura ⇒ nada de alterar. -->
              <ContentControl x:Name="ConteudoAnexos" x:FieldModifier="internal" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <ItemsRepeater x:Name="ListaAnexos" x:FieldModifier="internal" ItemTemplate="{StaticResource ModeloLinhaAnexo}">
                  <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </ContentControl>
            </StackPanel></Border>
          </StackPanel>

          <!-- ===== 7. Inteligência artificial ===== -->
          <StackPanel x:Name="CategoriaIa" Tag="ia" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" x:Name="TituloAgentes" x:FieldModifier="internal" Text="Inteligência artificial" Visibility="Collapsed"/>
            <!-- Suas IAs (correções 2026-11-15, no padrão da página "IAs e contas" do WinStatusBar): um cartão por agente, com a conta, a assinatura, o
                 programa, a situação, os plugins do kit, a chave de API e o aviso. Tudo é consultado neste computador ao abrir a página, sem clicar em nada. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE99A;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Suas IAs" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <local:PainelCartoesAjustes>
              <local:CartaoAgente x:Name="CartaoChatGpt" x:FieldModifier="internal"/>
              <local:CartaoAgente x:Name="CartaoClaude" x:FieldModifier="internal"/>
              <local:CartaoAgente x:Name="CartaoGemini" x:FieldModifier="internal"/>
            </local:PainelCartoesAjustes>
            <!-- Modelos de IA (2026-11-17, no padrão do seletor do WinStatusBar): qual IA responde na revisão e nos ajustes, com que modelo e com que
                 nível de raciocínio. Uma linha por fonte disponível neste computador (montada em MainWindow.ModelosIa.cs); as listas vêm dos apps
                 ChatGPT e Claude e, nas APIs, da própria API. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock TextAlignment="Left" Text="Modelos de IA" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}"
