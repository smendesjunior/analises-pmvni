<UserControl x:Class="Pmvni.App.PaginaAjustes"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Módulo Ajustes (desenho §9, §10.10, §12.8; auditoria da interface §3): no padrão do WinStatusBar, um menu de categorias
       (CategoriasAjustes.Menu; "Sobre e suporte" no rodapé) e, em cada página, título, frase de ajuda e grupos de cartões. Cada linha tem o
       título e a ajuda à esquerda e o controle numa coluna de 240 à direita (empilha abaixo de 540 px: LinhaAjuste). Tudo grava na hora
       (barra "Alterações salvas automaticamente"). Quem preenche e reage é a janela (MainWindow.Ajustes.cs e as outras partes). -->
  <UserControl.Resources>
    <!-- Uma linha por anexo (LinhaAnexo): o título vale ao sair da caixa ou com Enter; a esfera, ao escolher. -->
    <DataTemplate x:Key="ModeloLinhaAnexo" x:DataType="local:LinhaAnexo">
      <Grid Padding="12,10" RowSpacing="6" ColumnSpacing="8" CornerRadius="6" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox Text="{x:Bind Titulo}" IsEnabled="{x:Bind Editavel}" LostFocus="AoSairDoTitulo" KeyDown="AoTeclarNoTitulo"
                 AutomationProperties.Name="Título da lei" ToolTipService.ToolTip="Título usado na lista e nas citações (até 200 caracteres)"/>
        <ComboBox Grid.Column="1" MinWidth="140" IsEnabled="{x:Bind Editavel}" SelectedIndex="{x:Bind local:PaginaAjustes.IndiceDaEsfera(Esfera)}"
                  SelectionChanged="AoMudarEsfera" AutomationProperties.Name="Esfera da lei">
          <x:String>Federal</x:String>
          <x:String>Estadual</x:String>
          <x:String>Municipal</x:String>
          <x:String>Outras</x:String>
        </ComboBox>
        <TextBlock TextAlignment="Left" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniSecondaryTextStyle}"
                   Text="{x:Bind Detalhe}"/>
        <local:LinhaComAcoes Grid.Row="2" Grid.ColumnSpan="2">
          <Border VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,2" CornerRadius="4"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind local:PaginaAjustes.VisivelSe(Selo)}">
            <TextBlock TextAlignment="Left" Text="{x:Bind Selo}" Style="{StaticResource CaptionTextBlockStyle}"/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Documento}" Style="{StaticResource PmvniBotaoPrimarioStyle}" Content="Substituir arquivo…" Click="AoSubstituir" AutomationProperties.Name="Substituir o arquivo desta lei"
                      local:Dicas.Titulo="Substituir arquivo…" local:Dicas.Descricao="Troca o PDF desta lei por outro arquivo escolhido no computador."/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Excluir}" Content="Excluir" Click="AoExcluir" AutomationProperties.Name="Excluir esta lei"
                      local:Dicas.Titulo="Excluir" local:Dicas.Descricao="Tira esta lei da biblioteca do app; o PDF original não é apagado."/>
          </StackPanel>
        </local:LinhaComAcoes>
      </Grid>
    </DataTemplate>

    <!-- Linha de um cartão: título + ajuda | controle (240). -->
    <Style x:Key="Linha" TargetType="Grid">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="ColumnSpacing" Value="20"/>
      <Setter Property="RowSpacing" Value="8"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <NavigationView x:Name="Menu" x:FieldModifier="internal" PaneDisplayMode="Left" OpenPaneLength="228" CompactPaneLength="48"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    SelectionChanged="AoEscolherCategoria" AutomationProperties.Name="Categorias dos ajustes">
      <NavigationView.PaneHeader><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,8"><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="23" Height="21.36"><Path Canvas.Left="-10" Canvas.Top="-10.82" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M16.57,21.5 C16.57,18.78 18.78,16.57 21.5,16.57 C24.22,16.57 26.43,18.78 26.43,21.5 C26.43,24.22 24.22,26.43 21.5,26.43 C18.78,26.43 16.57,24.22 16.57,21.5 Z M21.5,24.79 C19.69,24.79 18.22,23.31 18.22,21.5 C18.22,19.69 19.69,18.21 21.5,18.21 C23.31,18.21 24.79,19.69 24.79,21.5 C24.79,23.31 23.31,24.79 21.5,24.79 Z"/><Path Canvas.Left="-10" Canvas.Top="-10.82" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M32.39,18.81 C32.6,18.93 32.74,19.14 32.79,19.37 C33.07,20.78 33.07,22.22 32.79,23.63 C32.74,23.86 32.6,24.06 32.39,24.18 L29.33,25.93 L29.31,29.38 C29.31,29.62 29.2,29.85 29.02,30.01 C27.91,30.95 26.64,31.66 25.26,32.13 C25.17,32.16 25.08,32.18 24.99,32.18 C24.85,32.18 24.71,32.14 24.59,32.07 L21.5,30.34 L18.41,32.08 C18.21,32.19 17.97,32.21 17.75,32.14 C16.37,31.68 15.09,30.95 13.98,30.01 C13.8,29.85 13.68,29.63 13.68,29.39 L13.67,25.94 L10.61,24.19 C10.4,24.07 10.26,23.87 10.21,23.64 C9.93,22.23 9.93,20.78 10.21,19.37 C10.26,19.14 10.4,18.94 10.61,18.82 L13.67,17.07 L13.69,13.62 C13.69,13.38 13.8,13.15 13.98,12.99 C15.09,12.05 16.36,11.33 17.74,10.86 C17.96,10.79 18.21,10.82 18.41,10.93 L21.5,12.66 L24.59,10.93 C24.79,10.82 25.03,10.8 25.25,10.87 C26.63,11.33 27.91,12.05 29.02,12.99 C29.2,13.15 29.31,13.37 29.31,13.61 L29.33,17.07 L32.39,18.81 Z M31.25,22.95 L28.32,24.62 C28.19,24.69 28.08,24.8 28.01,24.93 C27.95,25.03 27.88,25.14 27.82,25.24 C27.74,25.37 27.7,25.52 27.7,25.67 L27.68,28.98 C26.89,29.6 26.02,30.1 25.08,30.45 L22.12,28.8 C22,28.73 21.86,28.7 21.72,28.7 L21.7,28.7 C21.58,28.7 21.44,28.7 21.32,28.7 C21.17,28.7 21.03,28.73 20.9,28.8 L17.94,30.46 C17,30.11 16.12,29.61 15.33,28.99 L15.32,25.69 C15.32,25.54 15.27,25.39 15.19,25.26 C15.13,25.16 15.07,25.05 15.01,24.94 C14.94,24.81 14.83,24.7 14.7,24.63 L11.76,22.95 C11.61,21.99 11.61,21.01 11.76,20.05 L14.69,18.38 C14.82,18.31 14.93,18.2 15,18.07 C15.06,17.97 15.12,17.86 15.18,17.76 C15.26,17.63 15.31,17.48 15.31,17.33 L15.33,14.02 C16.12,13.4 16.99,12.9 17.93,12.55 L20.89,14.2 C21.02,14.27 21.16,14.3 21.31,14.3 C21.43,14.3 21.56,14.3 21.68,14.3 C21.83,14.3 21.97,14.27 22.1,14.2 L25.06,12.54 C26,12.89 26.88,13.39 27.67,14.01 L27.68,17.31 C27.68,17.46 27.73,17.61 27.81,17.74 C27.87,17.84 27.93,17.95 27.99,18.06 C28.06,18.19 28.17,18.3 28.3,18.37 L31.24,20.05 C31.39,21.01 31.39,21.99 31.24,22.95 L31.25,22.95 Z"/></Canvas></Viewbox><StackPanel Grid.Column="1"><TextBlock TextAlignment="Left" Text="Configurações" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock TextAlignment="Left" Text="Preferências do editor" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></Grid></NavigationView.PaneHeader>
      <ScrollViewer x:Name="Rolagem" x:FieldModifier="internal" Padding="24,12,24,24" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <!-- Conteúdo alinhado à esquerda, logo depois do menu, até 1000 px (como as Configurações do Windows e o WinStatusBar). -->
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1280"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="16">
          <local:LinhaComAcoes>
            <StackPanel Spacing="4">
              <TextBlock x:Name="TrilhaModelos" Text="Configurações › Modelos da análise" Style="{StaticResource PmvniAjusteAjuda}" Visibility="Collapsed"/>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                <FontIcon x:Name="IconeCategoria" Style="{StaticResource PmvniIconeTituloPagina}" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" x:Name="TituloCategoria" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Grid.Column="1" Grid.Row="1" x:Name="DescricaoCategoria" Style="{StaticResource PmvniAjusteAjuda}"/>
              </Grid>
            </StackPanel>
            <Grid>
              <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Restaurar}" x:Name="BotaoRestaurarModelos" x:FieldModifier="internal" Visibility="Collapsed" VerticalAlignment="Center" Content="Restaurar padrões" AutomationProperties.Name="Restaurar o padrão do kit nos modelos da análise"
                        local:Dicas.Titulo="Restaurar padrão do kit" local:Dicas.Descricao="Apaga o ajuste deste computador: os modelos, os níveis, as regras e a auditoria cruzada voltam ao padrão do kit."/>
              <Border x:Name="EstadoSalvoCategoria" Padding="10,4" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                <TextBlock TextAlignment="Left" Text="{Binding Text, ElementName=TextoSalvo}" Style="{StaticResource CaptionTextBlockStyle}"/>
              </Border>
            </Grid>
          </local:LinhaComAcoes>
          <Grid x:Name="Paginas">

          <!-- ===== 1. Geral ===== -->
          <StackPanel x:Name="CategoriaGeral" Tag="geral" Spacing="12">
            <TextBlock TextAlignment="Left" Text="Ao abrir" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Ao abrir o editor" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Módulo mostrado ao abrir." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaAbrirEm" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Ao abrir o editor"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Lembrar tamanho e posição da janela" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Reabre do jeito que estava; desligado, abre com 1600 x 1000." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarJanela" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Lembrar tamanho e posição da janela"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <TextBlock TextAlignment="Left" Text="Arquivos" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <local:LinhaComAcoes Margin="16,12">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Arquivos recentes" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Quantos aparecem em Arquivo › Recentes." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox x:Name="CaixaRecentes" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteEscolha}" AutomationProperties.Name="Quantidade de arquivos recentes"/>
                  <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Limpar}" x:Name="BotaoLimparRecentes" x:FieldModifier="internal" Content="Limpar lista" HorizontalAlignment="Right" AutomationProperties.Name="Limpar a lista de recentes"
                            local:Dicas.Titulo="Limpar lista" local:Dicas.Descricao="Esvazia a lista de relatórios recentes; os arquivos não são apagados."/>
                </StackPanel>
              </local:LinhaComAcoes>
            </StackPanel></Border>
          </StackPanel>

          <!-- ===== 2. Aparência ===== -->
          <StackPanel x:Name="CategoriaAparencia" Tag="aparencia" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" Text="Janela" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Tema" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Muda só a janela do editor. As folhas do relatório continuam brancas, como saem no PDF." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaTema" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Tema"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Rótulos da faixa" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Automático esconde os rótulos em janelas estreitas (menos de 1000 px)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaRotulosFaixa" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Rótulos da faixa"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Avisos de layout" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Onde aparecem &quot;reduzido N %&quot;, &quot;além da borda&quot; e blocos maiores que a página." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaAvisosLayout" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Avisos de layout"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== 3. Relatórios e revisão ===== -->
          <StackPanel x:Name="CategoriaRelatorios" Tag="relatorios" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" Text="Tela" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
<Border Style="{StaticResource PmvniAjusteGrupo}">
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Zoom ao abrir" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Como as folhas aparecem ao abrir um relatório." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ComboBox x:Name="CaixaZoomInicial" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Zoom ao abrir"/>
              </Grid></Border>
<Border Style="{StaticResource PmvniAjusteGrupo}"><Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Lista de seções" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Compacta: uma linha por item, com a situação numa bolinha. Confortável: título em até duas linhas e a situação escrita embaixo." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ComboBox x:Name="CaixaListaSecoes" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Lista de seções"/>
              </Grid></Border>
<Border Style="{StaticResource PmvniAjusteGrupo}"><Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Marcas de revisão" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Mostra nas folhas o que foi alterado (o mesmo que Revisão › Marcas de revisão)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ToggleSwitch x:Name="AlternarMarcas" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Marcas de revisão"/>
              </Grid></Border>
<Border Style="{StaticResource PmvniAjusteGrupo}"><Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Painéis ao abrir" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Seções e Propriedades como ficaram da última vez; desligado, os dois abrem à vista." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ToggleSwitch x:Name="AlternarPaineis" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" OnContent="Lembrar" OffContent="Desativado" VerticalAlignment="Center" AutomationProperties.Name="Lembrar os painéis ao abrir"/>
              </Grid>
            </Border>
</local:PainelCartoesAjustes>
            <TextBlock TextAlignment="Left" Text="Gravação" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
<Border Style="{StaticResource PmvniAjusteGrupo}">
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Salvamento automático" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="O relatório é gravado sozinho depois deste tempo sem alterações (e também ao trocar de arquivo e ao fechar)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ComboBox x:Name="CaixaIntervalo" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Intervalo do salvamento automático"/>
              </Grid></Border>
<Border Style="{StaticResource PmvniAjusteGrupo}"><local:LinhaComAcoes Margin="16,12">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" Text="Recuperação" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" Text="As alterações ainda não gravadas ficam aqui, para o caso de uma queda. O que ficou guardado há mais tempo que isto sai sozinho." Style="{StaticResource PmvniAjusteAjuda}"/>
                  <TextBlock TextAlignment="Left" x:Name="TextoPastaRecuperacao" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox x:Name="CaixaRecuperacao" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteEscolha}" Header="Guardar por" AutomationProperties.Name="Guardar a recuperação por"/>
                  <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.AbrirPasta}" x:Name="BotaoAbrirRecuperacao" x:FieldModifier="internal" Content="Abrir pasta" HorizontalAlignment="Right" AutomationProperties.Name="Abrir a pasta de recuperação"
                          local:Dicas.Titulo="Abrir pasta" local:Dicas.Descricao="Abre no Explorador a pasta onde ficam as cópias de recuperação."/>
                </StackPanel>
              </local:LinhaComAcoes>
            </Border>
</local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== 4. Pastas e kit ===== -->
          <StackPanel x:Name="CategoriaPastas" Tag="pastas" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" Text="Pastas" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes x:Name="CartoesDasPastas" x:FieldModifier="internal">
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <StackPanel Padding="16,12" Spacing="6">
                    <local:LinhaComAcoes>
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock TextAlignment="Left" Text="Pasta de processos" Style="{StaticResource PmvniAjusteTitulo}"/>
                        <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="É a pasta que os módulos Processos e Despachos leem (uma subpasta por ano, e dentro dela uma pasta por processo). O editor só lê essa pasta: nunca move, renomeia nem apaga nada nela."/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Editar}" x:Name="BotaoEscolherPasta" Style="{StaticResource PmvniBotaoPrimarioStyle}" x:FieldModifier="internal" Content="Alterar…" AutomationProperties.Name="Escolher a pasta de processos"
                                  local:Dicas.Titulo="Alterar…" local:Dicas.Descricao="Escolhe outra pasta onde ficam os processos da Secretaria."/>
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoAbrirPastaProcessos" x:FieldModifier="internal" Content="Abrir" AutomationProperties.Name="Abrir a pasta de processos no Explorador"
                                  local:Dicas.Titulo="Abrir" local:Dicas.Descricao="Abre a pasta de processos no Explorador de Arquivos."/>
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Restaurar}" x:Name="BotaoPastaPadrao" x:FieldModifier="internal" Content="Padrão" AutomationProperties.Name="Usar a pasta de processos padrão"
                                  local:Dicas.Titulo="Padrão" local:Dicas.Descricao="Volta a usar a pasta de processos padrão."/>
                      </StackPanel>
                    </local:LinhaComAcoes>
                    <TextBlock TextAlignment="Left" x:Name="TextoPastaProcessos" ToolTipService.ToolTip="{Binding Text, ElementName=TextoPastaProcessos}" x:FieldModifier="internal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoAvisoPasta" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <StackPanel Padding="16,12" Spacing="6">
                    <local:LinhaComAcoes>
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock TextAlignment="Left" Text="Pasta do kit PMVNI" Style="{StaticResource PmvniAjusteTitulo}"/>
                        <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="De onde o Novo despacho lê os modelos oficiais (pelo registro TEMPLATES_OFICIAIS.json) e os textos fixos. O editor só lê o kit: nada é copiado nem gravado nele."/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Editar}" x:Name="BotaoEscolherKit" Style="{StaticResource PmvniBotaoPrimarioStyle}" x:FieldModifier="internal" Content="Alterar…" AutomationProperties.Name="Escolher a pasta do kit PMVNI"
                                  local:Dicas.Titulo="Alterar…" local:Dicas.Descricao="Escolhe outra pasta do kit PMVNI (modelos, plugins e regras)."/>
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoAbrirPastaKit" x:FieldModifier="internal" Content="Abrir" AutomationProperties.Name="Abrir a pasta do kit no Explorador"
                                  local:Dicas.Titulo="Abrir" local:Dicas.Descricao="Abre a pasta do kit PMVNI no Explorador de Arquivos."/>
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Restaurar}" x:Name="BotaoKitPadrao" x:FieldModifier="internal" Content="Padrão" AutomationProperties.Name="Usar a pasta do kit padrão"
                                  local:Dicas.Titulo="Padrão" local:Dicas.Descricao="Volta a usar a pasta do kit PMVNI padrão."/>
                      </StackPanel>
                    </local:LinhaComAcoes>
                    <TextBlock TextAlignment="Left" x:Name="TextoPastaKit" ToolTipService.ToolTip="{Binding Text, ElementName=TextoPastaKit}" x:FieldModifier="internal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoAvisoKitAmbiente" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoModelos" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <!-- Plugins e ferramentas (Tarefa 21): cada componente do kit com a versão instalada e a disponível na fonte do kit, a situação e um
                 "Atualizar" por linha (as linhas são montadas por MainWindow.Ajustes.cs a partir de ComponentesDoKit.Lista). Toda atualização roda
                 fora do Editor (.cmd aberto pelo explorer.exe); com análise em andamento, nada é iniciado. -->
            <TextBlock TextAlignment="Left" Text="Plugins e ferramentas" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <local:LinhaComAcoes Margin="16,12">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                      <TextBlock TextAlignment="Left" Text="Componentes do kit PMVNI" Style="{StaticResource PmvniAjusteTitulo}"/>
                      <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="O plugin de análise, o servidor de PDF e os motores de PDF instalados neste computador, com a versão de cada um. As atualizações rodam fora do Editor, pelo Windows, e não começam com uma análise em andamento."/>
                      <TextBlock TextAlignment="Left" x:Name="TextoFonteComponentes" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atualizar}" x:Name="BotaoVerificarComponentes" Style="{StaticResource PmvniBotaoPrimarioStyle}" x:FieldModifier="internal" Content="Verificar atualizações" AutomationProperties.Name="Verificar atualizações dos plugins e ferramentas"
                                local:Dicas.Titulo="Verificar atualizações" local:Dicas.Descricao="Lê de novo as versões instaladas neste computador e as disponíveis na fonte do kit."/>
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Gerenciar}" x:Name="BotaoRepararInstalacao" x:FieldModifier="internal" Content="Reparar instalação" AutomationProperties.Name="Reparar instalação dos plugins e ferramentas" local:Dicas.Titulo="Reparar instalação" local:Dicas.Descricao="Reinstala todos os componentes usando a cópia local do kit PMVNI."/>
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atualizar}" x:Name="BotaoAtualizarTodosComponentes" x:FieldModifier="internal" Content="Atualizar todos" AutomationProperties.Name="Atualizar todos os plugins e ferramentas"
                                local:Dicas.Titulo="Atualizar todos" local:Dicas.Descricao="Roda o instalador do kit (INSTALAR_KIT_PMVNI.cmd atualizar) fora do Editor: copia da fonte o que mudou e reinstala o que for preciso."/>
                    </StackPanel>
                  </local:LinhaComAcoes>
                  <StackPanel x:Name="ListaComponentesKit" x:FieldModifier="internal" AutomationProperties.Name="Componentes do kit PMVNI"/>
                  <StackPanel Padding="16,12" Spacing="8">

                    <TextBlock TextAlignment="Left" x:Name="TextoResultadoComponentes" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock TextAlignment="Left" x:Name="TextoTarefaKit" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <TextBlock TextAlignment="Left" Text="Listas ao abrir" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Processos: ordem" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Ordem da lista ao abrir o editor (Exibir › Ordenar muda só até fechar)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaOrdemProcessos" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Ordem da lista de processos"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <local:LinhaComAcoes Margin="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Despachos: agrupar e ordenar" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Como a lista de despachos abre." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ComboBox x:Name="CaixaAgruparDespachos" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteEscolha}" AutomationProperties.Name="Agrupar os despachos"/>
                      <ComboBox x:Name="CaixaOrdemDespachos" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteEscolha}" AutomationProperties.Name="Ordem dos despachos"/>
                    </StackPanel>
                  </local:LinhaComAcoes>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== Fontes de dados (2026-11-16): a pasta QGIS do módulo Imóveis ===== -->
          <StackPanel x:Name="CategoriaFontesDados" Tag="fontes_dados" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" Text="Base QGIS" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <StackPanel Padding="16,12" Spacing="6">
                <local:LinhaComAcoes>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock TextAlignment="Left" Text="Pasta dos arquivos QGIS" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="A pasta da base municipal (a que tem o Mapa PDM.qgz, as pastas shapes, 2025_10, SHAPE_LOTEAMENTOS e BASE_CADASTRAL_AUXILIAR). O editor só lê esses arquivos: nunca grava, move nem apaga nada nela."/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.AbrirPasta}" x:Name="BotaoEscolherQgis" x:FieldModifier="internal" Content="Selecionar pasta…" Style="{StaticResource PmvniBotaoPrimarioStyle}" AutomationProperties.Name="Selecionar a pasta dos arquivos QGIS"
                              local:Dicas.Titulo="Selecionar pasta…" local:Dicas.Descricao="Escolhe a pasta da base QGIS municipal que o módulo Imóveis consulta."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Conferir}" x:Name="BotaoVerificarQgis" x:FieldModifier="internal" Content="Verificar acesso e arquivos" AutomationProperties.Name="Verificar acesso e arquivos da pasta QGIS"
                              local:Dicas.Titulo="Verificar acesso e arquivos" local:Dicas.Descricao="Confere se a pasta abre e quais camadas e bases foram encontradas."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoAbrirQgis" x:FieldModifier="internal" Content="Abrir" AutomationProperties.Name="Abrir a pasta QGIS no Explorador"
                              local:Dicas.Titulo="Abrir" local:Dicas.Descricao="Abre a pasta QGIS no Explorador de Arquivos."/>
                  </StackPanel>
                </local:LinhaComAcoes>
                <TextBlock x:Name="CaixaPastaQgis" ToolTipService.ToolTip="{Binding Text, ElementName=CaixaPastaQgis}" x:FieldModifier="internal" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}" AutomationProperties.Name="Pasta dos arquivos QGIS"/>
                <Border x:Name="ProgressoQgis" x:FieldModifier="internal" Visibility="Collapsed" CornerRadius="24" Padding="24,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <ProgressRing IsActive="True" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock TextAlignment="Left" Text="Verificando a pasta QGIS…" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                  </StackPanel>
                </Border>
                <InfoBar x:Name="ResultadoQgis" x:FieldModifier="internal" IsClosable="True" IsOpen="False"/>
              </StackPanel>
            </StackPanel></Border>
            <!-- Sites da Prefeitura (2026-11-17): login persistente até "Sair"; linhas montadas em MainWindow.Sites.cs. -->
            <TextBlock TextAlignment="Left" Text="Sites da Prefeitura" Style="{StaticResource PmvniTituloSecao}"/>
            <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" TextWrapping="Wrap" Text="Entre uma vez pelo próprio site (Essencial, GPI, Alfresco): o app guarda o acesso, protegido pelo Windows só para este usuário, e o mantém ativo até você clicar em Sair. Para o caso de o servidor encerrar a sessão por conta própria, guarde também o usuário e a senha: o app entra sozinho quando o site pedir."/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel x:Name="PainelSites" x:FieldModifier="internal"/></Border>
            <!-- Acompanhamento de processos (2026-11-17): a planilha padrão que o módulo mostra e atualiza. -->
            <TextBlock TextAlignment="Left" Text="Acompanhamento de processos" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <StackPanel Padding="16,12" Spacing="6">
                    <local:LinhaComAcoes>
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock TextAlignment="Left" Text="Planilha de acompanhamento" Style="{StaticResource PmvniAjusteTitulo}"/>
                        <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="A planilha do Excel no modelo padrão (ACOMPANHAMENTO DE PROCESSOS). O módulo Acompanhamento mostra todas as colunas dela, com as listas e as cores configuradas, e grava nela tudo o que você muda no app. Antes de cada gravação, uma cópia de segurança vai para a pasta de dados do editor."/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Documento}" x:Name="BotaoEscolherPlanilha" x:FieldModifier="internal" Content="Selecionar planilha…" Style="{StaticResource PmvniBotaoPrimarioStyle}" AutomationProperties.Name="Selecionar a planilha de acompanhamento"
                                  local:Dicas.Titulo="Selecionar planilha…" local:Dicas.Descricao="Escolhe a planilha .xlsx do acompanhamento de processos."/>
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Conferir}" x:Name="BotaoVerificarPlanilha" x:FieldModifier="internal" Content="Verificar" AutomationProperties.Name="Verificar a planilha de acompanhamento"
                                  local:Dicas.Titulo="Verificar" local:Dicas.Descricao="Lê a planilha e mostra as colunas, listas e processos encontrados."/>
                        <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoAbrirPlanilha" x:FieldModifier="internal" Content="Abrir no Excel" AutomationProperties.Name="Abrir a planilha no Excel"
                                  local:Dicas.Titulo="Abrir no Excel" local:Dicas.Descricao="Abre a planilha de acompanhamento no Excel."/>
                      </StackPanel>
                    </local:LinhaComAcoes>
                    <TextBlock x:Name="CaixaPlanilhaAcompanhamento" ToolTipService.ToolTip="{Binding Text, ElementName=CaixaPlanilhaAcompanhamento}" x:FieldModifier="internal" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}" AutomationProperties.Name="Planilha de acompanhamento de processos"/>
                    <InfoBar x:Name="ResultadoPlanilha" x:FieldModifier="internal" IsClosable="True" IsOpen="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Preencher local e autor sozinho" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Quando a coluna Local ou Profissional está vazia, o editor procura no relatório analisado, na consulta QGIS e nas pranchas do processo e grava o que achar. Nunca troca o que já foi digitado." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarDetectarAcompanhamento" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Preencher local e autor sozinho"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== 5. Despachos e PDF ===== -->
          <StackPanel x:Name="CategoriaDespachos" Tag="despachos" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" Text="LibreOffice" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <StackPanel Padding="16,12" Spacing="6">
                <local:LinhaComAcoes>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock TextAlignment="Left" Text="LibreOffice" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="Gera o PDF dos despachos (sobre uma cópia do DOCX; o Word nunca é usado). Sem ele, sai só o DOCX."/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoEscolherSoffice" Style="{StaticResource PmvniBotaoPrimarioStyle}" x:FieldModifier="internal" Content="Escolher…" AutomationProperties.Name="Escolher o programa do LibreOffice"
                              local:Dicas.Titulo="Escolher…" local:Dicas.Descricao="Escolhe no computador o programa do LibreOffice (soffice.exe)."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Conferir}" x:Name="BotaoTestarSoffice" x:FieldModifier="internal" Content="Testar" AutomationProperties.Name="Testar o LibreOffice"
                              local:Dicas.Titulo="Testar" local:Dicas.Descricao="Confere se o LibreOffice abre e converte para PDF neste computador."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Pesquisar}" x:Name="BotaoSofficeAutomatico" x:FieldModifier="internal" Content="Procurar automaticamente" AutomationProperties.Name="Achar o LibreOffice sozinho"
                              local:Dicas.Titulo="Procurar automaticamente" local:Dicas.Descricao="Volta a procurar o LibreOffice instalado (desfaz uma escolha manual)."/>
                  </StackPanel>
                </local:LinhaComAcoes>
                <TextBlock TextAlignment="Left" x:Name="TextoSoffice" ToolTipService.ToolTip="{Binding Text, ElementName=TextoSoffice}" x:FieldModifier="internal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                <TextBlock TextAlignment="Left" x:Name="TextoTesteSoffice" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
              </StackPanel>
            </StackPanel></Border>
            <TextBlock TextAlignment="Left" Text="Depois de gravar" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Abrir o PDF depois de gravar" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Abre o PDF do despacho no programa padrão assim que ele é gravado na pasta do processo." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ToggleSwitch x:Name="AlternarAbrirPdf" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Abrir o PDF depois de gravar"/>
              </Grid>
            </StackPanel></Border>
            <!-- Profissional responsável (2026-11-17): o bloco de assinatura dos despachos e dos relatórios gerados, individual de cada profissional. -->
            <TextBlock TextAlignment="Left" Text="Profissional responsável" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel Padding="16,12" Spacing="8">
              <local:LinhaComAcoes>
                <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" TextWrapping="Wrap" Text="O nome e os dados que aparecem abaixo da linha de assinatura dos despachos e no fim dos relatórios gerados. Campo vazio mantém o texto do modelo."/>
                <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Salvar}" x:Name="BotaoSalvarProfissional" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" Content="Salvar dados" AutomationProperties.Name="Salvar os dados do profissional"
                          local:Dicas.Titulo="Salvar dados" local:Dicas.Descricao="Grava nome, profissão, registro e matrícula; valem a partir do próximo despacho e relatório."/>
              </local:LinhaComAcoes>
              <local:PainelCartoesAjustes>
                <TextBox x:Name="CaixaProfissionalNome" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200" x:FieldModifier="internal" Header="Nome" PlaceholderText="ex.: FULANO DE TAL" AutomationProperties.Name="Nome do profissional"/>
                <TextBox x:Name="CaixaProfissionalProfissao" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200" x:FieldModifier="internal" Header="Profissão" PlaceholderText="ex.: ARQUITETO E URBANISTA" AutomationProperties.Name="Profissão"/>
                <TextBox x:Name="CaixaProfissionalRegistro" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200" x:FieldModifier="internal" Header="Registro profissional" PlaceholderText="ex.: CAU/ES A000000-0" AutomationProperties.Name="Registro profissional (CAU ou CREA)"/>
                <TextBox x:Name="CaixaProfissionalMatricula" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200" x:FieldModifier="internal" Header="Matrícula" PlaceholderText="ex.: 123456" AutomationProperties.Name="Matrícula"/>
              </local:PainelCartoesAjustes>
                <TextBlock TextAlignment="Left" x:Name="TextoProfissionalSalvo" x:FieldModifier="internal" VerticalAlignment="Center" Style="{StaticResource PmvniAjusteAjuda}"/>
            </StackPanel></Border>
            <!-- Assinatura digital (2026-11-16): o certificado que assina o PDF dos despachos. A senha nunca aparece aqui nem vai para o ajustes.json. -->
            <TextBlock TextAlignment="Left" Text="Assinatura digital" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <StackPanel Padding="16,12" Spacing="6">
                <local:LinhaComAcoes>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock TextAlignment="Left" Text="Certificado digital" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="Escolha um certificado para assinar os PDFs. As opções de exibição controlam onde a assinatura pessoal fica visível."/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Abrir}" x:Name="BotaoEscolherCertificado" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" Content="Escolher arquivo…" AutomationProperties.Name="Escolher o arquivo do certificado digital"
                              local:Dicas.Titulo="Escolher arquivo…" local:Dicas.Descricao="Escolhe o arquivo do certificado digital (.pfx ou .p12)."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Chave}" x:Name="BotaoCertificadoWindows" x:FieldModifier="internal" Content="Certificado do Windows…" AutomationProperties.Name="Usar um certificado do repositório do Windows"
                              local:Dicas.Titulo="Certificado do Windows…" local:Dicas.Descricao="Usa um certificado instalado no Windows, em token ou em cartão; a senha é pedida pelo próprio dispositivo."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Conferir}" x:Name="BotaoConferirCertificado" x:FieldModifier="internal" Content="Conferir" AutomationProperties.Name="Conferir o certificado digital"
                              local:Dicas.Titulo="Conferir" local:Dicas.Descricao="Pede a senha e mostra o titular e a validade do certificado; nada é assinado."/>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Excluir}" x:Name="BotaoRemoverCertificado" x:FieldModifier="internal" Content="Remover" AutomationProperties.Name="Deixar de assinar os despachos"
                              local:Dicas.Titulo="Remover" local:Dicas.Descricao="Deixa de assinar os despachos e apaga a senha lembrada; o arquivo do certificado não é apagado."/>
                  </StackPanel>
                </local:LinhaComAcoes>
                <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Chave}" x:Name="BotaoCriarCertificado" x:FieldModifier="internal" Content="Criar certificado digital…" />
                <CheckBox x:Name="ExibirNoDespacho" x:FieldModifier="internal" Content="Mostrar assinatura no despacho"/>
                <CheckBox x:Name="ExibirNoCarimbo" x:FieldModifier="internal" Content="Mostrar assinatura no carimbo das pranchas"/>
                <TextBlock TextAlignment="Left" x:Name="TextoAssinatura" ToolTipService.ToolTip="{Binding Text, ElementName=TextoAssinatura}" x:FieldModifier="internal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                <TextBlock TextAlignment="Left" x:Name="TextoConferenciaCertificado" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
              </StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Lembrar a senha neste computador" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Desligado, a senha do arquivo é pedida a cada assinatura. Ligado, ela fica guardada cifrada, só para este usuário do Windows." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ToggleSwitch x:Name="AlternarLembrarSenha" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Lembrar a senha do certificado neste computador"/>
              </Grid>
            </StackPanel></Border>
            <Expander Header="Avançado" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="6">
                <local:LinhaComAcoes>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock TextAlignment="Left" Text="Perfil do LibreOffice" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}" Text="O editor usa um perfil próprio do LibreOffice. Se a conversão para PDF travar sempre, apague o perfil: o próximo PDF demora perto de um minuto, enquanto ele é criado de novo."/>
                    <TextBlock TextAlignment="Left" x:Name="TextoPerfilSoffice" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" IsTextSelectionEnabled="True"/>
                  </StackPanel>
                  <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Restaurar}" x:Name="BotaoRedefinirPerfil" x:FieldModifier="internal" Content="Redefinir perfil" AutomationProperties.Name="Redefinir o perfil do LibreOffice"
                            local:Dicas.Titulo="Redefinir perfil" local:Dicas.Descricao="Apaga o perfil do LibreOffice usado pelo editor; use se a conversão para PDF travar."/>
                </local:LinhaComAcoes>
              </StackPanel>
            </Expander>
          </StackPanel>

          <!-- ===== 6. Legislação ===== -->
          <StackPanel x:Name="CategoriaLegislacao" Tag="legislacao" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" Text="Pesquisa" Style="{StaticResource PmvniTituloSecao}"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}"><StackPanel>
              <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Pesquisar em" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="O alvo da pesquisa ao abrir uma lei no leitor." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                <ComboBox x:Name="CaixaEscopo" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Pesquisar em"/>
              </Grid>
            </StackPanel></Border>
            <!-- Leis anexadas (desenho §11.1): uma linha por anexo (título e esfera editáveis, arquivo, tamanho, páginas, data, selo,
                 Substituir arquivo… e Excluir). "Anexar PDFs…" fica sempre à mão (também com a lista vazia). -->
            <Border Style="{StaticResource PmvniAjusteGrupo}" Padding="16,12"><StackPanel x:Name="SecaoLegislacao" x:FieldModifier="internal" Spacing="8">
              <local:LinhaComAcoes>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" Text="Leis anexadas" Style="{StaticResource PmvniTituloSecao}"/>
                  <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}"
                            Text="Anexe os PDFs das leis que você consulta. O editor guarda uma cópia de cada um na pasta de dados dele e nunca altera o arquivo original. Nada é enviado para fora do computador."/>
                  <TextBlock TextAlignment="Left" x:Name="TextoTotalLegislacao" x:FieldModifier="internal" TextWrapping="Wrap"/>
                  <TextBlock TextAlignment="Left" x:Name="TextoSomenteLeituraLegislacao" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button x:Name="BotaoAnexarLegislacao" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}"
                            AutomationProperties.Name="Anexar PDFs das leis"
                            local:Dicas.Titulo="Anexar PDFs…" local:Dicas.Descricao="Acrescenta leis em PDF à biblioteca; o editor guarda uma cópia e não muda o original.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="{x:Bind local:Glifos.Anexar}" FontSize="16"/>
                      <TextBlock TextAlignment="Left" Text="Anexar PDFs…"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </local:LinhaComAcoes>
              <Grid x:Name="ProgressoLegislacao" x:FieldModifier="internal" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" x:Name="TextoProgressoLegislacao" x:FieldModifier="internal" TextWrapping="Wrap"/>
                  <ProgressBar local:Trabalhando.Automatico="False" x:Name="BarraProgressoLegislacao" x:FieldModifier="internal" IsIndeterminate="True"/>
                </StackPanel>
                <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.NaoConfigurado}" x:Name="BotaoCancelarLegislacao" x:FieldModifier="internal" Grid.Column="1" Content="Cancelar"
                        AutomationProperties.Name="Cancelar a anexação"
                        local:Dicas.Titulo="Cancelar" local:Dicas.Descricao="Para de anexar os PDFs; os que já entraram continuam na biblioteca."/>
              </Grid>
              <local:AreaDeAvisos RecuoAberto="0,0,0,12">
                <InfoBar x:Name="AvisoLegislacao" x:FieldModifier="internal" IsClosable="True"/>
                <InfoBar x:Name="AvisosAcervoLegislacao" x:FieldModifier="internal" IsClosable="True" Severity="Warning"/>
              </local:AreaDeAvisos>
              <!-- IsEnabled do ContentControl vale para os controles das linhas: catálogo só leitura ⇒ nada de alterar. -->
              <ContentControl x:Name="ConteudoAnexos" x:FieldModifier="internal" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <ItemsRepeater x:Name="ListaAnexos" x:FieldModifier="internal" ItemTemplate="{StaticResource ModeloLinhaAnexo}">
                  <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </ContentControl>
            </StackPanel></Border>
          </StackPanel>

          <!-- ===== 7. Inteligência artificial ===== -->
          <StackPanel x:Name="CategoriaIa" Tag="ia" Spacing="12" Visibility="Collapsed">
            <TextBlock TextAlignment="Left" x:Name="TituloAgentes" x:FieldModifier="internal" Text="Inteligência artificial" Visibility="Collapsed"/>
            <!-- Suas IAs (correções 2026-11-15, no padrão da página "IAs e contas" do WinStatusBar): um cartão por agente, com a conta, a assinatura, o
                 programa, a situação, os plugins do kit, a chave de API e o aviso. Tudo é consultado neste computador ao abrir a página, sem clicar em nada. -->
            <TextBlock TextAlignment="Left" Text="Suas IAs" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <local:CartaoAgente x:Name="CartaoChatGpt" x:FieldModifier="internal"/>
              <local:CartaoAgente x:Name="CartaoClaude" x:FieldModifier="internal"/>
              <local:CartaoAgente x:Name="CartaoGemini" x:FieldModifier="internal"/>
            </local:PainelCartoesAjustes>
            <TextBlock TextAlignment="Left" Text="Novo relatório" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <StackPanel Padding="16,12" Spacing="6">
                    <local:LinhaComAcoes>
                      <TextBlock Text="Rota da conta Codex" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                      <ComboBox x:Name="CaixaRotaCodex" x:FieldModifier="internal" AutomationProperties.Name="Rota da conta Codex">
                        <ComboBoxItem Tag="herdar" Content="Usar configuração do Codex neste PC"/>
                        <ComboBoxItem Tag="openai" Content="Conectar diretamente à OpenAI"/>
                        <ComboBoxItem Tag="codex-lb" Content="Usar Codex-LB configurado neste PC"/>
                      </ComboBox>
                    </local:LinhaComAcoes>
                    <local:LinhaComAcoes>
                      <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock TextAlignment="Left" Text="Pedido padrão" Style="{StaticResource PmvniAjusteTitulo}"/>
                        <TextBlock TextAlignment="Left" Text="Texto que já vem na caixa do Novo relatório (até 2000 caracteres). Vazio: a caixa começa vazia, com a dica de sempre." Style="{StaticResource PmvniAjusteAjuda}"/>
                      </StackPanel>
                      <TextBox x:Name="CaixaPedidoPadrao" x:FieldModifier="internal" AcceptsReturn="True" TextWrapping="Wrap" Width="360" MinHeight="72" MaxHeight="200"
                                MaxLength="2000" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Pedido padrão para a IA"/>
                    </local:LinhaComAcoes>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Confirmar antes de cancelar uma análise" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Pergunta antes de parar uma análise em andamento." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarConfirmarCancelar" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Confirmar antes de cancelar uma análise"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Avisar ao fechar com análise do ChatGPT em andamento" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Desligado, fechar a janela encerra a análise do ChatGPT sem perguntar (a do Claude continua sozinha, como sempre)." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarConfirmarFechar" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Avisar ao fechar com análise do ChatGPT em andamento"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>

          <!-- ===== 8. Sobre e suporte ===== -->
          <StackPanel x:Name="CategoriaModelos" Tag="modelos" Spacing="12" Visibility="Collapsed">
            <InfoBar Severity="Informational" IsClosable="False" IsOpen="True" Message="Personalização local. Os padrões do kit PMVNI são compartilhados; as alterações aqui valem somente para este computador."/>
            <TextBlock Text="ROTAS DE EXECUÇÃO" Style="{StaticResource PmvniAjusteTitulo}"/>
            <InfoBar x:Name="AvisoModelosAnalise" x:FieldModifier="internal" Severity="Warning" IsClosable="False" IsOpen="False" Title="Confira os modelos da análise"/>
            <Border Style="{StaticResource PmvniAjusteGrupo}">
              <StackPanel Padding="16,12" Spacing="12">
                <Grid x:Name="CartoesRotas" x:FieldModifier="internal" ColumnSpacing="6" RowSpacing="6"/>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="TituloRota" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" x:Name="BotaoAtualizarModelosIa" x:FieldModifier="internal" AutomationProperties.Name="Atualizar a lista de modelos de IA"
                          local:Dicas.Titulo="Atualizar lista" local:Dicas.Descricao="Consulta os modelos disponíveis nos aplicativos e nas APIs configuradas, incluindo a rota Gemini. Se a consulta falhar, mantém a última lista.">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Atualizar}" FontSize="16"/><TextBlock Text="Atualizar lista"/></StackPanel>
                  </Button>
                </Grid>
                <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="PainelModelosAnalise" x:FieldModifier="internal" AutomationProperties.Name="Modelos e níveis de cada etapa por rota"/>
                </ScrollViewer>
                <Grid x:Name="RodapeModelos" x:FieldModifier="internal" ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="OrigemModelos" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Column="1" Text="Aplicação imediata" Style="{StaticResource PmvniAjusteAjuda}"/>
                </Grid>
              </StackPanel>
            </Border>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Objeção técnica sobe um nível" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" x:Name="TextoRegraObjecao" x:FieldModifier="internal" TextWrapping="Wrap" Text="Na rota ChatGPT, uma nova tentativa após objeção técnica registrada sobe um nível de raciocínio, até alto. Durante a autocorreção, o Editor usa o modelo e o raciocínio da linha Autocorreção." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarSobeObjecao" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Objeção técnica sobe um nível"/>
                  </Grid>
                  <Border Style="{StaticResource PmvniAjusteDivisoria}"/>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Cota baixa desce o nível" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Com esta parte da cota restante (ou menos) na janela mais gasta da conta, o nível desce." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaCotaBaixa" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="Cota restante que desce o nível"/>
                  </Grid>
                  <TextBlock x:Name="TextoRegrasDasRotas" x:FieldModifier="internal" TextAlignment="Left" Margin="16,0,16,12" TextWrapping="Wrap" Style="{StaticResource PmvniAjusteAjuda}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <StackPanel Padding="16,12" Spacing="3">
                    <TextBlock TextAlignment="Left" Text="Auditoria cruzada" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock TextAlignment="Left" Text="Conferência feita pelo programa, sem IA e sem gastar cota, dos controles certificados pela auditoria técnica, antes da montagem do relatório. Ligada por padrão nas três rotas; desligada, a análise vai da auditoria técnica direto à montagem." TextWrapping="Wrap" Style="{StaticResource PmvniAjusteAjuda}"/>
                  </StackPanel>
                  <StackPanel x:Name="PainelAuditoriaCruzada" x:FieldModifier="internal"/>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <Border Style="{StaticResource PmvniAjusteGrupo}">
              <local:LinhaComAcoes Margin="16,12">
                <TextBlock TextAlignment="Left" x:Name="TextoModelosAnalise" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Exportar}" x:Name="BotaoPublicarModelos" x:FieldModifier="internal" Content="Publicar como padrão do kit" Visibility="Collapsed" AutomationProperties.Name="Publicar a tabela de modelos como padrão do kit"
                          local:Dicas.Titulo="Publicar como padrão do kit" local:Dicas.Descricao="Só no computador do kit mestre: grava esta tabela no kit e roda o instalador (manter) fora do Editor. A atualização automática leva a tabela aos outros computadores."/>
              </local:LinhaComAcoes>
            </Border>
            <!-- Modelos de IA (2026-11-17, no padrão do seletor do WinStatusBar): qual IA responde na revisão e nos ajustes, com que modelo e com que
                 nível de raciocínio. Uma linha por fonte disponível neste computador (montada em MainWindow.ModelosIa.cs); as listas vêm dos apps
                 ChatGPT e Claude e, nas APIs, da própria API. -->
            <TextBlock TextAlignment="Left" Text="Modelos de IA" Style="{StaticResource PmvniTituloSecao}"/>
            <TextBlock TextAlignment="Left" Style="{StaticResource PmvniAjusteAjuda}"
                       Text="A IA que responde quando você pede: Rever com a IA (com uma instrução escrita), Ajustar o item, esquadrias, volumetria e a instrução do despacho: o modelo e o nível de raciocínio de cada uma. As listas vêm dos apps ChatGPT e Claude deste computador e, nas APIs, da própria API. As etapas do Novo relatório usam os modelos da rota selecionada."/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="IA da revisão e dos ajustes" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" x:Name="TextoFonteIa" x:FieldModifier="internal" Text="Escolha por mim: o Codex, se estiver neste computador; senão o Claude Code." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ComboBox x:Name="CaixaIaFonte" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteEscolha}" VerticalAlignment="Center" AutomationProperties.Name="IA da revisão e dos ajustes"/>
                  </Grid>
                  <StackPanel x:Name="PainelModelosIa" x:FieldModifier="internal"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Padding="16,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock TextAlignment="Left" x:Name="TextoModelosIa" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteAjuda}" VerticalAlignment="Center"/>
                    <ProgressRing x:Name="AnelModelosIa" x:FieldModifier="internal" Grid.Column="1" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>

                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
          </StackPanel>
          <StackPanel x:Name="CategoriaSobre" Tag="sobre" Spacing="12" Visibility="Collapsed">
            <!-- Atualizações (no padrão de Configurações › Sobre e suporte do WinStatusBar): versão instalada, "Verificar atualizações" com o
                 estado embaixo, a chave da consulta automática e "O que mudou" (as notas da versão publicada). Quem preenche é
                 MainWindow.Ajustes.cs (Atualizador). -->
            <TextBlock TextAlignment="Left" Text="Atualizações" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Versão instalada" Style="{StaticResource PmvniAjusteTitulo}"/></StackPanel>
                    <TextBlock TextAlignment="Left" x:Name="TextoVersaoInstalada" x:FieldModifier="internal" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <local:LinhaComAcoes Margin="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Novas versões" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Procura versões novas no GitHub do projeto, baixa, confere e troca o executável sem pedir administrador. A versão nova vale ao abrir o editor de novo." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atualizar}" x:Name="BotaoReiniciarAtualizacao" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" Content="Reiniciar agora" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                AutomationProperties.Name="Reiniciar o editor na versão nova"
                                local:Dicas.Titulo="Reiniciar agora" local:Dicas.Descricao="Fecha o editor (gravando o relatório aberto) e o abre de novo na versão nova."/>
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atualizar}" x:Name="BotaoVerificarAtualizacoes" x:FieldModifier="internal" Content="Verificar atualizações" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Verificar atualizações"
                                local:Dicas.Titulo="Verificar atualizações" local:Dicas.Descricao="Procura agora uma versão nova do editor no GitHub e a instala se houver."/>
                      <TextBlock TextAlignment="Left" x:Name="TextoEstadoAtualizacao" x:FieldModifier="internal" TextWrapping="Wrap" Style="{StaticResource PmvniAjusteAjuda}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                  </local:LinhaComAcoes>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Atualizar automaticamente" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Procura sozinho a cada 15 minutos enquanto o editor está aberto. Desligado, só pelo botão acima." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <ToggleSwitch x:Name="AlternarAtualizarSozinho" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniAjusteAlternar}" VerticalAlignment="Center" AutomationProperties.Name="Atualizar automaticamente"/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>
            <Expander x:Name="ExpansorOQueMudou" x:FieldModifier="internal" Header="O que mudou" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <TextBlock TextAlignment="Left" x:Name="TextoOQueMudou" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniAjusteAjuda}"/>
            </Expander>
            <!-- Suporte, Diagnóstico e Sobre (2026-11-17, no padrão de Configurações › Sobre e suporte do WinStatusBar). Quem preenche é
                 MainWindow.Sobre.cs. -->
            <TextBlock TextAlignment="Left" Text="Suporte" Style="{StaticResource PmvniTituloSecao}"/>
            <local:PainelCartoesAjustes>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Contato" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Dúvidas, sugestões e relatos de problemas." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <HyperlinkButton x:Name="LinkContato" x:FieldModifier="internal" Grid.Column="1" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Enviar e-mail ao desenvolvedor"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <local:LinhaComAcoes Margin="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Relatar um problema" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Copie a versão e o sistema para enviar junto do relato, ou abra a pasta de dados com o registro de erros do editor." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Copiar}" x:Name="BotaoCopiarInformacoes" Style="{StaticResource PmvniBotaoPrimarioStyle}" x:FieldModifier="internal" Content="Copiar informações" HorizontalAlignment="Stretch"
                                local:Dicas.Titulo="Copiar informações" local:Dicas.Descricao="Copia a versão, o sistema e as pastas do editor para colar no relato."/>
                      <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.AbrirPasta}" x:Name="BotaoAbrirPastaDados" x:FieldModifier="internal" Content="Abrir pasta de dados" HorizontalAlignment="Stretch" AutomationProperties.Name="Abrir a pasta de dados no Explorador"
                                local:Dicas.Titulo="Abrir pasta de dados" local:Dicas.Descricao="Abre no Explorador a pasta de dados do editor (ajustes, leis, recuperação, erros)."/>
                    </StackPanel>
                  </local:LinhaComAcoes>
                  <TextBlock TextAlignment="Left" x:Name="TextoCopiado" x:FieldModifier="internal" Margin="16,0,16,12" Visibility="Collapsed" Style="{StaticResource PmvniAjusteAjuda}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Atalhos de teclado" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="A lista de Ajuda › Atalhos de teclado." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atalhos}" x:Name="BotaoVerAtalhos" x:FieldModifier="internal" Grid.Column="1" Content="Ver atalhos" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            local:Dicas.Descricao="Mostra a lista dos atalhos de teclado do app."/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PmvniAjusteGrupo}">
                <StackPanel>
                  <Grid Style="{StaticResource Linha}" SizeChanged="AoMudarTamanhoDaLinha">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock TextAlignment="Left" Text="Restaurar os ajustes" Style="{StaticResource PmvniAjusteTitulo}"/><TextBlock TextAlignment="Left" Text="Volta todas as opções ao padrão. Não apaga chaves de API, leis anexadas nem recentes." Style="{StaticResource PmvniAjusteAjuda}"/></StackPanel>
                    <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Restaurar}" x:Name="BotaoRestaurarAjustes" x:FieldModifier="internal" Grid.Column="1" Content="Restaurar…" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            AutomationProperties.Name="Restaurar os ajustes"
                            local:Dicas.Titulo="Restaurar…" local:Dicas.Descricao="Volta todas as opções ao padrão; pergunta antes de fazer."/>
                  </Grid>
                </StackPanel>
              </Border>
            </local:PainelCartoesAjustes>

