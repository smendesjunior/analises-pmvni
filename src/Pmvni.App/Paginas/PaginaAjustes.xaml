                    <TextBlock TextAlignment="Left" x:Name="TextoVersoes" x:FieldModifier="internal" FontFamily="Cascadia Mono, Consolas" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/>
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </Border>

            <TextBlock TextAlignment="Left" Text="Sobre" Style="{StaticResource PmvniTituloSecao}"/>
