        </StackPanel>
        <local:PainelQuebra x:Name="BotoesExecucao" Grid.Column="2" Espaco="8" EspacoLinhas="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="BotaoMostrarRegistro" x:FieldModifier="internal" AutomationProperties.Name="Abrir registro"
                    local:Dicas.Descricao="Abre no Explorador a pasta com o registro do que a IA está fazendo.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.AbrirPasta}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Abrir registro"/>
              </StackPanel>
            </Button>
            <Button x:Name="BotaoNovaAnalise" x:FieldModifier="internal" AutomationProperties.Name="Nova análise" Style="{StaticResource PmvniBotaoTonalStyle}"
                    local:Dicas.Descricao="Volta ao formulário para pedir outra análise.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Adicionar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Nova análise"/>
              </StackPanel>
            </Button>
            <Button x:Name="BotaoPausarAnalise" x:FieldModifier="internal" AutomationProperties.Name="Pausar análise"
                    local:Dicas.Descricao="Interrompe a execução e preserva o progresso disponível para retomada.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Pausado}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
