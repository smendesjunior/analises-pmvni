<UserControl x:Class="Pmvni.App.PaginaNovoRelatorio"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Novo relatório (desenho §12.2): no módulo Relatórios, no lugar das folhas enquanto está aberta. Formulário: processo, anexos (botão ou arrastar),
       pedido e as três rotas "Analisar"; vista da execução: andamento ao vivo, cancelar e o registro. Quem liga os controles é a janela
       (MainWindow.NovoRelatorio.cs). Nada é gravado antes do clique em Analisar. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
      <InfoBar x:Name="AvisoResultado" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="True">
        <InfoBar.Content>
          <!-- Some quando os dois botões estão escondidos: senão a margem deixava o aviso mais alto e o texto fora do centro. -->
          <StackPanel local:AcoesDeAviso.AutoOcultar="True" x:Name="AcoesResultado" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BotaoImportarPendente" x:FieldModifier="internal" Content="Importar relatório" Visibility="Collapsed" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                    local:Dicas.Descricao="Traz para o app o relatório da análise que terminou com o editor fechado."/>
            <Button x:Name="BotaoMostrarRegistroResultado" x:FieldModifier="internal" AutomationProperties.Name="Abrir registro"
                    local:Dicas.Descricao="Abre no Explorador a pasta com o registro do que a IA fez.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.AbrirPasta}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Abrir registro"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
    </local:AreaDeAvisos>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="12,4">
            <Button x:Name="BotaoContinuar" x:FieldModifier="internal" Content="Retomar análise" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                    local:Dicas.Descricao="Retoma a análise que parou, do ponto onde ela ficou."/>
            <Button x:Name="BotaoDescartar" x:FieldModifier="internal" Content="Descartar análise" Visibility="Collapsed"
                    local:Dicas.Descricao="Remove esta análise da lista de retomada e conserva os arquivos do processo."/>
    </StackPanel>

    <!-- Formulário. -->
    <!-- Correções 2026-11-15 (image7): sem rolagem horizontal; a coluna do formulário fica centralizada, com a largura da área visível
         (no máximo 1080) posta pelo código a cada mudança de tamanho: nada sai da tela, mesmo que um texto peça mais largura. -->
    <ScrollViewer x:Name="PainelFormulario" x:FieldModifier="internal" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <Grid x:Name="ColunaFormulario" x:FieldModifier="internal" Margin="0,12,0,16" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="12">
        <Grid ColumnSpacing="12" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4"><TextBlock Text="Novo relatório" Style="{StaticResource PmvniTituloPaginaStyle}"/><TextBlock Text="Selecione o processo, adicione os anexos e escolha como analisar." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button x:Name="BotaoExecucoes" x:FieldModifier="internal" Content="Ver andamento" Visibility="Collapsed"
                    local:Dicas.Descricao="Mostra o andamento da análise que a IA está fazendo agora."/>
            <Button x:Name="BotaoVoltarRelatorio" x:FieldModifier="internal" Content="Voltar ao relatório" Visibility="Collapsed"
                    local:Dicas.Descricao="Fecha esta tela e volta ao relatório que estava aberto."/>
          </StackPanel>
        </Grid>

        <Grid x:Name="GradeEtapas" ColumnSpacing="0" RowSpacing="12" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Border Grid.Row="0" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Pasta}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Processo" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MaxWidth="240"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <AutoSuggestBox x:Name="CaixaFiltro" x:FieldModifier="internal" PlaceholderText="Número ou requerente"
                          AutomationProperties.Name="Filtrar processos" UpdateTextOnSelect="False"
                          ToolTipService.ToolTip="Digite o número, o ano ou parte do nome e escolha o processo na lista de sugestões.">
            <AutoSuggestBox.ItemTemplate>
              <DataTemplate x:DataType="local:SugestaoProcesso">
                <TextBlock TextAlignment="Left" Text="{x:Bind Rotulo}" TextWrapping="Wrap"/>
              </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
          </AutoSuggestBox>
          <ComboBox x:Name="CaixaProcesso" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" PlaceholderText="Escolha o processo"
                    AutomationProperties.Name="Processo"/>
          <Button x:Name="BotaoCriarProcesso" x:FieldModifier="internal" Grid.Column="2" Content="Criar processo…"
                  local:Dicas.Descricao="Cria a pasta de um processo novo na pasta de processos."/>
        </Grid>
        <!-- 1.0.0: o resultado do filtro ("3 processos encontrados", "Nenhum processo encontrado para …"). -->
        <TextBlock x:Name="TextoFiltroProcessos" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource PmvniSecondaryTextStyle}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="TextoPastaProcesso" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>

        </StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Anexar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Anexos" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
        <Border x:Name="AreaAnexos" x:FieldModifier="internal" AllowDrop="True" MinHeight="76" CornerRadius="8"
                BorderThickness="0"
                Background="{ThemeResource PmvniSuperficieSuave}">
          <Grid><Rectangle RadiusX="8" RadiusY="8" Stroke="{ThemeResource PmvniTonalBorda}" StrokeDashArray="4,3" IsHitTestVisible="False"/><StackPanel Margin="8" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="{x:Bind local:Glifos.Anexar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock TextAlignment="Center" x:Name="TextoArraste" x:FieldModifier="internal" Text="Arraste arquivos para cá" HorizontalAlignment="Center"
                       Style="{StaticResource PmvniAjusteTitulo}"/>
            <Button x:Name="BotaoAnexar" x:FieldModifier="internal" Content="Anexar arquivos…" HorizontalAlignment="Center"
                    local:Dicas.Descricao="Escolhe no computador os arquivos do processo para a IA analisar."/>
            <!-- Abrindo um compactado grande: dá para parar (auditoria de interface 2026-11-17). -->
            <Button x:Name="BotaoCancelarAbertura" x:FieldModifier="internal" Content="Cancelar abertura" HorizontalAlignment="Center" Visibility="Collapsed"
                    local:Dicas.Descricao="Para de abrir o compactado; nada dele entra como anexo."/>

          </StackPanel></Grid>
        </Border>
        <TextBlock Text="Qualquer tipo de arquivo; .zip, .rar e .7z são abertos e cada arquivo de dentro entra como anexo. Nada é copiado antes de Analisar; a cópia vai para a pasta do processo e o original não muda."
                       Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        <StackPanel x:Name="ListaAnexos" x:FieldModifier="internal" Spacing="6"/>
        <TextBlock x:Name="TextoRecusas" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"
                   Style="{StaticResource PmvniTextoErroStyle}" TextAlignment="Left"/>

        </StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><Grid RowDefinitions="Auto,*" RowSpacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Editar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Pedido para a IA" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
        <TextBox Grid.Row="1" x:Name="CaixaPedido" x:FieldModifier="internal" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="320"
                 MaxLength="20000" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Pedido para a IA"/>

        </Grid></Border>
        </Grid>
        <Border x:Name="CartaoEscolhaAgente" Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Analisar" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <TextBlock Visibility="Collapsed" Text="Escolha a ferramenta que fará a análise." Style="{StaticResource PmvniSecondaryTextStyle}"/>
        <!-- Os três agentes com o mesmo peso (tonal, B7): não competem com o primário da faixa. -->
        <StackPanel Spacing="6">

          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="10,8">
            <StackPanel Spacing="4" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="ChatGPT" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" x:Name="TextoPluginChatGpt" x:FieldModifier="internal" Text="Pelo Codex · Análise — rota ChatGPT" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Grid>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoMotivoChatGpt" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <Button x:Name="BotaoChatGpt" AutomationProperties.Name="Analisar com o ChatGPT" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}" local:Brilho.Ativo="False" HorizontalAlignment="Stretch" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Analisar com o ChatGPT"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="10,8">
            <StackPanel Spacing="4" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="Claude" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" x:Name="TextoPluginClaude" x:FieldModifier="internal" Text="Pelo Claude Code · Análise — rota Claude" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Grid>
              <TextBlock Visibility="Collapsed" x:Name="TextoPedidoClaude" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoMotivoClaude" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <Button x:Name="BotaoClaude" AutomationProperties.Name="Analisar com o Claude" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}" local:Brilho.Ativo="False" HorizontalAlignment="Stretch" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Analisar com o Claude"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="10,8">
            <StackPanel Spacing="4" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="Gemini" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" x:Name="TextoPluginGemini" x:FieldModifier="internal" Text="Pelo Antigravity · Análise — rota Gemini" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Grid>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoPerfilGemini" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoMotivoGemini" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <Button x:Name="BotaoGemini" AutomationProperties.Name="Analisar com o Gemini" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}" local:Brilho.Ativo="False" HorizontalAlignment="Stretch" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Analisar com o Gemini"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
        </StackPanel></Border>
        </Grid>
        <ProgressRing x:Name="AnelPartida" x:FieldModifier="internal" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"
                      local:Trabalhando.Automatico="False"/>
      </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Faixa do monitor e três colunas de conteúdo com rolagem independente. -->
    <Grid x:Name="PainelExecucao" x:FieldModifier="internal" Grid.Row="2" Visibility="Collapsed" Padding="16,8,16,12" RowSpacing="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Border CornerRadius="8" Padding="6" VerticalAlignment="Center" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
          <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSeloSucesso}" AutomationProperties.AccessibilityView="Raw"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Monitor de análise" Style="{StaticResource PmvniTituloPaginaStyle}"/>
          <TextBlock Text="Execução da IA, atividades e descobertas em tempo real." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock TextAlignment="Right" Grid.Column="2" x:Name="ProcessoMonitor" x:FieldModifier="internal" MaxWidth="160" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PmvniPainelRotulo}"/>
      </Grid>
      <!-- 1. Resumo. -->
      <Border Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="10,6">
        <Grid ColumnSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="FundoIconeStatus" x:FieldModifier="internal" Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}">
            <FontIcon x:Name="IconeStatus" x:FieldModifier="internal" FontSize="16" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock TextAlignment="Left" x:Name="TituloStatus" x:FieldModifier="internal" Text="Análise em andamento"
                       Style="{StaticResource PmvniAjusteTitulo}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <local:PainelQuebra Espaco="12" EspacoLinhas="0">
              <TextBlock x:Name="TextoCabecalho" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <TextBlock x:Name="TextoProgressoItens" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
            </local:PainelQuebra>
          </StackPanel>
          <local:PainelQuebra x:Name="BotoesExecucao" Grid.Column="2" Espaco="8" EspacoLinhas="4" Margin="0,3" VerticalAlignment="Center">
            <Button x:Name="BotaoMostrarRegistro" x:FieldModifier="internal" AutomationProperties.Name="Abrir registro" local:Dicas.Descricao="Abre no Explorador a pasta com o registro do que a IA está fazendo.">
               <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.AbrirPasta}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Abrir registro"/></StackPanel>
            </Button>
            <Button x:Name="BotaoNovaAnalise" x:FieldModifier="internal" AutomationProperties.Name="Preparar nova análise" local:Dicas.Descricao="Volta ao formulário para pedir outra análise.">
               <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Adicionar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Preparar nova análise"/></StackPanel>
            </Button>
            <Button x:Name="BotaoPausarAnalise" x:FieldModifier="internal" AutomationProperties.Name="Pausar análise"
                    local:Dicas.Descricao="Interrompe a execução e preserva o progresso disponível para retomada.">
               <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Pausado}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Pausar análise"/></StackPanel>
            </Button>
            <Button x:Name="BotaoCancelarAnalise" x:FieldModifier="internal" AutomationProperties.Name="Cancelar análise" local:Dicas.Descricao="Para a análise da IA; nenhum relatório é criado.">
               <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE711;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Cancelar análise"/></StackPanel>
            </Button>
          </local:PainelQuebra>
            <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="8" RowSpacing="1" Margin="0,3,0,0">
              <TextBlock x:Name="TextoEtapaAtual" x:FieldModifier="internal" TextAlignment="Left" TextWrapping="Wrap" Style="{StaticResource PmvniSecondaryTextStyle}"/>
              <TextBlock Grid.Column="1" x:Name="TextoContagem" x:FieldModifier="internal"
                         VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="BarraResumoEtapas" x:FieldModifier="internal" Minimum="0" Maximum="100" Height="6"
                           Style="{StaticResource DefaultProgressBarStyle}" AutomationProperties.Name="Progresso da análise"/>
            </Grid>
          <local:PainelQuebra Grid.Row="3" Grid.ColumnSpan="3" Espaco="6" EspacoLinhas="4" Margin="0,3,0,0">
            <local:PainelQuebra.Resources>
              <Style x:Key="IndicadorMonitor" TargetType="Border">
                <Setter Property="MinHeight" Value="22"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="CornerRadius" Value="6"/>
              </Style>
              <Style x:Key="SeloRelogio" TargetType="Border" BasedOn="{StaticResource IndicadorMonitor}">
                <Setter Property="Background" Value="{ThemeResource PmvniTonalFundo}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource PmvniTonalBorda}"/>
                <Setter Property="BorderThickness" Value="1"/>
              </Style>
            </local:PainelQuebra.Resources>
            <Border Style="{StaticResource SeloRelogio}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                <FontIcon Glyph="&#xE916;" FontSize="12" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource PmvniTonalTexto}"/>
                <TextBlock Grid.Column="1" x:Name="TextoTempoDecorrido" Style="{StaticResource PmvniPainelRotulo}"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource SeloRelogio}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                <FontIcon Glyph="{x:Bind local:Glifos.Ano}" FontSize="12" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource PmvniTonalTexto}"/>
                <TextBlock Grid.Column="1" x:Name="TextoTempoEstimado" Style="{StaticResource PmvniPainelRotulo}"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource IndicadorMonitor}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Atende" Style="{StaticResource PmvniPainelRotulo}"/>
                <TextBlock Grid.Column="1" x:Name="TotalAtende" Text="0" Style="{StaticResource PmvniAjusteTitulo}"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource IndicadorMonitor}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Não atende" Style="{StaticResource PmvniPainelRotulo}"/>
                <TextBlock Grid.Column="1" x:Name="TotalNaoAtende" Text="0" Style="{StaticResource PmvniAjusteTitulo}"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource IndicadorMonitor}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Falta comprovar" Style="{StaticResource PmvniPainelRotulo}"/>
                <TextBlock Grid.Column="1" x:Name="TotalComprovar" Text="0" Style="{StaticResource PmvniAjusteTitulo}"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource IndicadorMonitor}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Informações divergentes" Style="{StaticResource PmvniPainelRotulo}"/>
                <TextBlock Grid.Column="1" x:Name="TotalDivergentes" Text="0" Style="{StaticResource PmvniAjusteTitulo}"/>
              </Grid>
            </Border>
          </local:PainelQuebra>
        </Grid>
      </Border>

      <!-- 2. Etapas (só no Claude, que informa a etapa). -->
      <Border x:Name="PainelClaude" x:FieldModifier="internal" Grid.Row="2" Padding="6,0" Visibility="Collapsed">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock Text="Etapas da análise" Style="{StaticResource PmvniTituloSecao}"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="PainelEtapas" x:FieldModifier="internal" MinWidth="620" AutomationProperties.Name="Etapas da análise"/>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Atividades | descobertas | próxima etapa e detalhes. -->
      <Grid x:Name="GradeConteudo" Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="11*"/>
          <ColumnDefinition Width="11*"/>
          <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="0"/>
          <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <Border x:Name="CartaoAtividades" Style="{StaticResource PmvniCartaoSecao}" Padding="12,10,8,8">
          <Grid RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" Margin="0,0,8,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <StackPanel Grid.Column="1">
                <TextBlock TextAlignment="Left" Text="Atividades da análise" Style="{StaticResource PmvniAjusteTitulo}"/>
                <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="Acompanhe o trabalho e o progresso de cada etapa." Style="{StaticResource PmvniSecondaryTextStyle}"/>
              </StackPanel>
              <Border x:Name="SeloAoVivo" x:FieldModifier="internal" Grid.Column="2" CornerRadius="12" Padding="10,3" VerticalAlignment="Center"
                      Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Ao vivo" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="4" Margin="0,0,8,0">
                <TextBlock TextAlignment="Left" x:Name="ContagemAtividades" Text="Aguardando as etapas da análise." TextWrapping="Wrap" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                <StackPanel x:Name="EtapasAtividades" Spacing="8"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <ScrollViewer x:Name="ColunaLateral" x:FieldModifier="internal" Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
            <!-- 4. Principais descobertas. -->
            <Border Style="{StaticResource PmvniCartaoSecao}" Padding="12,8">
              <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind local:Glifos.Conferir}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock TextAlignment="Left" Text="Principais descobertas" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock Text="Preliminares até a auditoria cruzada; depois, verificadas." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="ListaDescobertas" x:FieldModifier="internal" Spacing="8"/>
                <TextBlock x:Name="TextoSemDescobertas" x:FieldModifier="internal" Text="A IA ainda não relatou descobertas."
                           Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
        </ScrollViewer>

        <ScrollViewer x:Name="ColunaDetalhes" Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <!-- Resumo e próxima etapa. -->
            <Border x:Name="CartaoProximaEtapa" x:FieldModifier="internal" CornerRadius="8" Padding="16,12" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind local:Glifos.Avancar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                <StackPanel Grid.Column="1">
                  <TextBlock TextAlignment="Left" x:Name="TextoResumo" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TextoProximaEtapa" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Consumo por etapa (Tarefa 13): quem executou, tokens, cache, tempo e variação da cota; preenchido pela janela (MostrarConsumo). -->
            <Border x:Name="CartaoConsumo" x:FieldModifier="internal" Style="{StaticResource PmvniCartaoSecao}" Padding="12,8" Visibility="Collapsed">
              <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind local:Glifos.Grafico}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock TextAlignment="Left" Text="Consumo" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock Text="Por etapa, como o kit registrou; “—” quando não informado." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                  <Grid x:Name="GradeConsumo" x:FieldModifier="internal" ColumnSpacing="10" RowSpacing="4" Margin="0,0,0,4"
                        AutomationProperties.Name="Consumo por etapa"/>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <!-- 5. Detalhes da execução (recolhido). -->
            <Expander x:Name="ExpansorUltimaMensagem" x:FieldModifier="internal" AutomationProperties.Name="Detalhes da execução" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Expander.Header>
                <Grid ColumnSpacing="12" Padding="0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind local:Glifos.Propriedades}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock TextAlignment="Left" Text="Detalhes da execução" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock Text="Registro de atividades e última mensagem da IA." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Expander.Header>
              <StackPanel Spacing="10">
                <Button x:Name="BotaoEvidenciasPdf" x:FieldModifier="internal" Content="Abrir evidências por PDF e página" Visibility="Collapsed"
                        local:Dicas.Descricao="Abre as extrações locais das pranchas deste processo."/>
                <TextBlock x:Name="TextoRotulo" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBlock x:Name="TextoEventos" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Style="{StaticResource PmvniSecondaryTextStyle}"/>
            <ListView x:Name="ListaLinhas" x:FieldModifier="internal" MaxHeight="320" SelectionMode="None" IsItemClickEnabled="False"
                      AutomationProperties.Name="Registro de atividades">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Padding" Value="0,0,8,0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ItemAtividade">
                  <local:LinhaAndamento Item="{x:Bind Atividade}" EmCurso="{x:Bind EmCurso, Mode=OneWay}"/>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
                <StackPanel x:Name="PainelUltimaMensagem" x:FieldModifier="internal" Spacing="4">
                  <TextBlock TextAlignment="Left" Text="Última mensagem do ChatGPT" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TextoUltimaMensagem" x:FieldModifier="internal" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
