              <!-- Recebe as sombras dos cartões (ThemeShadow só projeta em quem não é ancestral de quem a lança). -->
              <Grid x:Name="ReceptorSombras" Background="Transparent"/>
              <StackPanel x:Name="ConteudoMonitor" x:FieldModifier="internal" Padding="20,12,20,24"/>
            </Grid>
          </ScrollViewer>
        </Grid>
      </NavigationView>
    </Grid>
  </Grid>
