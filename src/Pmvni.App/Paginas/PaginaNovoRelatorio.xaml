<UserControl x:Class="Pmvni.App.PaginaNovoRelatorio"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Novo relatório (desenho §12.2): no módulo Relatórios, no lugar das folhas enquanto está aberta. Formulário: processo, anexos (botão ou arrastar),
       pedido e as três rotas "Analisar"; vista da execução: andamento ao vivo, cancelar e o registro. Quem liga os controles é a janela
       (MainWindow.NovoRelatorio.cs). Nada é gravado antes do clique em Analisar. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
      <InfoBar x:Name="AvisoResultado" x:FieldModifier="internal" Severity="Error" IsOpen="False" IsClosable="True">
        <InfoBar.Content>
          <!-- Some quando os dois botões estão escondidos: senão a margem deixava o aviso mais alto e o texto fora do centro. -->
          <StackPanel local:AcoesDeAviso.AutoOcultar="True" x:Name="AcoesResultado" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.ImportarAnalise}" x:Name="BotaoImportarPendente" x:FieldModifier="internal" Content="Importar relatório" Visibility="Collapsed" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                    local:Dicas.Descricao="Traz para o app o relatório da análise que terminou com o editor fechado."/>
            <Button x:Name="BotaoMostrarRegistroResultado" x:FieldModifier="internal" AutomationProperties.Name="Abrir registro"
                    local:Dicas.Descricao="Abre no Explorador a pasta com o registro do que a IA fez.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.AbrirPasta}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Abrir registro"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
    </local:AreaDeAvisos>

    <StackPanel x:Name="AcoesRetomadaFormulario" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="12,4">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Executar}" x:Name="BotaoContinuar" x:FieldModifier="internal" Content="Retomar análise" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                    local:Dicas.Descricao="Retoma a análise que parou, do ponto onde ela ficou."/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Excluir}" x:Name="BotaoDescartar" x:FieldModifier="internal" Content="Descartar análise" Visibility="Collapsed"
                    local:Dicas.Descricao="Remove esta análise da lista de retomada e conserva os arquivos do processo."/>
    </StackPanel>

    <!-- Formulário. -->
    <!-- Correções 2026-11-15 (image7): sem rolagem horizontal; a coluna do formulário fica centralizada, com a largura da área visível
         (no máximo 1080) posta pelo código a cada mudança de tamanho: nada sai da tela, mesmo que um texto peça mais largura. -->
    <ScrollViewer x:Name="PainelFormulario" x:FieldModifier="internal" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <Grid x:Name="ColunaFormulario" x:FieldModifier="internal" Margin="0,12,0,16" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="12">
        <Grid ColumnSpacing="12" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><FontIcon Glyph="{x:Bind local:Glifos.Relatorio}" Style="{StaticResource PmvniIconeTituloPagina}" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock AutomationProperties.HeadingLevel="Level1" Text="Novo relatório" Style="{StaticResource PmvniTituloPaginaStyle}"/><TextBlock Text="Selecione o processo, adicione os anexos e escolha como analisar." Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel></Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Atividade}" x:Name="BotaoExecucoes" x:FieldModifier="internal" Content="Ver andamento" Visibility="Collapsed"
                    local:Dicas.Descricao="Mostra o andamento da análise que a IA está fazendo agora."/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Voltar}" x:Name="BotaoVoltarRelatorio" x:FieldModifier="internal" Content="Voltar ao relatório" Visibility="Collapsed"
                    local:Dicas.Descricao="Fecha esta tela e volta ao relatório que estava aberto."/>
          </StackPanel>
        </Grid>

        <Grid x:Name="GradeEtapas" ColumnSpacing="0" RowSpacing="12" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Border Grid.Row="0" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Pasta}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Processo" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MaxWidth="240"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <AutoSuggestBox x:Name="CaixaFiltro" x:FieldModifier="internal" PlaceholderText="Número ou requerente"
                          AutomationProperties.Name="Filtrar processos" UpdateTextOnSelect="False"
                          ToolTipService.ToolTip="Digite o número, o ano ou parte do nome e escolha o processo na lista de sugestões.">
            <AutoSuggestBox.ItemTemplate>
              <DataTemplate x:DataType="local:SugestaoProcesso">
                <TextBlock TextAlignment="Left" Text="{x:Bind Rotulo}" TextWrapping="Wrap"/>
              </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
          </AutoSuggestBox>
          <ComboBox x:Name="CaixaProcesso" x:FieldModifier="internal" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" PlaceholderText="Escolha o processo"
                    AutomationProperties.Name="Processo"/>
          <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Adicionar}" x:Name="BotaoCriarProcesso" x:FieldModifier="internal" Grid.Column="2" Content="Criar processo…"
                  local:Dicas.Descricao="Cria a pasta de um processo novo na pasta de processos."/>
        </Grid>
        <!-- 1.0.0: o resultado do filtro ("3 processos encontrados", "Nenhum processo encontrado para …"). -->
        <TextBlock x:Name="TextoFiltroProcessos" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource PmvniSecondaryTextStyle}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="TextoPastaProcesso" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>

        </StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Anexar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Anexos" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
        <Border x:Name="AreaAnexos" x:FieldModifier="internal" AllowDrop="True" MinHeight="76" CornerRadius="8"
                BorderThickness="0"
                Background="{ThemeResource PmvniSuperficieSuave}">
          <Grid><Rectangle RadiusX="8" RadiusY="8" Stroke="{ThemeResource PmvniTonalBorda}" StrokeDashArray="4,3" IsHitTestVisible="False"/><StackPanel Margin="8" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="{x:Bind local:Glifos.Anexar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock TextAlignment="Center" x:Name="TextoArraste" x:FieldModifier="internal" Text="Arraste arquivos para cá" HorizontalAlignment="Center"
                       Style="{StaticResource PmvniAjusteTitulo}"/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Anexar}" x:Name="BotaoAnexar" x:FieldModifier="internal" Content="Anexar arquivos…" HorizontalAlignment="Center"
                    local:Dicas.Descricao="Escolhe no computador os arquivos do processo para a IA analisar."/>
            <!-- Abrindo um compactado grande: dá para parar (auditoria de interface 2026-11-17). -->
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.NaoConfigurado}" x:Name="BotaoCancelarAbertura" x:FieldModifier="internal" Content="Cancelar abertura" HorizontalAlignment="Center" Visibility="Collapsed"
                    local:Dicas.Descricao="Para de abrir o compactado; nada dele entra como anexo."/>

          </StackPanel></Grid>
        </Border>
        <TextBlock Text="Qualquer tipo de arquivo; .zip, .rar e .7z são abertos e cada arquivo de dentro entra como anexo. Nada é copiado antes de Analisar; a cópia vai para a pasta do processo e o original não muda."
                       Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        <StackPanel x:Name="ListaAnexos" x:FieldModifier="internal" Spacing="6"/>
        <TextBlock x:Name="TextoRecusas" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"
                   Style="{StaticResource PmvniTextoErroStyle}" TextAlignment="Left"/>

        </StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><Grid RowDefinitions="Auto,*" RowSpacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Editar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Pedido para a IA" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
        <TextBox Grid.Row="1" x:Name="CaixaPedido" x:FieldModifier="internal" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="320"
                 MaxLength="20000" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Pedido para a IA"/>

        </Grid></Border>
        </Grid>
        <Border x:Name="CartaoEscolhaAgente" Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="14,10"><StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Analisar" Style="{StaticResource PmvniTituloSecao}"/>
            </StackPanel>
            <TextBlock Visibility="Collapsed" Text="Escolha a ferramenta que fará a análise." Style="{StaticResource PmvniSecondaryTextStyle}"/>
        <!-- Os três agentes com o mesmo peso (tonal, B7): não competem com o primário da faixa. -->
        <StackPanel Spacing="6">

          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="10,8">
            <StackPanel Spacing="4" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="ChatGPT" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" x:Name="TextoPluginChatGpt" x:FieldModifier="internal" Text="Pelo Codex · Análise — rota ChatGPT" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Grid>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoMotivoChatGpt" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <Button x:Name="BotaoChatGpt" AutomationProperties.Name="Analisar com o ChatGPT" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}" local:Brilho.Ativo="False" HorizontalAlignment="Stretch" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Analisar com o ChatGPT"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="10,8">
            <StackPanel Spacing="4" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="Claude" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" x:Name="TextoPluginClaude" x:FieldModifier="internal" Text="Pelo Claude Code · Análise — rota Claude" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Grid>
              <TextBlock Visibility="Collapsed" x:Name="TextoPedidoClaude" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoMotivoClaude" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <Button x:Name="BotaoClaude" AutomationProperties.Name="Analisar com o Claude" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}" local:Brilho.Ativo="False" HorizontalAlignment="Stretch" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Analisar com o Claude"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="10,8">
            <StackPanel Spacing="4" Background="{ThemeResource SubtleFillColorTransparentBrush}">
              <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" Text="Gemini" Style="{StaticResource PmvniAjusteTitulo}"/>
                  <TextBlock TextAlignment="Left" TextWrapping="Wrap" x:Name="TextoPluginGemini" x:FieldModifier="internal" Text="Pelo Antigravity · Análise — rota Gemini" Style="{StaticResource PmvniSecondaryTextStyle}"/>
                </StackPanel>
              </Grid>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoPerfilGemini" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <TextBlock TextAlignment="Left" Margin="42,0,0,0" x:Name="TextoMotivoGemini" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="Wrap"/>
              <Button x:Name="BotaoGemini" AutomationProperties.Name="Analisar com o Gemini" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoTonalStyle}" local:Brilho.Ativo="False" HorizontalAlignment="Stretch" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Ia}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Analisar com o Gemini"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
        </StackPanel></Border>
        </Grid>
        <ProgressRing x:Name="AnelPartida" x:FieldModifier="internal" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"
                      local:Trabalhando.Automatico="False"/>
      </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Monitor da execução. A rolagem da página entra quando a área visível não comporta os cartões. -->
    <ScrollViewer x:Name="RolagemMonitor" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PainelExecucao" x:FieldModifier="internal" Padding="24,12,24,12" RowSpacing="10"
          RowDefinitions="Auto,Auto,Auto,*">
      <Grid.Resources>
        <Style x:Key="MonitorCartao" TargetType="Border" BasedOn="{StaticResource PmvniCartaoSecao}">
          <Setter Property="CornerRadius" Value="10"/>
          <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="MonitorLadrilho" TargetType="Border">
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Padding" Value="8,5"/>
          <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="MonitorTitulo" TargetType="TextBlock" BasedOn="{StaticResource PmvniAjusteTitulo}">
          <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="MonitorRotulo" TargetType="TextBlock" BasedOn="{StaticResource PmvniPainelRotulo}">
          <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="MonitorLegenda" TargetType="TextBlock" BasedOn="{StaticResource PmvniSecondaryTextStyle}">
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonitorIndicador" TargetType="TextBlock" BasedOn="{StaticResource PmvniAjusteTitulo}">
          <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="MonitorTotal" TargetType="TextBlock" BasedOn="{StaticResource PmvniAjusteTitulo}">
          <Setter Property="FontSize" Value="29"/>
        </Style>
        <Style x:Key="MonitorLegendaLadrilho" TargetType="TextBlock" BasedOn="{StaticResource MonitorLegenda}">
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
        <Style x:Key="MonitorAoVivo" TargetType="Border">
          <Setter Property="CornerRadius" Value="12"/>
          <Setter Property="Padding" Value="8,3"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="Background" Value="{ThemeResource PmvniTonalFundo}"/>
        </Style>
        <!-- Os estilos aplicados em código seguem o tema da página, inclusive quando difere do tema do Windows. -->
        <Style x:Key="MonitorFundoAtivo" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource PmvniTonalFundo}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource PmvniTonalBorda}"/>
        </Style>
        <Style x:Key="MonitorFundoSucesso" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}"/>
        </Style>
        <Style x:Key="MonitorFundoErro" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Style>
        <Style x:Key="MonitorFundoModelo" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}"/>
        </Style>
        <Style x:Key="MonitorRotuloAtivo" TargetType="TextBlock" BasedOn="{StaticResource MonitorRotulo}">
          <Setter Property="Foreground" Value="{ThemeResource PmvniTonalTexto}"/>
        </Style>
        <Style x:Key="MonitorRotuloSucesso" TargetType="TextBlock" BasedOn="{StaticResource MonitorRotulo}">
          <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
        </Style>
        <Style x:Key="MonitorRotuloErro" TargetType="TextBlock" BasedOn="{StaticResource MonitorRotulo}">
          <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Style>
        <Style x:Key="MonitorRotuloCautela" TargetType="TextBlock" BasedOn="{StaticResource MonitorRotulo}">
          <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
        </Style>
        <Style x:Key="MonitorRotuloDivergencia" TargetType="TextBlock" BasedOn="{StaticResource MonitorRotulo}">
          <Setter Property="Foreground" Value="{ThemeResource PmvniEsferaFederalTexto}"/>
        </Style>
      </Grid.Resources>

      <Grid x:Name="GradeCabecalho" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" MinHeight="52">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Background="{ThemeResource PmvniTonalFundo}">
            <FontIcon Glyph="{x:Bind local:Glifos.Ia}" Style="{StaticResource PmvniIconeTituloPagina}" AutomationProperties.AccessibilityView="Raw"
                      Foreground="{ThemeResource PmvniTonalTexto}"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Monitor de análise" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"/>
            <TextBlock Text="Acompanhamento de execução, evidências e auditoria técnica em tempo real" Style="{StaticResource MonitorLegenda}"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="IdentificacaoMonitor" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center" MaxWidth="340">
          <StackPanel>
            <TextBlock Text="PROCESSO" TextAlignment="Right" Style="{StaticResource MonitorRotulo}"/>
            <TextBlock x:Name="ProcessoMonitor" x:FieldModifier="internal" Text="—" TextAlignment="Right" Style="{StaticResource PmvniAjusteTitulo}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" MinWidth="120" MaxWidth="220">
            <TextBlock Text="REQUERENTE" Style="{StaticResource MonitorRotulo}"/>
            <TextBlock x:Name="TextoRequerente" Text="Não informado" Style="{StaticResource PmvniAjusteTitulo}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
          <Border x:Name="SeparadorCabecalho" Grid.Column="2" Width="1" Height="28" VerticalAlignment="Center"
                  Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Grid>
        <local:PainelQuebra x:Name="BotoesExecucao" Grid.Column="2" Espaco="6" EspacoLinhas="4" VerticalAlignment="Center">
            <Button x:Name="BotaoMostrarRegistro" x:FieldModifier="internal" AutomationProperties.Name="Abrir registro"
                    local:Dicas.Descricao="Abre no Explorador a pasta com o registro do que a IA está fazendo.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.AbrirPasta}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Abrir registro"/>
              </StackPanel>
            </Button>
            <Button x:Name="BotaoNovaAnalise" x:FieldModifier="internal" AutomationProperties.Name="Nova análise" Style="{StaticResource PmvniBotaoPrimarioStyle}"
                    local:Dicas.Descricao="Volta ao formulário para pedir outra análise.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Adicionar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Nova análise"/>
              </StackPanel>
            </Button>
            <Button x:Name="BotaoPausarAnalise" x:FieldModifier="internal" AutomationProperties.Name="Pausar análise"
                    local:Dicas.Descricao="Interrompe a execução e preserva o progresso disponível para retomada.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Pausado}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Pausar"/>
              </StackPanel>
            </Button>
            <Button x:Name="BotaoCancelarAnalise" x:FieldModifier="internal" AutomationProperties.Name="Cancelar análise" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    local:Dicas.Descricao="Para a análise da IA. A execução cancelada não gera relatório.">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Fechar}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Cancelar"/>
              </StackPanel>
            </Button>
        </local:PainelQuebra>
      </Grid>

      <Border Grid.Row="1" x:Name="CartaoStatus" Style="{StaticResource MonitorCartao}" MinHeight="68">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
            <Border x:Name="FundoIconeStatus" x:FieldModifier="internal" Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center"
                    Style="{StaticResource MonitorFundoAtivo}">
              <Grid>
                <ProgressRing x:Name="AnelStatus" Width="24" Height="24" MinWidth="0" MinHeight="0" Visibility="Collapsed" local:Trabalhando.Automatico="False"/>
                <FontIcon x:Name="IconeStatus" x:FieldModifier="internal" Glyph="{x:Bind local:Glifos.Ia}" FontSize="18"
                          Style="{StaticResource PmvniIconeDestaqueStyle}" AutomationProperties.AccessibilityView="Raw"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <local:PainelQuebra Espaco="8" EspacoLinhas="2">
                <TextBlock x:Name="TituloStatus" x:FieldModifier="internal" Text="Aguardando execução"
                           Style="{StaticResource MonitorTitulo}" AutomationProperties.LiveSetting="Polite"/>
                <Border x:Name="SeloAoVivo" Style="{StaticResource MonitorAoVivo}" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource PmvniTonalTexto}" VerticalAlignment="Center"/>
                    <TextBlock Text="AO VIVO" Style="{StaticResource MonitorRotuloAtivo}"/>
                  </StackPanel>
                </Border>
              </local:PainelQuebra>
              <TextBlock x:Name="TextoEtapaAtual" x:FieldModifier="internal" Style="{StaticResource MonitorLegenda}"/>
            </StackPanel>
          </Grid>
          <local:PainelQuebra x:Name="MetricasStatus" Grid.Column="1" Espaco="22" EspacoLinhas="5" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="TEMPO DECORRIDO" Style="{StaticResource MonitorRotulo}"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind local:Glifos.Relogio}" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="TextoTempoDecorrido" Text="—" Style="{StaticResource PmvniAjusteTitulo}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="ETAPAS" Style="{StaticResource MonitorRotulo}"/>
              <TextBlock x:Name="TextoEtapasStatus" Text="—" Style="{StaticResource PmvniAjusteTitulo}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="PREVISÃO DE TÉRMINO" Style="{StaticResource MonitorRotulo}"/>
              <TextBlock x:Name="TextoTempoEstimado" Text="—" Style="{StaticResource PmvniAjusteTitulo}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </local:PainelQuebra>
        </Grid>
      </Border>

      <Border Grid.Row="2" x:Name="PainelClaude" x:FieldModifier="internal" Style="{StaticResource MonitorCartao}" MinHeight="102">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="8">
          <TextBlock Text="ETAPAS DA ANÁLISE" Style="{StaticResource PmvniPainelRotulo}" AutomationProperties.HeadingLevel="Level2"/>
          <TextBlock Grid.Column="1" x:Name="TextoTotalEtapas" Text="0 de 0 etapas concluídas" Style="{StaticResource MonitorLegenda}" TextAlignment="Right"/>
          <TextBlock Grid.Row="1" Text="Progresso global da análise" Style="{StaticResource MonitorLegenda}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TextoPercentual" Text="—" Style="{StaticResource MonitorIndicador}"
                     HorizontalAlignment="Right" Foreground="{ThemeResource PmvniTonalTexto}"/>
          <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5">
            <ProgressBar x:Name="BarraResumoEtapas" x:FieldModifier="internal" Maximum="100" Height="10" MinHeight="10"
                         CornerRadius="5" Background="Transparent" AutomationProperties.Name="Progresso global da análise"/>
          </Border>
          <Grid Grid.Row="3" Grid.ColumnSpan="2" x:Name="PainelEtapas" ColumnSpacing="8" RowSpacing="4" Margin="0,3,0,0"
                AutomationProperties.Name="Etapas da análise"/>
        </Grid>
      </Border>

      <!-- Atividades, descobertas, consumo e log têm áreas de leitura próprias. -->
      <Grid x:Name="GradeConteudo" Grid.Row="3" ColumnDefinitions="12*,13.5*,10*" RowDefinitions="*,0,0" ColumnSpacing="12">
        <Border x:Name="CartaoAtividades" Style="{StaticResource MonitorCartao}">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Text="Atividades da análise" Style="{StaticResource MonitorTitulo}" AutomationProperties.HeadingLevel="Level2"/>
                <Grid Grid.Column="2"><Border x:Name="SeloAtividades" Style="{StaticResource MonitorAoVivo}" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource PmvniTonalTexto}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ao vivo" Style="{StaticResource MonitorRotuloAtivo}"/>
                  </StackPanel>
                </Border></Grid>
              </Grid>
              <TextBlock Text="Acompanhe cada etapa e os registros de execução." Style="{StaticResource MonitorLegenda}"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource MonitorLadrilho}" MinHeight="36">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Etapas concluídas" Style="{StaticResource MonitorLegenda}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="ContagemAtividades" Text="0 / 0 · —" Style="{StaticResource PmvniAjusteTitulo}"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Atividades por etapa">
              <StackPanel x:Name="EtapasAtividades" Spacing="3" Margin="0,0,4,0"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border x:Name="CartaoDescobertas" Grid.Column="1" Style="{StaticResource MonitorCartao}">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Principais descobertas" Style="{StaticResource MonitorTitulo}" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Text="Constatações preliminares até a auditoria cruzada." Style="{StaticResource MonitorLegenda}"/>
              </StackPanel>
              <DropDownButton Grid.Column="1" Height="32" VerticalAlignment="Center" AutomationProperties.Name="Filtrar descobertas"
                              local:Dicas.Descricao="Filtra as descobertas pela classificação.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="{x:Bind local:Glifos.Filtro}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Filtrar"/>
                </StackPanel>
                <DropDownButton.Flyout>
                  <MenuFlyout>
                    <RadioMenuFlyoutItem x:Name="FiltroTodas" Text="Todas as classificações" GroupName="Classificacao" IsChecked="True" Click="FiltrarDescobertas"/>
                    <RadioMenuFlyoutItem Text="Atende" Tag="ATENDE" GroupName="Classificacao" Click="FiltrarDescobertas"/>
                    <RadioMenuFlyoutItem Text="Não atende" Tag="NAO_ATENDE" GroupName="Classificacao" Click="FiltrarDescobertas"/>
                    <RadioMenuFlyoutItem Text="Falta comprovar" Tag="NAO_COMPROVADO" GroupName="Classificacao" Click="FiltrarDescobertas"/>
                    <RadioMenuFlyoutItem Text="Informações divergentes" Tag="DIVERGENCIA_INTERNA" GroupName="Classificacao" Click="FiltrarDescobertas"/>
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </Grid>
            <Grid Grid.Row="1" x:Name="LadrilhosDescobertas" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4"
                  SizeChanged="AjustarLadrilhosDescobertas">
              <Border Grid.Column="0" Style="{StaticResource MonitorLadrilho}" MinHeight="86" Padding="5"
                      Background="{ThemeResource PmvniTonalFundo}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="ATENDE" Style="{StaticResource MonitorRotulo}"/>
                  <TextBlock x:Name="TotalAtende" Text="0" Style="{StaticResource MonitorTotal}" Foreground="{ThemeResource PmvniTonalTexto}"/>
                  <TextBlock Text="Conformidades" Style="{StaticResource MonitorLegendaLadrilho}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource MonitorLadrilho}" MinHeight="86" Padding="5"
                      Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="NÃO ATENDE" Style="{StaticResource MonitorRotulo}"/>
                  <TextBlock x:Name="TotalNaoAtende" Text="0" Style="{StaticResource MonitorTotal}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                  <TextBlock Text="Não conformidades" Style="{StaticResource MonitorLegendaLadrilho}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource MonitorLadrilho}" MinHeight="86" Padding="5"
                      Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="FALTA COMPROVAR" Style="{StaticResource MonitorRotulo}"/>
                  <TextBlock x:Name="TotalComprovar" Text="0" Style="{StaticResource MonitorTotal}" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                  <TextBlock Text="Sem evidência" Style="{StaticResource MonitorLegendaLadrilho}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Style="{StaticResource MonitorLadrilho}" MinHeight="86" Padding="5"
                      Background="{ThemeResource PmvniEsferaFederalFundo}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="DIVERGÊNCIAS" Style="{StaticResource MonitorRotuloDivergencia}"/>
                  <TextBlock x:Name="TotalDivergentes" Text="0" Style="{StaticResource MonitorTotal}" Foreground="{ThemeResource PmvniEsferaFederalTexto}"/>
                  <TextBlock Text="Inconsistências" Style="{StaticResource MonitorLegendaLadrilho}"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="EVIDÊNCIAS IDENTIFICADAS" Style="{StaticResource MonitorRotulo}"/>
              <TextBlock Grid.Column="1" x:Name="TextoRegistros" Text="0 registros" Style="{StaticResource MonitorLegenda}"/>
            </Grid>
            <Border Grid.Row="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9">
              <Grid>
                <ScrollViewer x:Name="ColunaLateral" x:FieldModifier="internal" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Evidências identificadas">
                  <StackPanel x:Name="ListaDescobertas" x:FieldModifier="internal" Spacing="6" Margin="5,5,8,5"/>
                </ScrollViewer>
                <ScrollViewer x:Name="VazioDescobertas" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
                  <StackPanel Spacing="5" Padding="12,8" MaxWidth="420" VerticalAlignment="Center">
                    <Border Style="{StaticResource MonitorLadrilho}" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center">
                      <FontIcon Glyph="{x:Bind local:Glifos.Conferir}" FontSize="24" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
                    </Border>
                    <TextBlock x:Name="TextoSemDescobertas" x:FieldModifier="internal" Text="Aguardando primeiras descobertas"
                               TextAlignment="Center" Style="{StaticResource PmvniAjusteTitulo}"/>
                    <TextBlock x:Name="TextoAjudaDescobertas" Text="As constatações aparecerão aqui, com classificação, referência ao PDF e página e trechos da evidência."
                               TextAlignment="Center" Style="{StaticResource MonitorLegenda}"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
            <local:PainelQuebra Grid.Row="4" Espaco="10" EspacoLinhas="0" Margin="0,-2,0,0">
              <TextBlock x:Name="TextoFiltro" Text="Exibição: todas as classificações" Style="{StaticResource MonitorLegenda}" VerticalAlignment="Center"/>
              <HyperlinkButton x:Name="LinkEvidenciasPdf" x:FieldModifier="internal" Visibility="Collapsed" Height="32" Padding="0"
                               AutomationProperties.Name="Ver evidências por PDF e página" local:Dicas.Descricao="Abre as extrações locais das pranchas deste processo.">
                <TextBlock Text="Ver evidências por PDF e página ›" TextWrapping="Wrap"/>
              </HyperlinkButton>
            </local:PainelQuebra>
          </Grid>
        </Border>

        <Grid x:Name="ColunaDetalhes" Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="10">
          <Border x:Name="CartaoConsumo" x:FieldModifier="internal" Style="{StaticResource MonitorCartao}">
            <StackPanel Spacing="5">
              <StackPanel>
                <TextBlock Text="Consumo e desempenho" Style="{StaticResource MonitorTitulo}" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Text="Uso registrado por etapa e modelo" Style="{StaticResource MonitorLegenda}"/>
              </StackPanel>
              <Border Style="{StaticResource MonitorLadrilho}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <TextBlock Text="Etapa" Style="{StaticResource MonitorLegenda}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TextoEtapaConsumo" Text="—" Style="{StaticResource PmvniAjusteTitulo}" TextAlignment="Right"/>
                    <TextBlock x:Name="TextoExecutorConsumo" Text="Nenhum uso registrado ainda" Style="{StaticResource MonitorLegenda}" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="1.6*,*,*" ColumnSpacing="4">
                <Border Style="{StaticResource MonitorLadrilho}">
                  <StackPanel>
                    <TextBlock Text="ENTRADA / SAÍDA" Style="{StaticResource MonitorRotulo}"/>
                    <TextBlock x:Name="TextoTokensConsumo" Text="— / —" Style="{StaticResource MonitorIndicador}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MonitorLadrilho}">
                  <StackPanel>
                    <TextBlock Text="CACHE" Style="{StaticResource MonitorRotulo}"/>
                    <TextBlock x:Name="TextoCacheConsumo" Text="—" Style="{StaticResource MonitorIndicador}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MonitorLadrilho}">
                  <StackPanel ToolTipService.ToolTip="O kit não registra custo; a variação da cota está nos detalhes">
                    <TextBlock Text="CUSTO" Style="{StaticResource MonitorRotulo}"/>
                    <TextBlock Text="—" Style="{StaticResource MonitorIndicador}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Expander x:Name="ExpansorConsumo" Header="Todas as etapas" MinHeight="32" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" IsEnabled="False">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" MaxHeight="110">
                  <Grid x:Name="GradeConsumo" x:FieldModifier="internal" ColumnSpacing="10" RowSpacing="4" AutomationProperties.Name="Consumo por etapa"/>
                </ScrollViewer>
              </Expander>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource MonitorCartao}">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="5">
              <StackPanel x:Name="CabecalhoLog">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="Log de execução" Style="{StaticResource MonitorTitulo}" AutomationProperties.HeadingLevel="Level2"/>
                  <Grid Grid.Column="1"><Border x:Name="SeloLog" Style="{StaticResource MonitorAoVivo}" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource PmvniTonalTexto}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ao vivo" Style="{StaticResource MonitorRotuloAtivo}"/>
                  </StackPanel>
                </Border></Grid>
                </Grid>
                <TextBlock x:Name="TextoContagem" x:FieldModifier="internal" Text="0 atividades registradas" Style="{StaticResource MonitorLegenda}"/>
              </StackPanel>
              <ListView Grid.Row="1" x:Name="ListaLinhas" x:FieldModifier="internal" SelectionMode="None" IsItemClickEnabled="False"
                        AutomationProperties.Name="Registro de atividades">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="0,0,4,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:ItemAtividade">
                    <local:LinhaAndamento Item="{x:Bind Atividade}" EmCurso="{x:Bind EmCurso, Mode=OneWay}"/>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Button Grid.Row="2" x:Name="BotaoEvidenciasPdf" x:FieldModifier="internal" Visibility="Collapsed" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Padding="8,4" Style="{StaticResource PmvniBotaoTonalStyle}"
                      AutomationProperties.Name="Abrir evidências por PDF e página"
                      local:Dicas.Descricao="Abre as extrações locais das pranchas deste processo.">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <FontIcon Glyph="{x:Bind local:Glifos.Relatorio}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Grid.Column="1" Text="Abrir evidências por PDF e página" TextTrimming="CharacterEllipsis"/>
                  <FontIcon x:Name="IconeAbrirEvidencias" Grid.Column="2" Glyph="{x:Bind local:Glifos.AbrirEmOutraJanela}"
                            FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
              </Button>
              <Expander Grid.Row="3" x:Name="ExpansorUltimaMensagem" x:FieldModifier="internal" Header="Detalhes" MinHeight="32"
                        AutomationProperties.Name="Detalhes da execução" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="148" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="6">
                    <Border x:Name="CartaoProximaEtapa" x:FieldModifier="internal" Style="{StaticResource MonitorFundoAtivo}"
                            Padding="8,5" CornerRadius="8" BorderThickness="1">
                      <StackPanel Spacing="2">
                        <TextBlock x:Name="TextoResumo" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}"/>
                        <TextBlock x:Name="TextoProximaEtapa" x:FieldModifier="internal" Style="{StaticResource MonitorLegenda}" IsTextSelectionEnabled="True"/>
                      </StackPanel>
                    </Border>
                    <TextBlock x:Name="TextoCabecalho" x:FieldModifier="internal" Style="{StaticResource MonitorLegenda}" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="TextoRotulo" x:FieldModifier="internal" Style="{StaticResource MonitorLegenda}" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="TextoEventos" x:FieldModifier="internal" Style="{StaticResource MonitorLegenda}" IsTextSelectionEnabled="True"/>
                    <StackPanel x:Name="PainelUltimaMensagem" x:FieldModifier="internal" Spacing="4">
                      <TextBlock Text="Última mensagem do ChatGPT" Style="{StaticResource PmvniAjusteTitulo}"/>
                      <TextBlock x:Name="TextoUltimaMensagem" x:FieldModifier="internal" Style="{StaticResource MonitorLegenda}" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Expander>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
