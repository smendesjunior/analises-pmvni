         PaginaNovoRelatorio.Nativo.cs, a partir dos mesmos dados do monitor de controles escondido (RolagemMonitor). -->
    <Grid Grid.Row="2" x:Name="MonitorNativo" x:FieldModifier="internal" Visibility="Collapsed" Background="Transparent" RowDefinitions="Auto,*">
      <Grid Padding="20,4,20,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
