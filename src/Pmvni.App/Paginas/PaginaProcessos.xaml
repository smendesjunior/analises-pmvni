<UserControl x:Class="Pmvni.App.PaginaProcessos"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <UserControl.Resources>
    <!-- Modo Lista: na frente de cada arquivo, o ícone do tipo que o Windows associa à extensão (IconeArquivo); os títulos de grupo
         (etapa, tipo ou data) são linhas que não se escolhem. -->
    <DataTemplate x:Key="ModeloLinhaDetalhe" x:DataType="local:ItemArquivo">
      <Grid Padding="0,5" ColumnSpacing="10" AutomationProperties.Name="{x:Bind NomeAcessivel}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:IconeArquivo Caminho="{x:Bind Caminho}" VerticalAlignment="Top" Margin="0,1,0,0"/>
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Style="{StaticResource PmvniAjusteTitulo}"
                     Visibility="{x:Bind EhTitulo}" Margin="0,8,0,0"/>
          <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Visibility="{x:Bind NaoEhTitulo}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Texto}"/>
          <TextBlock TextAlignment="Left" Text="{x:Bind Info}" Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="{x:Bind TemInfo}" TextTrimming="CharacterEllipsis"
                     ToolTipService.ToolTip="{x:Bind Info}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <!-- Modo Miniaturas: o bloco do Explorador em "ícones grandes" — a prévia do arquivo e o nome embaixo, em até três linhas. -->
    <DataTemplate x:Key="ModeloMiniatura" x:DataType="local:ItemArquivo">
      <StackPanel Width="120" Height="168" Padding="4,6,4,2" Spacing="4" Background="Transparent"
                  AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Dica}">
        <local:MiniaturaArquivo Caminho="{x:Bind Caminho}" HorizontalAlignment="Center"/>
        <TextBlock Text="{x:Bind Texto}" Style="{StaticResource PmvniSecondaryTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="3"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- Módulo Processos (desenho §9): a lista de processos da pasta de processos à esquerda (mais recentes primeiro; a pesquisa da barra de
       título filtra por número ou requerente) e, à direita, o que há no processo escolhido: relatórios, despachos e, se pedido, PROJETO
       e DOCUMENTOS. Só leitura: as linhas e os botões são ligados pela janela (MainWindow.Pastas.cs). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoPasta" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="False" Title="">
        <InfoBar.ActionButton>
          <Button x:Name="BotaoAbrirAjustes" x:FieldModifier="internal" Content="Abrir Ajustes"
                  local:Dicas.Descricao="Abre os Ajustes para escolher a pasta onde ficam os processos."/>
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
    </local:AreaDeAvisos>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12" ColumnSpacing="12" Padding="16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="284" MinWidth="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10"><FontIcon Glyph="{x:Bind local:Glifos.Pasta}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><StackPanel Grid.Column="1"><TextBlock TextAlignment="Left" Text="Acervo de processos" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PmvniTituloPaginaStyle}"/><TextBlock TextAlignment="Left" Text="Gestão de documentos e histórico" Style="{StaticResource PmvniSecondaryTextStyle}"/></StackPanel><TextBlock TextAlignment="Left" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Text, ElementName=TextoContagem}" Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.AccessibilityView="Raw"/></Grid>


      <!-- Lista de processos. -->
      <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource PmvniPainelLateral}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="16,10,12,6" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="Processos" Style="{StaticResource PmvniTituloSecao}" AutomationProperties.HeadingLevel="Level2"/>
            </StackPanel>
            <TextBlock TextAlignment="Left" x:Name="TextoContagem" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" AutomationProperties.Name="Quantidade de processos"/>
            <Grid>
              <TextBox TextAlignment="Left" Style="{StaticResource PmvniCampoPesquisa}" x:Name="FiltroAcervo" x:FieldModifier="internal" PlaceholderText="Número ou nome do processo" AutomationProperties.Name="Filtrar processos"/>
              <FontIcon Glyph="{x:Bind local:Glifos.Pesquisar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
          </StackPanel>
          <ProgressRing x:Name="Anel" x:FieldModifier="internal" Grid.Column="1" IsActive="False" Width="18" Height="18"/>
        </Grid>
        <ListView x:Name="ListaProcessos" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" Padding="6,0,6,8"
                  PointerMoved="AoMoverSobreProcessos" PointerExited="AoSairDosProcessos"
                  PointerPressed="AoSairDosProcessos" KeyDown="AoUsarTecladoNosProcessos" AutomationProperties.Name="Processos">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:LinhaProcesso">
              <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Titulo}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Iniciais}" Style="{StaticResource PmvniPainelMarcaTexto}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" Text="{x:Bind Titulo}" Style="{StaticResource PmvniAjusteTitulo}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock TextAlignment="Left" Text="{x:Bind Detalhe}" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <!-- Lista vazia (M5): a tela vazia do módulo (ícone, título, frase e botões). A janela escreve o texto e a visibilidade em
             TextoListaVazia (guardado fora da tela); a frase e a visibilidade da tela vazia seguem esse texto. -->
        <local:EstadoVazio x:Name="Vazio" x:FieldModifier="internal" Grid.Row="1" Visibility="{Binding Visibility, ElementName=TextoListaVazia}"/>
        <Border Grid.Row="1" Visibility="Collapsed">
          <TextBlock TextAlignment="Left" x:Name="TextoListaVazia" x:FieldModifier="internal" Visibility="Collapsed"/>
        </Border>
      </Grid>

      <!-- Detalhe do processo escolhido. -->
      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" SizeChanged="AoDimensionarDetalhe" RowDefinitions="Auto,Auto" Padding="12,8" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" ColumnSpacing="10">
              <TextBlock TextAlignment="Left" x:Name="TextoTituloDetalhe" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}" AutomationProperties.HeadingLevel="Level2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Border x:Name="SeloProtocolo" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="Collapsed">
                <TextBlock TextAlignment="Center" x:Name="TextoProtocolo" Style="{StaticResource PmvniPainelMarcaTexto}"/>
              </Border>
            </Grid>
            <TextBlock TextAlignment="Left" x:Name="TextoPastaDetalhe" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" IsTextSelectionEnabled="True"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
          <!-- 2026-11-16: como os arquivos do processo aparecem (como "Classificar" e "Visualizar" do Explorador). A escolha fica
               lembrada nos Ajustes; a janela guarda (MainWindow.Pastas.cs). -->
          <local:PainelQuebra x:Name="BarraExibicao" x:FieldModifier="internal" Grid.Column="1" Espaco="8" VerticalAlignment="Bottom">
            <DropDownButton x:Name="BotaoClassificar" x:FieldModifier="internal" AutomationProperties.Name="Classificar"
                            local:Dicas.Titulo="Ordenar" local:Dicas.Descricao="Ordena os arquivos do processo por nome, data ou tipo, em ordem crescente ou decrescente.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind local:Glifos.Ordenar}" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Ordenar"/>
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <ToggleMenuFlyoutItem x:Name="ItemOrdemNome" x:FieldModifier="internal" Text="Nome" Click="AoEscolherOrdem"/>
                  <ToggleMenuFlyoutItem x:Name="ItemOrdemData" x:FieldModifier="internal" Text="Data" Click="AoEscolherOrdem"/>
                  <ToggleMenuFlyoutItem x:Name="ItemOrdemTipo" x:FieldModifier="internal" Text="Tipo" Click="AoEscolherOrdem"/>
                  <MenuFlyoutSeparator/>
                  <ToggleMenuFlyoutItem x:Name="ItemCrescente" x:FieldModifier="internal" Text="Crescente" Click="AoEscolherSentido"/>
                  <ToggleMenuFlyoutItem x:Name="ItemDecrescente" x:FieldModifier="internal" Text="Decrescente" Click="AoEscolherSentido"/>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="BotaoAgrupar" x:FieldModifier="internal" AutomationProperties.Name="Agrupar"
                            local:Dicas.Descricao="Junta os arquivos do processo por etapa ou pasta, por tipo de arquivo ou por data.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Agrupar"/>
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoEtapa" x:FieldModifier="internal" Text="Etapa ou pasta" Click="AoEscolherGrupo"/>
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoTipo" x:FieldModifier="internal" Text="Tipo de arquivo" Click="AoEscolherGrupo"/>
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoData" x:FieldModifier="internal" Text="Data" Click="AoEscolherGrupo"/>
                  <MenuFlyoutSeparator/>
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoNenhum" x:FieldModifier="internal" Text="Não agrupar" Click="AoEscolherGrupo"/>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="BotaoVisualizar" x:FieldModifier="internal" AutomationProperties.Name="Visualizar"
                            local:Dicas.Descricao="Mostra os arquivos do processo em lista (três colunas) ou em miniaturas, com a prévia de cada arquivo.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="{x:Bind local:Glifos.Painel}" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="Visualizar"/>
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <ToggleMenuFlyoutItem x:Name="ItemModoLista" x:FieldModifier="internal" Text="Lista" Click="AoEscolherModo">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/></ToggleMenuFlyoutItem.Icon>
                  </ToggleMenuFlyoutItem>
                  <ToggleMenuFlyoutItem x:Name="ItemModoMiniaturas" x:FieldModifier="internal" Text="Miniaturas" Click="AoEscolherModo">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Figuras}" FontSize="16" AutomationProperties.AccessibilityView="Raw"/></ToggleMenuFlyoutItem.Icon>
                  </ToggleMenuFlyoutItem>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </local:PainelQuebra>
        </Grid>
        <!-- Modo Lista (correções 2026-11-15): três colunas (Relatórios, Despachos, Projeto), cada uma agrupada e ordenada pela escolha
             de Agrupar e Classificar. A ListaDetalhe guarda a seleção (os comandos e o roteiro leem dela) e fica fora da tela; as colunas
             mostram as mesmas linhas. -->
        <Grid Grid.Row="1" x:Name="GradeColunas" x:FieldModifier="internal" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="8" Grid.Column="0">
            <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid ColumnDefinitions="*,Auto" Margin="6,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="4"><FontIcon Glyph="{x:Bind local:Glifos.Relatorio}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><TextBlock TextAlignment="Left" Grid.Column="1" Text="Relatórios" TextWrapping="Wrap" Style="{StaticResource PmvniTituloSecao}"/></Grid><TextBlock TextAlignment="Center" x:Name="TotalRelatorios" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/></Grid>
              <ListView x:Name="ColunaRelatorios" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" ItemTemplate="{StaticResource ModeloLinhaDetalhe}" AutomationProperties.Name="Relatórios"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="8" Grid.Column="1">
            <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid ColumnDefinitions="*,Auto" Margin="6,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="4"><FontIcon Glyph="{x:Bind local:Glifos.Despacho}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><TextBlock TextAlignment="Left" Grid.Column="1" Text="Despachos" TextWrapping="Wrap" Style="{StaticResource PmvniTituloSecao}"/></Grid><TextBlock TextAlignment="Center" x:Name="TotalDespachos" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/></Grid>
              <ListView x:Name="ColunaDespachos" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" ItemTemplate="{StaticResource ModeloLinhaDetalhe}" AutomationProperties.Name="Despachos"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="8" Grid.Column="2">
            <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid ColumnDefinitions="*,Auto" Margin="6,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="4"><FontIcon Glyph="{x:Bind local:Glifos.Documento}" FontSize="16" Style="{StaticResource PmvniIconeDestaqueStyle}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/><TextBlock TextAlignment="Left" Grid.Column="1" Text="Projeto e documentos" TextWrapping="Wrap" Style="{StaticResource PmvniTituloSecao}"/></Grid><TextBlock TextAlignment="Center" x:Name="TotalProjeto" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/></Grid>
              <ListView x:Name="ColunaProjeto" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" ItemTemplate="{StaticResource ModeloLinhaDetalhe}" AutomationProperties.Name="Projeto e documentos"/>
            </Grid>
          </Border>
          </Grid>
        <!-- Modo Miniaturas (2026-11-16): no lugar das três colunas, uma grade só, como o Explorador em "ícones grandes": todos os
             arquivos do processo com a prévia, em grupos que se recolhem pelo cabeçalho. A grade só cria os blocos que estão na tela. -->
        <Border x:Name="CartaoMiniaturas" x:FieldModifier="internal" Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="8" Margin="0"
                Visibility="Collapsed">
          <Grid>
            <GridView x:Name="GradeMiniaturas" x:FieldModifier="internal" SelectionMode="Single" IsItemClickEnabled="False" Padding="4,0,4,4"
                      IsSynchronizedWithCurrentItem="False"
                      ItemTemplate="{StaticResource ModeloMiniatura}" AutomationProperties.Name="Arquivos do processo em miniaturas">
              <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" AreStickyGroupHeadersEnabled="False"/>
                </ItemsPanelTemplate>
              </GridView.ItemsPanel>
              <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="False">
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate x:DataType="local:GrupoMiniaturas">
                      <Button Click="AoAlternarGrupo" Background="Transparent" BorderThickness="0" Padding="4,2"
                              AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Dica}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon Glyph="{x:Bind Glifo}" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                          <TextBlock TextAlignment="Left" Text="{x:Bind Titulo}" Style="{StaticResource PmvniAjusteTitulo}" VerticalAlignment="Center"/>
                          <TextBlock TextAlignment="Left" Text="{x:Bind Contagem}" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </GridView.GroupStyle>
            </GridView>
            <TextBlock TextAlignment="Left" x:Name="TextoSemMiniaturas" x:FieldModifier="internal" Margin="12,8" Text="Nenhum arquivo neste processo."
                       Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ListView x:Name="ListaDetalhe" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" Padding="12,0,12,8" Opacity="0" IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" Width="1" HorizontalAlignment="Left"
                  AutomationProperties.Name="Conteúdo do processo">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:LinhaDetalhe">
              <StackPanel Padding="0,5" Spacing="1" AutomationProperties.Name="{x:Bind NomeAcessivel}">
                <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Style="{StaticResource PmvniAjusteTitulo}" Visibility="{x:Bind EhTitulo}" Margin="0,8,0,0"/>
                <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Visibility="{x:Bind NaoEhTitulo}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Texto}"/>
                <TextBlock TextAlignment="Left" Text="{x:Bind Info}" Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="{x:Bind TemInfo}" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Info}"/>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <!-- Auditoria de interface (2026-11-17): a frase fica no meio da área, maior (antes, pequena no canto de uma área enorme). -->
        <TextBlock x:Name="TextoSemProcesso" x:FieldModifier="internal" Grid.Row="1" Margin="20,12" TextWrapping="Wrap" MaxWidth="440"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Text="Escolha um processo na lista." Style="{StaticResource PmvniSecondaryTextStyle}"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
