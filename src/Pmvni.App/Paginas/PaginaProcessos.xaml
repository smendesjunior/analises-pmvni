<UserControl x:Class="Pmvni.App.PaginaProcessos"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <UserControl.Resources>
    <!-- Modo Lista: na frente de cada arquivo, o ícone do tipo que o Windows associa à extensão (IconeArquivo); os títulos de grupo
         (etapa, tipo ou data) são linhas que não se escolhem. -->
    <DataTemplate x:Key="ModeloLinhaDetalhe" x:DataType="local:ItemArquivo">
      <Grid Padding="0,5" ColumnSpacing="10" AutomationProperties.Name="{x:Bind NomeAcessivel}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:IconeArquivo Caminho="{x:Bind Caminho}" VerticalAlignment="Top" Margin="0,1,0,0"/>
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                     Visibility="{x:Bind EhTitulo}" Margin="0,8,0,0"/>
          <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Visibility="{x:Bind NaoEhTitulo}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Texto}"/>
          <TextBlock TextAlignment="Left" Text="{x:Bind Info}" Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="{x:Bind TemInfo}" TextTrimming="CharacterEllipsis"
                     ToolTipService.ToolTip="{x:Bind Info}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <!-- Modo Miniaturas: o bloco do Explorador em "ícones grandes" — a prévia do arquivo e o nome embaixo, em até três linhas. -->
    <DataTemplate x:Key="ModeloMiniatura" x:DataType="local:ItemArquivo">
      <StackPanel Width="120" Height="168" Padding="4,6,4,2" Spacing="4" Background="Transparent"
                  AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Dica}">
        <local:MiniaturaArquivo Caminho="{x:Bind Caminho}" HorizontalAlignment="Center"/>
        <TextBlock Text="{x:Bind Texto}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="3"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- Módulo Processos (desenho §9): a lista de processos da pasta de processos à esquerda (mais recentes primeiro; a pesquisa da barra de
       título filtra por número ou requerente) e, à direita, o que há no processo escolhido: relatórios, despachos e, se pedido, PROJETO
       e DOCUMENTOS. Só leitura: as linhas e os botões são ligados pela janela (MainWindow.Pastas.cs). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Avisos (no máximo 2 à vista; o resto em "+n"; informativos fecham sozinhos). -->
    <local:AreaDeAvisos x:Name="AreaAvisos" x:FieldModifier="internal" Grid.Row="0">
      <InfoBar x:Name="AvisoPasta" x:FieldModifier="internal" Severity="Warning" IsOpen="False" IsClosable="False" Title="">
        <InfoBar.ActionButton>
          <Button x:Name="BotaoAbrirAjustes" x:FieldModifier="internal" Content="Abrir Ajustes"
                  local:Dicas.Descricao="Abre os Ajustes para escolher a pasta onde ficam os processos."/>
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="AvisoMensagem" x:FieldModifier="internal" Severity="Informational" IsOpen="False" IsClosable="True"/>
    </local:AreaDeAvisos>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12" ColumnSpacing="12" Padding="16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="284" MinWidth="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10"><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="23" Height="18.74"><Path Canvas.Left="-9.5" Canvas.Top="-11.63" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M23.41,14.19 L30.8,14.19 C31.74,14.19 32.5,14.95 32.5,15.89 L32.5,25.35 C32.5,26.24 31.78,26.96 30.89,26.96 L29.09,26.96 L29.09,28.76 C29.09,29.65 28.37,30.37 27.48,30.37 L11.2,30.37 C10.26,30.37 9.5,29.61 9.5,28.67 L9.5,16.74 C9.5,15.8 10.26,15.04 11.2,15.04 L12.91,15.04 L12.91,13.33 C12.91,12.39 13.67,11.63 14.61,11.63 L19.44,11.63 C19.81,11.63 20.17,11.75 20.46,11.97 L23.41,14.19 Z M27.39,28.67 L11.2,28.67 L11.2,16.74 L16.03,16.74 L19.21,19.13 C19.36,19.24 19.54,19.3 19.72,19.3 L27.39,19.3 L27.39,28.67 Z M30.8,25.26 L29.09,25.26 L29.09,19.3 C29.09,18.36 28.33,17.59 27.39,17.59 L20.01,17.59 L17.05,15.38 C16.76,15.16 16.4,15.04 16.03,15.04 L14.61,15.04 L14.61,13.33 L19.44,13.33 L22.62,15.72 C22.77,15.83 22.95,15.89 23.13,15.89 L30.8,15.89 L30.8,25.26 Z"/></Canvas></Viewbox><StackPanel Grid.Column="1"><TextBlock TextAlignment="Left" Text="Acervo de processos" Style="{StaticResource PmvniTituloPaginaStyle}"/><TextBlock TextAlignment="Left" Text="Gestão de documentos e histórico" Style="{StaticResource PmvniSecondaryTextStyle}"/></StackPanel><TextBlock TextAlignment="Left" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Text, ElementName=TextoContagem}"/></Grid>


      <!-- Lista de processos. -->
      <Grid Grid.Row="1" Grid.Column="0" Style="{StaticResource PmvniPainelLateral}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="16,10,12,6" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource PmvniTonalTexto}" AutomationProperties.AccessibilityView="Raw"/><TextBlock TextAlignment="Left" Text="Processos" Style="{StaticResource PmvniTituloSecao}"/></StackPanel><TextBlock TextAlignment="Left" x:Name="TextoContagem" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" AutomationProperties.Name="Quantidade de processos"/>
            <Grid>
              <TextBox TextAlignment="Left" Style="{StaticResource PmvniCampoPesquisa}" x:Name="FiltroAcervo" x:FieldModifier="internal" PlaceholderText="Número ou nome do processo" AutomationProperties.Name="Filtrar processos"/>
              <FontIcon Glyph="&#xE721;" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
          </StackPanel>
          <ProgressRing x:Name="Anel" x:FieldModifier="internal" Grid.Column="1" IsActive="False" Width="18" Height="18"/>
        </Grid>
        <ListView x:Name="ListaProcessos" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" Padding="6,0,6,8"
                  PointerMoved="AoMoverSobreProcessos" PointerExited="AoSairDosProcessos"
                  PointerPressed="AoSairDosProcessos" KeyDown="AoUsarTecladoNosProcessos" AutomationProperties.Name="Processos">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:LinhaProcesso">
              <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Titulo}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Iniciais}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Left" Text="{x:Bind Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock TextAlignment="Left" Text="{x:Bind Detalhe}" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <!-- Lista vazia (M5): a tela vazia do módulo (ícone, título, frase e botões). A janela escreve o texto e a visibilidade em
             TextoListaVazia (guardado fora da tela); a frase e a visibilidade da tela vazia seguem esse texto. -->
        <local:EstadoVazio x:Name="Vazio" x:FieldModifier="internal" Grid.Row="1" Visibility="{Binding Visibility, ElementName=TextoListaVazia}"/>
        <Border Grid.Row="1" Visibility="Collapsed">
          <TextBlock TextAlignment="Left" x:Name="TextoListaVazia" x:FieldModifier="internal" Visibility="Collapsed"/>
        </Border>
      </Grid>

      <!-- Detalhe do processo escolhido. -->
      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" SizeChanged="AoDimensionarDetalhe" RowDefinitions="Auto,Auto" Padding="12,8" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" ColumnSpacing="10">
              <TextBlock TextAlignment="Left" x:Name="TextoTituloDetalhe" x:FieldModifier="internal" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Border x:Name="SeloProtocolo" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="Collapsed">
                <TextBlock TextAlignment="Center" x:Name="TextoProtocolo" Style="{StaticResource CaptionTextBlockStyle}"/>
              </Border>
            </Grid>
            <TextBlock TextAlignment="Left" x:Name="TextoPastaDetalhe" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" IsTextSelectionEnabled="True"
                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
          <!-- 2026-11-16: como os arquivos do processo aparecem (como "Classificar" e "Visualizar" do Explorador). A escolha fica
               lembrada nos Ajustes; a janela guarda (MainWindow.Pastas.cs). -->
          <local:PainelQuebra x:Name="BarraExibicao" x:FieldModifier="internal" Grid.Column="1" Espaco="6" VerticalAlignment="Bottom">
            <DropDownButton x:Name="BotaoClassificar" x:FieldModifier="internal" AutomationProperties.Name="Classificar"
                            local:Dicas.Descricao="Ordena os arquivos do processo por nome, data ou tipo, em ordem crescente ou decrescente.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="16" Height="16"><Path Canvas.Left="-12" Canvas.Top="-12" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M19.06,23.85 C19.2,23.99 19.27,24.17 19.27,24.36 C19.27,24.55 19.2,24.74 19.06,24.88 L16.15,27.79 C16.01,27.93 15.83,28 15.64,28 C15.45,28 15.26,27.93 15.12,27.79 L12.21,24.88 C11.93,24.6 11.93,24.13 12.21,23.85 C12.49,23.57 12.96,23.57 13.24,23.85 L14.91,25.52 L14.91,12.73 C14.91,12.33 15.24,12 15.64,12 C16.04,12 16.36,12.33 16.36,12.73 L16.36,25.52 L18.03,23.85 C18.17,23.71 18.36,23.64 18.55,23.64 C18.74,23.64 18.92,23.71 19.06,23.85 Z"/><Path Canvas.Left="-12" Canvas.Top="-12" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M24.88,12.21 L27.79,15.12 C28.07,15.4 28.07,15.87 27.79,16.15 C27.51,16.43 27.04,16.43 26.76,16.15 L25.09,14.48 L25.09,27.27 C25.09,27.67 24.76,28 24.36,28 C23.96,28 23.64,27.67 23.64,27.27 L23.64,14.48 L21.97,16.15 C21.69,16.43 21.22,16.43 20.94,16.15 C20.66,15.87 20.66,15.4 20.94,15.12 L23.85,12.21 C23.99,12.07 24.17,12 24.36,12 C24.55,12 24.74,12.07 24.88,12.21 Z"/></Canvas></Viewbox>
                <TextBlock Text="Classificar"/>
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <ToggleMenuFlyoutItem x:Name="ItemOrdemNome" x:FieldModifier="internal" Text="Nome" Click="AoEscolherOrdem"/>
                  <ToggleMenuFlyoutItem x:Name="ItemOrdemData" x:FieldModifier="internal" Text="Data" Click="AoEscolherOrdem"/>
                  <ToggleMenuFlyoutItem x:Name="ItemOrdemTipo" x:FieldModifier="internal" Text="Tipo" Click="AoEscolherOrdem"/>
                  <MenuFlyoutSeparator/>
                  <ToggleMenuFlyoutItem x:Name="ItemCrescente" x:FieldModifier="internal" Text="Crescente" Click="AoEscolherSentido"/>
                  <ToggleMenuFlyoutItem x:Name="ItemDecrescente" x:FieldModifier="internal" Text="Decrescente" Click="AoEscolherSentido"/>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="BotaoAgrupar" x:FieldModifier="internal" AutomationProperties.Name="Agrupar"
                            local:Dicas.Descricao="Junta os arquivos do processo por etapa ou pasta, por tipo de arquivo ou por data.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="16" Height="12.66"><Path Canvas.Left="-13.5" Canvas.Top="-13.67" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M17.5,14.67 C17.5,14.3 17.8,14 18.17,14 L28.83,14 C29.2,14 29.5,14.3 29.5,14.67 C29.5,15.04 29.2,15.33 28.83,15.33 L18.17,15.33 C17.8,15.33 17.5,15.04 17.5,14.67 Z"/><Path Canvas.Left="-13.5" Canvas.Top="-13.67" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M18.17,19.33 L28.83,19.33 C29.2,19.33 29.5,19.63 29.5,20 C29.5,20.37 29.2,20.67 28.83,20.67 L18.17,20.67 C17.8,20.67 17.5,20.37 17.5,20 C17.5,19.63 17.8,19.33 18.17,19.33 Z"/><Path Canvas.Left="-13.5" Canvas.Top="-13.67" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M18.17,24.67 L28.83,24.67 C29.2,24.67 29.5,24.96 29.5,25.33 C29.5,25.7 29.2,26 28.83,26 L18.17,26 C17.8,26 17.5,25.7 17.5,25.33 C17.5,24.96 17.8,24.67 18.17,24.67 Z"/><Path Canvas.Left="-13.5" Canvas.Top="-13.67" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M13.5,14.67 C13.5,14.12 13.95,13.67 14.5,13.67 C15.05,13.67 15.5,14.12 15.5,14.67 C15.5,15.22 15.05,15.67 14.5,15.67 C13.95,15.67 13.5,15.22 13.5,14.67 Z"/><Path Canvas.Left="-13.5" Canvas.Top="-13.67" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M13.5,20 C13.5,19.45 13.95,19 14.5,19 C15.05,19 15.5,19.45 15.5,20 C15.5,20.55 15.05,21 14.5,21 C13.95,21 13.5,20.55 13.5,20 Z"/><Path Canvas.Left="-13.5" Canvas.Top="-13.67" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M13.5,25.33 C13.5,24.78 13.95,24.33 14.5,24.33 C15.05,24.33 15.5,24.78 15.5,25.33 C15.5,25.88 15.05,26.33 14.5,26.33 C13.95,26.33 13.5,25.88 13.5,25.33 Z"/></Canvas></Viewbox>
                <TextBlock Text="Agrupar"/>
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoEtapa" x:FieldModifier="internal" Text="Etapa ou pasta" Click="AoEscolherGrupo"/>
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoTipo" x:FieldModifier="internal" Text="Tipo de arquivo" Click="AoEscolherGrupo"/>
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoData" x:FieldModifier="internal" Text="Data" Click="AoEscolherGrupo"/>
                  <MenuFlyoutSeparator/>
                  <ToggleMenuFlyoutItem x:Name="ItemGrupoNenhum" x:FieldModifier="internal" Text="Não agrupar" Click="AoEscolherGrupo"/>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton x:Name="BotaoVisualizar" x:FieldModifier="internal" AutomationProperties.Name="Visualizar"
                            local:Dicas.Descricao="Mostra os arquivos do processo em lista (três colunas) ou em miniaturas, com a prévia de cada arquivo.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="16" Height="16"><Path Canvas.Left="-15.5" Canvas.Top="-12" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M16.95,12 L21.32,12 C22.12,12 22.77,12.65 22.77,13.45 L22.77,17.82 C22.77,18.62 22.12,19.27 21.32,19.27 L16.95,19.27 C16.15,19.27 15.5,18.62 15.5,17.82 L15.5,13.45 C15.5,12.65 16.15,12 16.95,12 Z M21.32,17.82 L16.95,17.82 L16.95,13.45 L21.32,13.45 L21.32,17.82 Z"/><Path Canvas.Left="-15.5" Canvas.Top="-12" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M25.68,12 L30.05,12 C30.85,12 31.5,12.65 31.5,13.45 L31.5,17.82 C31.5,18.62 30.85,19.27 30.05,19.27 L25.68,19.27 C24.88,19.27 24.23,18.62 24.23,17.82 L24.23,13.45 C24.23,12.65 24.88,12 25.68,12 Z M30.05,17.82 L25.68,17.82 L25.68,13.45 L30.05,13.45 L30.05,17.82 Z"/><Path Canvas.Left="-15.5" Canvas.Top="-12" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M16.95,20.73 L21.32,20.73 C22.12,20.73 22.77,21.38 22.77,22.18 L22.77,26.55 C22.77,27.35 22.12,28 21.32,28 L16.95,28 C16.15,28 15.5,27.35 15.5,26.55 L15.5,22.18 C15.5,21.38 16.15,20.73 16.95,20.73 Z M21.32,26.55 L16.95,26.55 L16.95,22.18 L21.32,22.18 L21.32,26.55 Z"/><Path Canvas.Left="-15.5" Canvas.Top="-12" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M25.68,20.73 L30.05,20.73 C30.85,20.73 31.5,21.38 31.5,22.18 L31.5,26.55 C31.5,27.35 30.85,28 30.05,28 L25.68,28 C24.88,28 24.23,27.35 24.23,26.55 L24.23,22.18 C24.23,21.38 24.88,20.73 25.68,20.73 Z M30.05,26.55 L25.68,26.55 L25.68,22.18 L30.05,22.18 L30.05,26.55 Z"/></Canvas></Viewbox>
                <TextBlock Text="Visualizar"/>
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <ToggleMenuFlyoutItem x:Name="ItemModoLista" x:FieldModifier="internal" Text="Lista" Click="AoEscolherModo">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;"/></ToggleMenuFlyoutItem.Icon>
                  </ToggleMenuFlyoutItem>
                  <ToggleMenuFlyoutItem x:Name="ItemModoMiniaturas" x:FieldModifier="internal" Text="Miniaturas" Click="AoEscolherModo">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xECA5;"/></ToggleMenuFlyoutItem.Icon>
                  </ToggleMenuFlyoutItem>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </local:PainelQuebra>
        </Grid>
        <!-- Modo Lista (correções 2026-11-15): três colunas (Relatórios, Despachos, Projeto), cada uma agrupada e ordenada pela escolha
             de Agrupar e Classificar. A ListaDetalhe guarda a seleção (os comandos e o roteiro leem dela) e fica fora da tela; as colunas
             mostram as mesmas linhas. -->
        <Grid Grid.Row="1" x:Name="GradeColunas" x:FieldModifier="internal" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="8" Grid.Column="0">
            <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid ColumnDefinitions="*,Auto" Margin="6,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="4"><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="16.08" Height="19"><Path Canvas.Left="-0" Canvas.Top="-4.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F0 M10.75,4.71 L15.86,9.83 C16,9.97 16.08,10.16 16.08,10.35 L16.08,22.04 C16.08,22.85 15.43,23.5 14.62,23.5 L1.46,23.5 C0.65,23.5 0,22.85 0,22.04 L0,5.96 C0,5.15 0.65,4.5 1.46,4.5 L10.23,4.5 C10.42,4.5 10.61,4.57 10.75,4.71 Z M10.96,6.99 L13.58,9.62 L10.96,9.62 L10.96,6.99 Z M14.62,22.04 L1.46,22.04 L1.46,5.96 L9.5,5.96 L9.5,10.35 C9.5,10.75 9.83,11.08 10.23,11.08 L14.62,11.08 L14.62,22.04 Z"/><Path Canvas.Left="-0" Canvas.Top="-4.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M11.69,14.73 C11.69,15.13 11.36,15.46 10.96,15.46 L5.12,15.46 C4.72,15.46 4.39,15.13 4.39,14.73 C4.39,14.33 4.72,14 5.12,14 L10.96,14 C11.36,14 11.69,14.33 11.69,14.73 Z"/><Path Canvas.Left="-0" Canvas.Top="-4.5" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="F1 M11.69,17.65 C11.69,18.05 11.36,18.38 10.96,18.38 L5.12,18.38 C4.72,18.38 4.39,18.05 4.39,17.65 C4.39,17.25 4.72,16.92 5.12,16.92 L10.96,16.92 C11.36,16.92 11.69,17.25 11.69,17.65 Z"/></Canvas></Viewbox><TextBlock TextAlignment="Left" Grid.Column="1" Text="Relatórios" TextWrapping="Wrap" Style="{StaticResource PmvniTituloSecao}"/></Grid><TextBlock TextAlignment="Center" x:Name="TotalRelatorios" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/></Grid>
              <ListView x:Name="ColunaRelatorios" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" ItemTemplate="{StaticResource ModeloLinhaDetalhe}" AutomationProperties.Name="Relatórios"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource PmvniCartaoSecao}" Padding="8" Grid.Column="1">
            <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
