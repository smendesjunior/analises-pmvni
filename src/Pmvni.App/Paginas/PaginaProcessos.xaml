        <!-- Modo Miniaturas (2026-11-16): no lugar das três colunas, uma grade só, como o Explorador em "ícones grandes": todos os
             arquivos do processo com a prévia, em grupos que se recolhem pelo cabeçalho. A grade só cria os blocos que estão na tela. -->
        <Border x:Name="CartaoMiniaturas" x:FieldModifier="internal" Grid.Row="1" Style="{StaticResource PmvniCartaoSecao}" Padding="8" Margin="0"
                Visibility="Collapsed">
          <Grid>
            <GridView x:Name="GradeMiniaturas" x:FieldModifier="internal" SelectionMode="Single" IsItemClickEnabled="False" Padding="4,0,4,4"
                      IsSynchronizedWithCurrentItem="False"
                      ItemTemplate="{StaticResource ModeloMiniatura}" AutomationProperties.Name="Arquivos do processo em miniaturas">
              <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" AreStickyGroupHeadersEnabled="False"/>
                </ItemsPanelTemplate>
              </GridView.ItemsPanel>
              <GridView.GroupStyle>
                <GroupStyle HidesIfEmpty="False">
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate x:DataType="local:GrupoMiniaturas">
                      <Button Click="AoAlternarGrupo" Background="Transparent" BorderThickness="0" Padding="4,2"
                              AutomationProperties.Name="{x:Bind NomeAcessivel}" ToolTipService.ToolTip="{x:Bind Dica}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon Glyph="{x:Bind Glifo}" FontSize="10" VerticalAlignment="Center"/>
                          <TextBlock TextAlignment="Left" Text="{x:Bind Titulo}" FontSize="15" VerticalAlignment="Center"/>
                          <TextBlock TextAlignment="Left" Text="{x:Bind Contagem}" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </GridView.GroupStyle>
            </GridView>
            <TextBlock TextAlignment="Left" x:Name="TextoSemMiniaturas" x:FieldModifier="internal" Margin="12,8" Text="Nenhum arquivo neste processo."
                       Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ListView x:Name="ListaDetalhe" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" Padding="12,0,12,8" Opacity="0" IsHitTestVisible="False" Width="1" HorizontalAlignment="Left"
                  AutomationProperties.Name="Conteúdo do processo">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:LinhaDetalhe">
              <StackPanel Padding="0,5" Spacing="1" AutomationProperties.Name="{x:Bind NomeAcessivel}">
                <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind EhTitulo}" Margin="0,8,0,0"/>
                <TextBlock TextAlignment="Left" Text="{x:Bind Texto}" Visibility="{x:Bind NaoEhTitulo}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Texto}"/>
                <TextBlock TextAlignment="Left" Text="{x:Bind Info}" Style="{StaticResource PmvniSecondaryTextStyle}" Visibility="{x:Bind TemInfo}" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Info}"/>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <!-- Auditoria de interface (2026-11-17): a frase fica no meio da área, maior (antes, pequena no canto de uma área enorme). -->
        <TextBlock x:Name="TextoSemProcesso" x:FieldModifier="internal" Grid.Row="1" Margin="20,12" TextWrapping="Wrap" MaxWidth="440"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="16"
                   Text="Escolha um processo na lista." Style="{StaticResource PmvniSecondaryTextStyle}"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
