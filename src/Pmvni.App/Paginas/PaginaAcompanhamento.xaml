<UserControl x:Class="Pmvni.App.PaginaAcompanhamento"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Acompanhamento de processos (2026-11-17): a planilha padrão de tramitação (Ajustes › Pastas e fontes de dados) vira esta página: título,
       resumo por status com gráfico de pizza, ações, a tabela com todas as colunas da planilha e o painel do processo escolhido.
       Tudo o que muda aqui é gravado na planilha. Quem preenche e reage é a janela (MainWindow.Acompanhamento.cs). -->
  <Grid x:Name="RaizPagina" x:FieldModifier="internal" Padding="24,16,24,8" RowSpacing="12">
    <Grid.Resources>
      <!-- Fundo das colunas fixas (Nº e Processo) quando a tabela rola para o lado: segue o tema do app (lido daqui, nunca do Application). -->
      <!-- Colunas fixas ao rolar para o lado: três camadas que repetem as da tabela (fundo da página + cartão + faixa do título), para a
           parte fixa ter exatamente a mesma cor do resto (antes ficava um bloco mais escuro, 2026-11-17). A última coluna fixa ganha um
           traço à direita, que separa o que está parado do que rola. -->
      <Style x:Key="PmvniCelulaFixaStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"/>
      </Style>
      <Style x:Key="PmvniCelulaFixaBordaStyle" TargetType="Border" BasedOn="{StaticResource PmvniCelulaFixaStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
      </Style>
      <Style x:Key="PmvniCelulaFixaCartaoStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
      </Style>
      <Style x:Key="PmvniCelulaFixaTituloStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="180"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Título -->
    <Grid x:Name="Cabecalho" SizeChanged="AoDimensionarCabecalho" RowDefinitions="Auto,Auto" ColumnSpacing="12" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <!-- A aba da planilha (só aparece com mais de uma): escolhida pelo nome e lembrada, para reordenar as abas no Excel não trocar a aba. -->
      <local:PainelQuebra x:Name="Acoes" Grid.Column="2" Espaco="8" VerticalAlignment="Center">
      <DropDownButton x:Name="BotaoExportar" x:FieldModifier="internal" AutomationProperties.Name="Exportar">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Exportar}" FontSize="16"/><TextBlock Text="Exportar"/></StackPanel>
        <DropDownButton.Flyout>
          <MenuFlyout Placement="Bottom">
            <MenuFlyoutItem x:Name="MenuAbrirExcel" x:FieldModifier="internal" Visibility="Collapsed" Text="Abrir no Excel"><MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Abrir}" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutSeparator Visibility="{x:Bind MenuAbrirExcel.Visibility, Mode=OneWay}"/>
            <MenuFlyoutItem x:Name="MenuExportarCsv" x:FieldModifier="internal" Text="Exportar lista filtrada (CSV)…"><MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Exportar}" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuCopiarLista" x:FieldModifier="internal" Text="Copiar lista filtrada"><MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind local:Glifos.Copiar}" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton x:Name="BotaoFiltrar" x:FieldModifier="internal" AutomationProperties.Name="Filtrar">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Filtro}" FontSize="16"/><TextBlock x:Name="TextoFiltrar" x:FieldModifier="internal" Text="Filtrar"/></StackPanel>
        <DropDownButton.Flyout>
          <Flyout Placement="Bottom">
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="PainelFiltros" x:FieldModifier="internal" Spacing="4" MinWidth="260"/>
            </ScrollViewer>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <!-- Escolher as colunas da tabela (pedido do usuário, 2026-11-17); a lista é montada pelo código a cada leitura da planilha. -->
      <DropDownButton x:Name="BotaoColunas" x:FieldModifier="internal" AutomationProperties.Name="Colunas da tabela"
                      local:Dicas.Titulo="Colunas" local:Dicas.Descricao="Escolha as colunas que aparecem na tabela. Para mudar a largura, arraste a borda do título da coluna.">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Lista}" FontSize="16"/><TextBlock x:Name="TextoColunas" x:FieldModifier="internal" Text="Colunas"/></StackPanel>
        <DropDownButton.Flyout>
          <MenuFlyout x:Name="MenuColunas" x:FieldModifier="internal" Placement="Bottom"/>
        </DropDownButton.Flyout>
      </DropDownButton>
        <ComboBox x:Name="CaixaAba" x:FieldModifier="internal" VerticalAlignment="Center" MinWidth="140" Visibility="Collapsed"
                  AutomationProperties.Name="Aba da planilha" local:Dicas.Descricao="A aba da planilha que o app mostra e onde grava."/>
        <!-- Resumo recolhível (auditoria 2026-11-17): em telas baixas ele fica compacto sozinho, para a tabela nunca sumir. -->
        <Grid>
          <ToggleButton x:Name="BotaoResumo" x:FieldModifier="internal" IsChecked="True" AutomationProperties.Name="Resumo por status"
                      local:Dicas.Titulo="Resumo" local:Dicas.Descricao="Mostra ou esconde o resumo por status.">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Grafico}" FontSize="16"/><TextBlock Text="Resumo"/></StackPanel>
        </ToggleButton>
        </Grid>
      </local:PainelQuebra>
      <FontIcon Glyph="{x:Bind local:Glifos.Situacao}" Style="{StaticResource PmvniIconeTituloPagina}" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Acompanhamento de processos" Style="{StaticResource PmvniTituloPaginaStyle}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="TextoSubtitulo" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="Resumo" x:FieldModifier="internal" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <Grid Style="{StaticResource PmvniPainelLateral}" Padding="16,12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <FontIcon Glyph="{x:Bind local:Glifos.Grafico}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock TextAlignment="Center" Grid.Column="1" Text="Andamento dos processos" Style="{StaticResource PmvniTituloSecao}" AutomationProperties.HeadingLevel="Level2"/>
          <TextBlock Grid.Column="2" x:Name="TotalResumo" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}"/>
        </Grid>
        <Grid Grid.Row="1" x:Name="BarraAndamento" x:FieldModifier="internal" Height="10" CornerRadius="5" ColumnSpacing="2"/>
        <Grid Grid.Row="2" x:Name="CartoesStatus" x:FieldModifier="internal" ColumnSpacing="6" RowSpacing="6" SizeChanged="AoDimensionarCartoes"/>
      </Grid>
      <Grid Grid.Column="1" x:Name="CartaoAprovacao" x:FieldModifier="internal" Style="{StaticResource PmvniPainelLateral}" Padding="16,12" Width="270">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="{x:Bind local:Glifos.Conferir}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" AutomationProperties.AccessibilityView="Raw"/>
            <TextBlock TextAlignment="Center" Text="Status da aprovação" Style="{StaticResource PmvniTituloSecao}" AutomationProperties.HeadingLevel="Level2"/>
          </StackPanel>
          <StackPanel x:Name="BlocoAprovacao" x:FieldModifier="internal" Spacing="4"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Comandos que vivem na faixa (Novo processo, Escolher planilha) e a busca, que é a da barra de título: ficam fora da tela. -->
    <StackPanel Visibility="Collapsed">
      <Button x:Name="BotaoNovo" x:FieldModifier="internal" Visibility="Collapsed" AutomationProperties.Name="Novo processo"
              local:Dicas.Titulo="Novo processo" local:Dicas.Descricao="Acrescenta um processo novo na planilha.">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Adicionar}" FontSize="16"/><TextBlock Text="Novo processo"/></StackPanel>
      </Button>
      <Button x:Name="BotaoImportar" x:FieldModifier="internal" Visibility="Collapsed" AutomationProperties.Name="Importar planilha do Excel"
              local:Dicas.Titulo="Escolher planilha…" local:Dicas.Descricao="Escolhe uma planilha no modelo padrão e passa a usá-la.">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Importar}" FontSize="16"/><TextBlock Text="Escolher planilha…"/></StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="6">
      <Grid x:Name="BarraBusca" x:FieldModifier="internal" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="8,5" Style="{StaticResource PmvniPainelLateral}">
        <TextBox x:Name="CaixaBusca" x:FieldModifier="internal" Style="{StaticResource PmvniCampoPesquisa}" Background="Transparent" BorderThickness="0" PlaceholderText="Pesquisar processo, requerente ou local" AutomationProperties.Name="Pesquisar na planilha"/>
        <FontIcon Glyph="{x:Bind local:Glifos.Pesquisar}" FontSize="16" Style="{StaticResource PmvniIconeSecundarioStyle}" Margin="12,0" HorizontalAlignment="Left" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
        <DropDownButton Grid.Column="1" x:Name="StatusRapido" x:FieldModifier="internal" Content="Todos os status" AutomationProperties.Name="Filtrar por status" local:Dicas.Descricao="Filtra a tabela por um status da planilha.">
          <DropDownButton.Flyout><MenuFlyout x:Name="MenuStatusRapido" x:FieldModifier="internal"/></DropDownButton.Flyout>
        </DropDownButton>
        <DropDownButton Grid.Column="2" x:Name="Ordenacao" x:FieldModifier="internal" Content="Ordenar" AutomationProperties.Name="Ordenar processos" local:Dicas.Descricao="Escolhe a coluna usada para ordenar a tabela.">
          <DropDownButton.Flyout><MenuFlyout x:Name="MenuOrdenacao" x:FieldModifier="internal"/></DropDownButton.Flyout>
        </DropDownButton>
      </Grid>
      <InfoBar x:Name="AvisoPendentes" x:FieldModifier="internal" Severity="Error" IsClosable="False" IsOpen="False"/>
      <InfoBar x:Name="Aviso" x:FieldModifier="internal" IsClosable="True" IsOpen="False"/>
      <Border x:Name="Progresso" x:FieldModifier="internal" Visibility="Collapsed" CornerRadius="24" Padding="24,10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <ProgressRing IsActive="True" Width="20" Height="20" VerticalAlignment="Center" local:Trabalhando.Automatico="False"/>
          <TextBlock Text="Carregando…" VerticalAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Tabela e painel do processo -->
    <Grid x:Name="GradeTabela" x:FieldModifier="internal" Grid.Row="3" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ColunaPainel" x:FieldModifier="internal" Width="0"/></Grid.ColumnDefinitions>
      <Border CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}">
        <Grid>
          <ScrollViewer x:Name="RolagemTabela" x:FieldModifier="internal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Visible"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
            <Grid x:Name="Tabela" x:FieldModifier="internal" HorizontalAlignment="Left">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid x:Name="CabecalhoTabela" x:FieldModifier="internal" Padding="12,0" MinHeight="44" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
              <ListView x:Name="Lista" x:FieldModifier="internal" Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="Processos"
                        ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                  </Style>
                </ListView.ItemContainerStyle>
              </ListView>
            </Grid>
          </ScrollViewer>
          <!-- Planilha sem processos, ou nenhum com os filtros: a frase fica na área da tabela (antes só aparecia no rodapé). -->
          <StackPanel x:Name="SemResultado" x:FieldModifier="internal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,48,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TextoSemResultado" x:FieldModifier="internal" Style="{StaticResource PmvniSecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            <Button local:IconeDeAcao.Glifo="{x:Bind local:Glifos.Limpar}" x:Name="BotaoLimparFiltros" x:FieldModifier="internal" Content="Limpar filtros" HorizontalAlignment="Center" AutomationProperties.Name="Limpar filtros" local:Dicas.Descricao="Limpa a pesquisa e remove os filtros da tabela."/>
          </StackPanel>
          <StackPanel x:Name="Vazio" x:FieldModifier="internal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="480" Padding="16" Visibility="Collapsed">
            <ContentPresenter x:Name="IconeVazio" x:FieldModifier="internal" Width="64" Height="64" HorizontalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
              <FontIcon Glyph="{x:Bind local:Glifos.Situacao}" FontSize="64" Style="{StaticResource PmvniIconeSecundarioStyle}"/>
            </ContentPresenter>
            <TextBlock x:Name="TextoVazio" x:FieldModifier="internal" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource PmvniSecondaryTextStyle}"/>
            <StackPanel x:Name="AcoesVazio" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button x:Name="BotaoEscolherVazio" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False"
                      AutomationProperties.Name="Escolher planilha…" local:Dicas.Descricao="Escolhe a planilha de acompanhamento a abrir.">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Importar}" FontSize="16"/><TextBlock Text="Escolher planilha…"/></StackPanel>
              </Button>
              <Button x:Name="BotaoAjustesVazio" x:FieldModifier="internal" AutomationProperties.Name="Abrir Ajustes" local:Dicas.Descricao="Abre Ajustes › Pastas e fontes de dados no local da planilha.">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Gerenciar}" FontSize="16"/><TextBlock Text="Abrir Ajustes"/></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>

      <!-- Painel do processo escolhido -->
      <Border x:Name="Painel" x:FieldModifier="internal" Grid.Row="3" Width="340" HorizontalAlignment="Right" CornerRadius="8" Visibility="Collapsed"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <!-- Fundo opaco por baixo do cartão: sobreposto à tabela (janela estreita) nada vaza; as duas cores seguem o tema do app. -->
        <Grid Padding="18,14" RowSpacing="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TituloPainel" x:FieldModifier="internal" Style="{StaticResource PmvniAjusteTitulo}" AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <Button x:Name="BotaoFecharPainel" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource PmvniBarraButtonStyle}" Padding="0" Width="32" Height="32"
                    AutomationProperties.Name="Fechar o painel do processo" local:Dicas.Descricao="Fecha o painel do processo.">
              <FontIcon Glyph="{x:Bind local:Glifos.Fechar}" FontSize="16"/>
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CamposPainel" x:FieldModifier="internal" Spacing="0" Padding="0,0,8,0"/>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BotaoEditar" x:FieldModifier="internal" Style="{StaticResource PmvniBotaoPrimarioStyle}" local:Brilho.Ativo="False" AutomationProperties.Name="Editar processo"
                    local:Dicas.Descricao="Abre os dados do processo selecionado para edição.">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Editar}" FontSize="16"/><TextBlock Text="Editar processo…"/></StackPanel>
            </Button>
            <Button x:Name="BotaoAbrirPasta" x:FieldModifier="internal" AutomationProperties.Name="Abrir em Processos"
                    local:Dicas.Titulo="Abrir pasta" local:Dicas.Descricao="Abre a pasta do processo no Explorador.">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.AbrirPasta}" FontSize="16"/><TextBlock Text="Abrir pasta"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

    <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" x:Name="Rodape" x:FieldModifier="internal" Grid.Row="4" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis"/>
  </Grid>
</UserControl>
