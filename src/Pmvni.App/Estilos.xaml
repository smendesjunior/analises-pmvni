<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Estilos Fluent do app (trilho de navegação no mesmo padrão do app Gmail: indicador de seleção 3 x 16). -->
  <Style x:Key="PmvniSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- Indicador do item atual do trilho: 3 x 16, cantos arredondados, cor de destaque do sistema. -->
  <Style x:Key="PmvniRailIndicatorStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Width" Value="3"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="CornerRadius" Value="1.5"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Botão da barra: sem borda e sem fundo até o mouse passar (como os botões do trilho). -->
  <Style x:Key="PmvniBarraButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,5,10,6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Botão de módulo do trilho: 56 x 56, ícone em cima e rótulo embaixo, sem fundo até o mouse passar. -->
  <Style x:Key="PmvniTrilhoButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="58"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
</ResourceDictionary>
