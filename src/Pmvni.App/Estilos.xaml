<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Pmvni.App">
  <!-- Estilos Fluent do app. As cores próprias (ícones dos módulos, fundo do item ativo do trilho, botão tonal) ficam em
       Recursos\IconesModulos.xaml, com uma versão para o tema claro, o escuro e o alto contraste. -->

  <Style x:Key="PmvniSuperficieElevada" TargetType="FrameworkElement">
    <Setter Property="Shadow"><Setter.Value><ThemeShadow/></Setter.Value></Setter>
    <Setter Property="local:Elevacao.Altura" Value="8"/>
  </Style>

  <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- 3.2.0: conteúdo à esquerda, como nas caixas de seleção do Windows 11 (centralizado parecia botão e cortava textos longos). -->
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- Medidas comuns das páginas (painéis laterais e margens). -->
  <x:Double x:Key="PmvniLarguraPainel">300</x:Double>
  <!-- Lista de seções da revisão: mais larga para a etiqueta de situação caber ao lado do título (que quebra a linha). -->
  <x:Double x:Key="PmvniLarguraPainelSecoes">360</x:Double>
  <x:Double x:Key="PmvniLarguraPropriedades">320</x:Double>
  <Thickness x:Key="PmvniMargemPagina">24,16,24,16</Thickness>

  <Style x:Key="PmvniSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- Indicador do item atual (trilho e lista de seções): 3 x 16, cantos arredondados, cor de destaque do sistema. -->
  <Style x:Key="PmvniRailIndicatorStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Width" Value="3"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="CornerRadius" Value="1.5"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Botão da barra: sem borda e sem fundo até o mouse passar. -->
  <!-- "Trabalhando" (2026-11-17): todo anel ativo e toda barra indeterminada acendem o brilho arco-íris do WinStatusBar no quadro em
       volta (Controles/BrilhoArcoIris.cs). -->
  <Style TargetType="ProgressRing">
    <Setter Property="local:Trabalhando.Automatico" Value="True"/>
  </Style>
  <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
    <Setter Property="local:Trabalhando.Automatico" Value="True"/>
  </Style>

  <Style x:Key="PmvniBarraButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,5,10,6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PmvniGrupoCabecalho" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PmvniBotaoGrupoCabecalhoStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="12,0,14,1"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="PmvniDivisoriaGrupoCabecalho" TargetType="Border">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Margin" Value="0,7"/>
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniDivisoriaCabecalho" TargetType="Border">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniSeloGravacao" TargetType="Border">
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="9,4,12,5"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="PmvniSeloSucesso" TargetType="Border" BasedOn="{StaticResource PmvniSeloGravacao}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniSeloAtencao" TargetType="Border" BasedOn="{StaticResource PmvniSeloGravacao}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniSeloErro" TargetType="Border" BasedOn="{StaticResource PmvniSeloGravacao}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniSeloNeutro" TargetType="Border" BasedOn="{StaticResource PmvniSeloGravacao}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeAcao" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style x:Key="PmvniIconeAcaoSucesso" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeAcao}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeAcaoAtencao" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeAcao}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeAcaoCritico" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeAcao}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeAcaoSecundario" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeAcao}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeSeloBase" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeAcao}">
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="PmvniTextoSeloSucesso" TargetType="TextBlock" BasedOn="{StaticResource PmvniSecondaryTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
  </Style>

  <Style x:Key="PmvniIconeSeloSucesso" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeSeloBase}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeSeloAtencao" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeSeloBase}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeSeloErro" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeSeloBase}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
  </Style>
  <Style x:Key="PmvniIconeSeloNeutro" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeSeloBase}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>

  <!-- Etiqueta de situação da lista de seções (a "pill" do relatório): as cores vêm dos recursos de tema conforme a classe do kit; o
       modelo só desenha o fundo, a borda e um véu ao passar o mouse ou clicar. -->
  <Style x:Key="PmvniEtiquetaSituacaoStyle" TargetType="Button">
    <Setter Property="Padding" Value="7,2,9,3"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="FocusVisualMargin" Value="-2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Raiz" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters><Setter Target="Veu.Opacity" Value="1"/></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Veu.Opacity" Value="1"/>
                    <Setter Target="Veu.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled"/>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Veu" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}"/>
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PmvniEtiquetaSituacaoSucesso" TargetType="Button" BasedOn="{StaticResource PmvniEtiquetaSituacaoStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
    <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniEtiquetaSituacaoAtencao" TargetType="Button" BasedOn="{StaticResource PmvniEtiquetaSituacaoStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniEtiquetaSituacaoDivergente" TargetType="Button" BasedOn="{StaticResource PmvniEtiquetaSituacaoStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniEtiquetaSituacaoCritico" TargetType="Button" BasedOn="{StaticResource PmvniEtiquetaSituacaoStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
  </Style>

  <!-- Item do trilho de módulos (como o Gmail): 68 x 66, ícone colorido de 28 px sobre um fundo arredondado 56 x 36 que só aparece no módulo
       ativo (e ao passar o mouse), rótulo de 11 px embaixo. O botão em si nunca pinta fundo: quem muda é o Border "Fundo" (estilos
       PmvniTrilhoFundo*), trocado pelo Trilho conforme o estado. -->
  <Style x:Key="PmvniTrilhoItemStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="108"/>
    <Setter Property="MinHeight" Value="54"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FocusVisualMargin" Value="-2"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="PmvniTrilhoFundoInativoStyle" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- Item ativo como no NavigationView do WinUI 3: só o fundo suave, sem contorno (o indicador 3 x 16 marca a seleção). -->
  <Style x:Key="PmvniTrilhoFundoAtivoStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="PmvniTrilhoFundoSobreStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
  </Style>
  <Style x:Key="PmvniTrilhoFundoPressionadoStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
  </Style>
  <Style x:Key="PmvniTrilhoIconeStyle" TargetType="FontIcon" BasedOn="{StaticResource PmvniIconeAcao}">
    <Setter Property="FontSize" Value="20"/>
  </Style>
  <Style x:Key="PmvniTrilhoRotuloStyle" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="MaxLines" Value="2"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>
  <Style x:Key="PmvniTrilhoRotuloAtivoStyle" TargetType="TextBlock" BasedOn="{StaticResource PmvniTrilhoRotuloStyle}">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="PmvniBotaoPrimarioStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="local:Brilho.Ativo" Value="True"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="PmvniFaixaMenuPrimarioStyle" TargetType="DropDownButton">
    <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}"/>
    <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Botão primário tonal (como "Novo email"): verde claro do brasão, cantos 8, altura 36. As cores de "sobre" e "pressionado"
       vêm de PmvniCoresTonais (dicionário de recursos posto em volta do botão: ButtonBackgroundPointerOver etc.). -->
  <Style x:Key="PmvniBotaoTonalStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource PmvniTonalFundo}"/>
    <Setter Property="Foreground" Value="{ThemeResource PmvniTonalTexto}"/>
    <!-- Borda fina verde-clara em todos os botões que brilham (2026-11-17, "padronizar com a borda em volta"). -->
    <Setter Property="BorderBrush" Value="{ThemeResource PmvniTonalBorda}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="14,0,16,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <!-- Brilho verde em volta, como os botões do WinStatusBar (Controles\Brilho.cs). -->
    <Setter Property="local:Brilho.Ativo" Value="True"/>
  </Style>

  <!-- Cartões dos Ajustes (no padrão do WinStatusBar): grupo com fundo de cartão, borda e raio 8; linha = título + ajuda à esquerda e
       o controle numa coluna de 240 à direita (empilha abaixo de 540 px: LinhaAjuste). -->
  <Style x:Key="PmvniAjusteTituloPagina" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="PmvniAjusteAjuda" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="18"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>
  <Style x:Key="PmvniAjusteTitulo" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="PmvniAjusteGrupoTitulo" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,10,0,0"/>
  </Style>
  <Style x:Key="PmvniAjusteGrupo" TargetType="Border" BasedOn="{StaticResource PmvniSuperficieElevada}">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="PmvniAjusteDivisoria" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
  </Style>
  <Style x:Key="PmvniAjusteEscolha" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="PmvniAjusteAlternar" TargetType="ToggleSwitch">
    <Setter Property="OnContent" Value="Ativado"/>
    <Setter Property="OffContent" Value="Desativado"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <!-- Cartões de seção numerados (correções 2026-11-15, modelo NovoRelatorioPage.xaml): usados em Novo relatório, Novo despacho e Ajustes. -->
  <Style x:Key="PmvniCartaoSecao" TargetType="Border" BasedOn="{StaticResource PmvniSuperficieElevada}">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="24"/>
  </Style>
  <Style x:Key="PmvniTituloSecao" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PmvniSeloPasso" TargetType="Border">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Background" Value="{ThemeResource PmvniTonalFundo}"/>
  </Style>
  <Style x:Key="PmvniNumeroPasso" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource PmvniTonalTexto}"/>
  </Style>
  <Style x:Key="PmvniTextoAjuda" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>
  <!-- Painéis laterais em cartões (correções 2026-11-16): o painel Propriedades do relatório e, depois, o do Novo despacho. Cada seção é um
       cartão (PmvniPainelCartao) com cabeçalho marcado (PmvniPainelCartaoCabecalho: ícone + título em maiúsculas espaçadas) e corpo
       (PmvniPainelCartaoCorpo); dentro dele, cada valor leva em cima um rótulo pequeno em maiúsculas, na cor secundária (PmvniPainelRotulo), e
       os grupos se separam com PmvniPainelSeparador. Só recursos de tema: vale no claro, no escuro e no alto contraste. Em código, as mesmas
       peças saem de Controles\CartoesDePainel.cs. -->
  <Style x:Key="PmvniPainelCartao" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="PmvniPainelCartaoCabecalho" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="7,7,0,0"/>
    <Setter Property="Padding" Value="12,7,8,7"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style x:Key="PmvniPainelCartaoIcone" TargetType="FontIcon">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PmvniPainelCartaoTitulo" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CharacterSpacing" Value="40"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PmvniPainelCartaoCorpo" TargetType="StackPanel">
    <Setter Property="Padding" Value="12,10,12,12"/>
    <Setter Property="Spacing" Value="10"/>
  </Style>
  <Style x:Key="PmvniPainelRotulo" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CharacterSpacing" Value="60"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PmvniPainelValor" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="IsTextSelectionEnabled" Value="True"/>
  </Style>
  <Style x:Key="PmvniPainelValorForte" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="IsTextSelectionEnabled" Value="True"/>
  </Style>
  <Style x:Key="PmvniPainelSeparador" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    <Setter Property="Margin" Value="-12,2,-12,2"/>
  </Style>
  <!-- A marca pequena ao lado de um rótulo: "alterado", "novo". -->
  <Style x:Key="PmvniPainelMarca" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,0,6,1"/>
