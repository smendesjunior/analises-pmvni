<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ícones coloridos dos módulos (trilho e telas vazias), desenhados em XAML vetorial 24 x 24 (nada baixado), com a paleta do
       brasão da Prefeitura (azul celeste, verde, amarelo, rosa claro e marrom). Amarelo e rosa sempre com contorno marrom (no tema
       claro o amarelo puro some sobre o Mica). Alto contraste: tudo na cor do texto dos botões (o sistema exige ícone monocromático).
       O tamanho vem de quem usa (Viewbox sem tamanho): 22 x 22 no trilho, 48 x 48 nas telas vazias. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PmvniIconeAzul" Color="#1689D6"/>
      <SolidColorBrush x:Key="PmvniIconeAzulEscuro" Color="#0E5E96"/>
      <SolidColorBrush x:Key="PmvniIconeVerde" Color="#1E8E4E"/>
      <SolidColorBrush x:Key="PmvniIconeVerdeEscuro" Color="#14643A"/>
      <SolidColorBrush x:Key="PmvniIconeAmarelo" Color="#F2C230"/>
      <SolidColorBrush x:Key="PmvniIconeRosa" Color="#F7DCEB"/>
      <SolidColorBrush x:Key="PmvniIconeMarrom" Color="#7A5537"/>
      <SolidColorBrush x:Key="PmvniIconeMarromClaro" Color="#C9A27A"/>
      <SolidColorBrush x:Key="PmvniIconeFolha" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PmvniIconeAco" Color="#5E7389"/>
      <SolidColorBrush x:Key="PmvniIconeBranco" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PmvniTrilhoSelecionado" Color="#DDEAF5"/>
      <SolidColorBrush x:Key="PmvniTrilhoSelecionadoBorda" Color="Transparent"/>
      <SolidColorBrush x:Key="PmvniTonalFundo" Color="#D4EEDD"/>
      <SolidColorBrush x:Key="PmvniTonalTexto" Color="#0F5132"/>
      <SolidColorBrush x:Key="PmvniTonalFundoSobre" Color="#C3E6CF"/>
      <SolidColorBrush x:Key="PmvniTonalFundoPressionado" Color="#B2DDC1"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PmvniIconeAzul" Color="#5AB8F2"/>
      <SolidColorBrush x:Key="PmvniIconeAzulEscuro" Color="#3A93CC"/>
      <SolidColorBrush x:Key="PmvniIconeVerde" Color="#4CC27F"/>
      <SolidColorBrush x:Key="PmvniIconeVerdeEscuro" Color="#2E8B57"/>
      <SolidColorBrush x:Key="PmvniIconeAmarelo" Color="#F5CF55"/>
      <SolidColorBrush x:Key="PmvniIconeRosa" Color="#E8BCD6"/>
      <SolidColorBrush x:Key="PmvniIconeMarrom" Color="#C49A72"/>
      <SolidColorBrush x:Key="PmvniIconeMarromClaro" Color="#9C7A58"/>
      <SolidColorBrush x:Key="PmvniIconeFolha" Color="#E9EEF2"/>
      <SolidColorBrush x:Key="PmvniIconeAco" Color="#A9BCCF"/>
      <SolidColorBrush x:Key="PmvniIconeBranco" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PmvniTrilhoSelecionado" Color="#2C3B49"/>
      <SolidColorBrush x:Key="PmvniTrilhoSelecionadoBorda" Color="Transparent"/>
      <SolidColorBrush x:Key="PmvniTonalFundo" Color="#1F4D33"/>
      <SolidColorBrush x:Key="PmvniTonalTexto" Color="#CFEBD9"/>
      <SolidColorBrush x:Key="PmvniTonalFundoSobre" Color="#275E3F"/>
      <SolidColorBrush x:Key="PmvniTonalFundoPressionado" Color="#2F6E4B"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="PmvniIconeAzul" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeAzulEscuro" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeVerde" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeVerdeEscuro" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeAmarelo" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="PmvniIconeRosa" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="PmvniIconeMarrom" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeMarromClaro" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeFolha" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="PmvniIconeAco" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniIconeBranco" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <!-- Ativo em alto contraste (revisão I5): o fundo continua o dos botões (o ícone, na cor do texto dos botões, mantém o contraste do
           sistema) e o destaque é a borda na cor de seleção, além da barrinha. -->
      <SolidColorBrush x:Key="PmvniTrilhoSelecionado" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="PmvniTrilhoSelecionadoBorda" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="PmvniTonalFundo" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="PmvniTonalTexto" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="PmvniTonalFundoSobre" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="PmvniTonalFundoPressionado" Color="{ThemeResource SystemColorHighlightColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Relatórios: folha com canto dobrado, três linhas e selo verde com ✓ ("relatório conferido"). -->
  <DataTemplate x:Key="PmvniIconeRelatorios">
    <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
      <Path Data="M6.5,2 H14.5 L19,6.5 V20.5 A1.5,1.5 0 0 1 17.5,22 H6.5 A1.5,1.5 0 0 1 5,20.5 V3.5 A1.5,1.5 0 0 1 6.5,2 Z"
            Fill="{ThemeResource PmvniIconeFolha}" Stroke="{ThemeResource PmvniIconeAzulEscuro}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
      <Path Data="M14.5,2 V5.5 A1,1 0 0 0 15.5,6.5 H19" Stroke="{ThemeResource PmvniIconeAzulEscuro}" StrokeThickness="1.2"
            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Rectangle Canvas.Left="8" Canvas.Top="9.3" Width="8" Height="1.5" RadiusX=".75" RadiusY=".75" Fill="{ThemeResource PmvniIconeAzul}"/>
      <Rectangle Canvas.Left="8" Canvas.Top="12.3" Width="8" Height="1.5" RadiusX=".75" RadiusY=".75" Fill="{ThemeResource PmvniIconeAzul}"/>
      <Rectangle Canvas.Left="8" Canvas.Top="15.3" Width="4.5" Height="1.5" RadiusX=".75" RadiusY=".75" Fill="{ThemeResource PmvniIconeAzul}"/>
      <Ellipse Canvas.Left="12.2" Canvas.Top="12.7" Width="10.6" Height="10.6" Fill="{ThemeResource PmvniIconeFolha}"/>
      <Ellipse Canvas.Left="13" Canvas.Top="13.5" Width="9" Height="9" Fill="{ThemeResource PmvniIconeVerde}"/>
      <Path Data="M15.3,18.1 L16.8,19.6 L19.8,16.4" Stroke="{ThemeResource PmvniIconeBranco}" StrokeThickness="1.5"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Canvas></Viewbox>
  </DataTemplate>

  <!-- Despachos: folha com duas linhas, assinatura azul e carimbo amarelo com fitas ("documento assinado e carimbado"). -->
  <DataTemplate x:Key="PmvniIconeDespachos">
    <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
      <Path Data="M6.5,2 H14.5 L19,6.5 V20.5 A1.5,1.5 0 0 1 17.5,22 H6.5 A1.5,1.5 0 0 1 5,20.5 V3.5 A1.5,1.5 0 0 1 6.5,2 Z"
            Fill="{ThemeResource PmvniIconeFolha}" Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
      <Path Data="M14.5,2 V5.5 A1,1 0 0 0 15.5,6.5 H19" Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness="1.2"
            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Rectangle Canvas.Left="7.5" Canvas.Top="6.75" Width="5.5" Height="1.5" RadiusX=".75" RadiusY=".75" Fill="{ThemeResource PmvniIconeMarrom}"/>
      <Rectangle Canvas.Left="7.5" Canvas.Top="9.75" Width="8" Height="1.5" RadiusX=".75" RadiusY=".75" Fill="{ThemeResource PmvniIconeMarrom}"/>
      <Path Data="M7.5,15.5 C8.6,13.6 9.6,17.2 10.7,15.3 S12.8,14.4 13.6,15.8" Stroke="{ThemeResource PmvniIconeAzul}" StrokeThickness="1.2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      <Path Data="M15.1,20.9 L14.5,23.4 L16,22.6 L16.8,23.7 L17.2,21.6 Z" Fill="{ThemeResource PmvniIconeMarrom}"/>
      <Ellipse Canvas.Left="12.8" Canvas.Top="13.3" Width="8.4" Height="8.4" Fill="{ThemeResource PmvniIconeAmarelo}"
               Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness="1"/>
      <Ellipse Canvas.Left="15.3" Canvas.Top="15.8" Width="3.4" Height="3.4" Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness=".8"/>
    </Canvas></Viewbox>
  </DataTemplate>

  <!-- Processos: pasta caramelo com uma folha saindo, frente amarela e etiqueta verde. -->
  <DataTemplate x:Key="PmvniIconeProcessos">
    <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
      <Path Data="M2.5,6 A1.5,1.5 0 0 1 4,4.5 H9.2 L11.2,6.5 H20 A1.5,1.5 0 0 1 21.5,8 V18.5 A1.5,1.5 0 0 1 20,20 H4 A1.5,1.5 0 0 1 2.5,18.5 Z"
            Fill="{ThemeResource PmvniIconeMarromClaro}"/>
      <Rectangle Canvas.Left="5" Canvas.Top="7.2" Width="14" Height="6" Fill="{ThemeResource PmvniIconeFolha}"
                 Stroke="{ThemeResource PmvniIconeAzul}" StrokeThickness=".8"/>
      <Path Data="M2.5,11 A1.5,1.5 0 0 1 4,9.5 H20 A1.5,1.5 0 0 1 21.5,11 V18.5 A1.5,1.5 0 0 1 20,20 H4 A1.5,1.5 0 0 1 2.5,18.5 Z"
            Fill="{ThemeResource PmvniIconeAmarelo}" Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness="1" StrokeLineJoin="Round"/>
      <Rectangle Canvas.Left="9" Canvas.Top="13.6" Width="6" Height="2.2" RadiusX=".8" RadiusY=".8" Fill="{ThemeResource PmvniIconeVerde}"/>
    </Canvas></Viewbox>
  </DataTemplate>

  <!-- Legislação: livro de capa verde, páginas rosa e marcador amarelo. -->
  <DataTemplate x:Key="PmvniIconeLegislacao">
    <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
      <Rectangle Canvas.Left="7" Canvas.Top="4" Width="13" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource PmvniIconeRosa}"
                 Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness=".8"/>
      <Rectangle Canvas.Left="4.5" Canvas.Top="2.5" Width="13" Height="17.5" RadiusX="1.8" RadiusY="1.8" Fill="{ThemeResource PmvniIconeVerde}"
                 Stroke="{ThemeResource PmvniIconeVerdeEscuro}" StrokeThickness="1"/>
      <Rectangle Canvas.Left="6.2" Canvas.Top="2.5" Width="1.3" Height="17.5" Fill="{ThemeResource PmvniIconeVerdeEscuro}"/>
      <Rectangle Canvas.Left="9" Canvas.Top="6" Width="6.5" Height="2.6" RadiusX=".6" RadiusY=".6" Fill="{ThemeResource PmvniIconeFolha}"/>
      <Path Data="M12.8,17.5 V23 L14.4,21.6 L16,23 V17.5 Z" Fill="{ThemeResource PmvniIconeAmarelo}"
            Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness=".8" StrokeLineJoin="Round"/>
    </Canvas></Viewbox>
  </DataTemplate>

  <!-- Ajustes: engrenagem cinza-azulada (círculo + 8 dentes) com miolo amarelo (sem furo: o fundo do item muda de cor). -->
  <DataTemplate x:Key="PmvniIconeAjustes">
    <Viewbox Stretch="Uniform"><Canvas Width="24" Height="24">
      <Path Fill="{ThemeResource PmvniIconeAco}">
        <Path.Data>
          <GeometryGroup FillRule="Nonzero">
            <EllipseGeometry Center="12,12" RadiusX="6.6" RadiusY="6.6"/>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"/>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="45" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="90" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="135" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="180" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="225" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="270" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
            <RectangleGeometry Rect="10.4,2.6,3.2,4.2"><RectangleGeometry.Transform><RotateTransform Angle="315" CenterX="12" CenterY="12"/></RectangleGeometry.Transform></RectangleGeometry>
          </GeometryGroup>
        </Path.Data>
      </Path>
      <Ellipse Canvas.Left="9.3" Canvas.Top="9.3" Width="5.4" Height="5.4" Fill="{ThemeResource PmvniIconeAmarelo}"
               Stroke="{ThemeResource PmvniIconeMarrom}" StrokeThickness=".9"/>
    </Canvas></Viewbox>
  </DataTemplate>
</ResourceDictionary>
