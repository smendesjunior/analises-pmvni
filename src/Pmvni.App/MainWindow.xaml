<Window x:Class="Pmvni.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:media="using:Microsoft.UI.Xaml.Media"
  xmlns:local="using:Pmvni.App"
  Title="Análise de Projetos – PMVNI">
  <Window.SystemBackdrop>
    <media:MicaBackdrop/>
  </Window.SystemBackdrop>

  <!-- Shell: barra de título (ícone, título, estado de gravação), faixa de opções do módulo, trilho de módulos e as páginas. -->
  <Grid x:Name="Raiz" ColumnDefinitions="Auto,13,*,13">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SvgImageSource x:Key="ImagemCabecalhoPmvni" UriSource="ms-appx:///Recursos/cabecalho-pmvni.svg" RasterizePixelHeight="320"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Default">
            <SvgImageSource x:Key="ImagemCabecalhoPmvni" UriSource="ms-appx:///Recursos/cabecalho-pmvni-escuro.svg" RasterizePixelHeight="320"/>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="BarraTitulo" Grid.Row="0" Grid.ColumnSpan="4" Height="92" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MargemSistemaEsquerda" Width="0"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="MargemSistemaDireita" Width="0"/>
      </Grid.ColumnDefinitions>
      <!-- Cabeçalho (correções 2026-11-15, image15): brasão | "Análise de Projetos" | o processo aberto em duas linhas ("Proc. NNNN/AAAA"
           maior e em negrito; o requerente embaixo, menor) e o selo do estado de gravação ("Salvo 14:32" com o ✓). -->
        <StackPanel x:Name="CabecalhoEsquerdo" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="8,0,8,0" VerticalAlignment="Center">
          <Border x:Name="MarcaPrefeitura" Background="Transparent"
                  VerticalAlignment="Center" AutomationProperties.Name="Prefeitura Municipal de Venda Nova do Imigrante — Análise de Projetos">
            <Image Height="79.2" Stretch="Uniform" Source="{ThemeResource ImagemCabecalhoPmvni}"
                   AutomationProperties.AccessibilityView="Raw"/>
          </Border>
          <Border x:Name="DivisoriaProcesso" Style="{StaticResource PmvniDivisoriaCabecalho}" Visibility="Collapsed"/>
          <StackPanel x:Name="BlocoProcesso" VerticalAlignment="Center" Spacing="0" MaxWidth="300" Visibility="Collapsed">
            <TextBlock x:Name="TextoProcesso" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource PmvniAjusteTitulo}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock x:Name="TextoRequerente" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource PmvniSecondaryTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
          </StackPanel>
          <Border x:Name="SeloGravacao" Height="32" CornerRadius="16" Style="{StaticResource PmvniSeloSucesso}" Visibility="Collapsed" VerticalAlignment="Center"
                  AutomationProperties.Name="Estado de gravação">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <FontIcon x:Name="IconeGravacao" Glyph="{x:Bind local:Glifos.Concluido}" VerticalAlignment="Center" Style="{StaticResource PmvniIconeSeloSucesso}" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock x:Name="TextoGravacao" Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
        </StackPanel>
      <!-- Desfazer e Refazer (ícones) e a pesquisa (Ctrl+F; Enter = próxima, Shift+Enter = anterior, Esc limpa), com Anterior | Próxima
           rotulados (só os ícones em janelas estreitas; o nome fica na dica e no Narrador). -->
      <!-- Redesign do cabeçalho (2026-11-17, referência visual do usuário): identidade | estado da análise | Desfazer, Refazer | pesquisa |
           Anterior | Próxima, todos centrados na altura da barra, com 12 entre os grupos. Os segmentos habilitados ganham brilho ao passar o ponteiro. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
        <!-- Novo relatório (desenho §12.7): o estado da análise (em andamento, concluída, pausada, com erro; sem análise, some). Clicar abre a
             vista da execução (ou o resultado, quando ela já terminou). Texto principal e secundário (processo · tempo) com reticências. -->
        <!-- 3.3.0: a mesma pílula dos grupos do cabeçalho (raio 16, 32 px, hover recuado por dentro), com anel de 16 px e o texto numa linha
             só ("Analisando com o ChatGPT · 19486/2026 · 37 s"); antes eram duas linhas apertadas em 32 px. -->
        <Border x:Name="MolduraAnalise" Style="{StaticResource PmvniGrupoCabecalho}" Visibility="Collapsed">
        <Button x:Name="BotaoAnalise" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" Visibility="Collapsed"
                AutomationProperties.Name="Análise em andamento" ToolTipService.ToolTip="Abrir a vista da análise em andamento"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <ProgressRing x:Name="AnelAnalise" local:Trabalhando.Automatico="False" IsActive="False" Width="16" Height="16" MinWidth="0" MinHeight="0"
                            AutomationProperties.AccessibilityView="Raw"/>
              <FontIcon x:Name="IconeAnaliseConcluida" Glyph="{x:Bind local:Glifos.Concluido}" FontSize="16" Visibility="Collapsed" Style="{StaticResource PmvniIconeAcaoSucesso}" AutomationProperties.AccessibilityView="Raw"/>
              <FontIcon x:Name="IconeAnalisePausada" Glyph="{x:Bind local:Glifos.Pausado}" FontSize="16" Visibility="Collapsed" Style="{StaticResource PmvniIconeAcaoAtencao}" AutomationProperties.AccessibilityView="Raw"/>
              <FontIcon x:Name="IconeAnaliseErro" Glyph="{x:Bind local:Glifos.Erro}" FontSize="16" Visibility="Collapsed" Style="{StaticResource PmvniIconeAcaoCritico}" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
            <StackPanel x:Name="TextosAnalise" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MaxWidth="340">
              <TextBlock x:Name="TextoBotaoAnalise" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxLines="1"/>
              <TextBlock x:Name="DetalheBotaoAnalise" Style="{StaticResource PmvniSecondaryTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
          </StackPanel>
        </Button>
        </Border>
        <!-- 1.0.0: Desfazer | Refazer numa pílula segmentada só (uma moldura, cantos totalmente redondos, divisória central), como a
             pesquisa; só ícones Fluent, o nome e o atalho ficam na dica e no Narrador. -->
        <Grid RowDefinitions="20,32,20" VerticalAlignment="Center"><TextBlock Text="Navegação" TextWrapping="NoWrap" Style="{StaticResource PmvniPainelRotulo}"/>
        <Border Grid.Row="1" x:Name="GrupoOcorrencias" Style="{StaticResource PmvniGrupoCabecalho}">
          <Border.Resources><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/></Border.Resources>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BotaoPesquisaAnterior" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False"
                    AutomationProperties.Name="Página anterior">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind local:Glifos.Voltar}" Style="{StaticResource PmvniIconeAcao}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RotuloAnterior" Text="Anterior" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Border Style="{StaticResource PmvniDivisoriaGrupoCabecalho}"/>
            <Button x:Name="BotaoPesquisaProxima" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False"
                    AutomationProperties.Name="Próxima página">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="RotuloProximo" Text="Próxima" VerticalAlignment="Center"/>
                <FontIcon Glyph="{x:Bind local:Glifos.Avancar}" Style="{StaticResource PmvniIconeAcao}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </Grid>
        <Grid RowDefinitions="20,32,20" VerticalAlignment="Center"><TextBlock Text="Pesquisa global" TextWrapping="NoWrap" Style="{StaticResource PmvniPainelRotulo}"/>
        <Grid Grid.Row="1" x:Name="MolduraPesquisa" Width="340" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <!-- Pesquisa geral (2026-11-17): além do módulo à vista, acha ajustes, funções, arquivos e leis (lista abaixo da caixa). TextBox nativo
               em pílula: a borda de foco é a do tema (cor de destaque do Windows). -->
          <TextBox x:Name="CaixaPesquisa" TextAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Height="30" MinHeight="30" CornerRadius="16" Padding="36,3,8,3" VerticalAlignment="Center"
                   PlaceholderText="Pesquisar arquivos, funções, leis e configurações..." AutomationProperties.Name="Pesquisar no app"
                   ToolTipService.ToolTip="Pesquisar no app (Ctrl+K)">
            <TextBox.Resources>
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            </TextBox.Resources>
          </TextBox>
          <TextBlock TextAlignment="Center" x:Name="AtalhoPesquisa" Grid.Column="1" Text="Ctrl + K" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Style="{StaticResource PmvniSecondaryTextStyle}"/>
          <FontIcon x:Name="IconePesquisa" Glyph="{x:Bind local:Glifos.Pesquisar}" Style="{StaticResource PmvniIconeAcaoSecundario}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <TextBlock ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Grid.Row="2" x:Name="TextoPesquisa" TextTrimming="CharacterEllipsis" MaxLines="1" Width="{Binding Width, ElementName=MolduraPesquisa}" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"
                   Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.Name="Resultado da pesquisa"/>
        </Grid>
        <Grid RowDefinitions="20,32,20" VerticalAlignment="Center"><TextBlock Text="Edição" TextWrapping="NoWrap" Style="{StaticResource PmvniPainelRotulo}"/>
        <Border Grid.Row="1" x:Name="GrupoHistorico" Style="{StaticResource PmvniGrupoCabecalho}">
          <Border.Resources><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/></Border.Resources>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BotaoDesfazer" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False"
                    AutomationProperties.Name="Desfazer">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Desfazer}" Style="{StaticResource PmvniIconeAcao}"/><TextBlock x:Name="RotuloDesfazer" Text="Desfazer"/></StackPanel>
            </Button>
            <Border Style="{StaticResource PmvniDivisoriaGrupoCabecalho}"/>
            <Button x:Name="BotaoRefazer" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False"
                    AutomationProperties.Name="Refazer">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind local:Glifos.Refazer}" Style="{StaticResource PmvniIconeAcao}"/><TextBlock x:Name="RotuloRefazer" Text="Refazer"/></StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </Grid>
      </StackPanel>
    </Grid>

    <Border x:Name="MolduraBarras" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="3"
            Margin="5,0,5,5" CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" IsHitTestVisible="False"/>
    <local:FaixaDeOpcoes x:Name="Faixa" Grid.Row="1" Grid.Column="2"/>

    <local:Trilho x:Name="TrilhoModulos" Grid.Row="2" Grid.Column="0"/>
    <!-- Páginas dos módulos: criadas uma vez e trocadas por Visibility (o WebView2 nunca é recriado). -->
    <Grid x:Name="AreaPaginas" Grid.Row="2" Grid.Column="2" Margin="0,0,0,13">
      <local:PaginaRelatorios x:Name="Relatorios"/>
      <local:PaginaNovoRelatorio x:Name="PaginaDeNovoRelatorio" Visibility="Collapsed"/>
      <local:PaginaDespachos x:Name="PaginaDeDespachos" Visibility="Collapsed"/>
      <local:PaginaNovoDespacho x:Name="PaginaDeNovoDespacho" Visibility="Collapsed"/>
      <local:PaginaProcessos x:Name="PaginaDeProcessos" Visibility="Collapsed"/>
      <local:PaginaLegislacao x:Name="PaginaDeLegislacao" Visibility="Collapsed"/>
      <local:PaginaAjustes x:Name="PaginaDeAjustes" Visibility="Collapsed"/>
      <local:PaginaSites x:Name="PaginaDeSites" Visibility="Collapsed"/>
      <local:PaginaImoveis x:Name="PaginaDeImoveis" Visibility="Collapsed"/>
      <local:PaginaAcompanhamento x:Name="PaginaDeAcompanhamento" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
