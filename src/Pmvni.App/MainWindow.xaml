<Window x:Class="Pmvni.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:media="using:Microsoft.UI.Xaml.Media"
  xmlns:local="using:Pmvni.App"
  Title="Análise de Projetos – PMVNI">
  <Window.SystemBackdrop>
    <media:MicaBackdrop/>
  </Window.SystemBackdrop>

  <!-- Shell: barra de título (ícone, título, estado de gravação), faixa de opções do módulo, trilho de módulos e as páginas. -->
  <Grid x:Name="Raiz" ColumnDefinitions="Auto,*">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="BarraTitulo" Grid.Row="0" Grid.ColumnSpan="2" Height="64" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MargemSistemaEsquerda" Width="0"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="MargemSistemaDireita" Width="0"/>
      </Grid.ColumnDefinitions>
      <!-- Cabeçalho (correções 2026-11-15, image15): brasão | "Análise de Projetos" | o processo aberto em duas linhas ("Proc. NNNN/AAAA"
           maior e em negrito; o requerente embaixo, menor) e o selo do estado de gravação ("Salvo 14:32" com o ✓). -->
        <StackPanel x:Name="CabecalhoEsquerdo" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="14,0,18,0" VerticalAlignment="Center">
          <!-- Marca da Prefeitura (2026-11-16): o brasão redesenhado em vetor (formas do brasao.png do modelo oficial) e o texto como texto,
               legível em qualquer escala; a cor do texto segue o tema. Revisão do cabeçalho (2026-11-16): a tela do desenho passou a ser
               exatamente a caixa do brasão (antes sobrava tela e uma margem negativa o empurrava para cima e para a esquerda), e o
               brasão e o texto ficam centrados na altura da barra, no mesmo tamanho de antes. -->
          <StackPanel x:Name="MarcaPrefeitura" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                      AutomationProperties.Name="Prefeitura Municipal de Venda Nova do Imigrante">
            <Viewbox Height="40" VerticalAlignment="Center" Stretch="Uniform">
              <Canvas Width="600" Height="480">
                <Canvas.RenderTransform><TranslateTransform X="-44" Y="-70"/></Canvas.RenderTransform>
                <Line X1="72" Y1="105" X2="252" Y2="192" Stroke="#A68B6A" StrokeThickness="7"/>
                <Line X1="616" Y1="105" X2="438" Y2="192" Stroke="#A68B6A" StrokeThickness="7"/>
                <Ellipse Canvas.Left="62" Canvas.Top="95" Width="20" Height="20" Fill="#A68B6A"/>
                <Ellipse Canvas.Left="606" Canvas.Top="95" Width="20" Height="20" Fill="#A68B6A"/>
                <Path Fill="#13A54A" Data="M120,130 L158,148 Q125,230 135,300 L100,335 L48,322 Q100,250 120,130 Z"/>
                <Path Fill="#FFE600" Data="M158,148 L198,168 Q170,250 185,300 L150,358 L100,335 Q130,250 158,148 Z"/>
                <Path Fill="#F9D5E3" Data="M492,168 L532,148 Q560,250 590,345 L540,360 Q510,300 520,250 Q505,200 492,168 Z"/>
                <Path Fill="#19AEEF" Data="M532,148 L572,130 Q585,250 640,322 L590,345 Q560,250 532,148 Z"/>
                <Path Fill="#19AEEF" Data="M250,190 Q345,140 440,190 L432,305 Q420,362 345,398 Q270,362 258,305 Z"/>
                <Path Fill="#FFE600" Data="M345,292 L128,254 L137,220 Z M345,292 L154,182 L174,154 Z M345,292 L204,123 L232,103 Z M345,292 L270,85 L303,76 Z M345,292 L345,72 L379,75 Z M345,292 L420,85 L452,100 Z M345,292 L486,123 L511,148 Z M345,292 L536,182 L550,213 Z M345,292 L562,254 L565,288 Z">
                  <Path.Clip><RectangleGeometry Rect="250,140,190,180"/></Path.Clip>
                </Path>
                <Ellipse Canvas.Left="315" Canvas.Top="262" Width="60" Height="60" Fill="#FFE600"/>
                <Path Fill="#A68B6A" Data="M256,318 Q290,282 322,298 Q345,268 372,292 Q405,280 434,318 Q420,365 345,398 Q270,365 256,318 Z"/>
                <Rectangle Canvas.Left="339" Canvas.Top="116" Width="11" Height="48" Fill="#3A2E2A"/>
                <Rectangle Canvas.Left="327" Canvas.Top="128" Width="35" Height="9" Fill="#3A2E2A"/>
                <Path Fill="White" Stroke="#2B2B2B" StrokeThickness="5"
                      Data="M100,385 Q160,360 232,436 L182,452 Q160,410 125,440 Q95,440 100,385 Z M590,385 Q530,360 458,436 L508,452 Q530,410 565,440 Q595,440 590,385 Z M182,452 Q345,492 508,452 L505,510 Q345,548 185,510 Z"/>
              </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Center" Spacing="0">
              <TextBlock Text="Prefeitura Municipal de" FontFamily="Bahnschrift" FontSize="9" LineHeight="10" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
              <TextBlock Text="VENDA NOVA" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="15" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
              <TextBlock Text="DO IMIGRANTE" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="15" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
              <TextBlock Text="Estado do Espírito Santo" FontFamily="Bahnschrift" FontSize="9" LineHeight="10" LineStackingStrategy="BlockLineHeight" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
          </StackPanel>
          <Border x:Name="DivisoriaMarca" Style="{StaticResource PmvniDivisoriaCabecalho}"/>
          <TextBlock x:Name="TextoMarca" Text="Análise de Projetos" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
          <Border x:Name="DivisoriaProcesso" Style="{StaticResource PmvniDivisoriaCabecalho}" Visibility="Collapsed"/>
          <StackPanel x:Name="BlocoProcesso" VerticalAlignment="Center" Spacing="0" MaxWidth="300" Visibility="Collapsed">
            <TextBlock x:Name="TextoProcesso" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock x:Name="TextoRequerente" FontSize="12" FontWeight="Normal" TextTrimming="CharacterEllipsis" MaxLines="1"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <Border x:Name="SeloGravacao" Style="{StaticResource PmvniSeloSucesso}" Visibility="Collapsed" VerticalAlignment="Center"
                  AutomationProperties.Name="Estado de gravação">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon x:Name="IconeGravacao" Glyph="&#xE930;" FontSize="14" VerticalAlignment="Center" Style="{StaticResource PmvniIconeSeloSucesso}"/>
              <TextBlock x:Name="TextoGravacao" VerticalAlignment="Center" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
        </StackPanel>
      <!-- Desfazer e Refazer (ícones) e a pesquisa (Ctrl+F; Enter = próxima, Shift+Enter = anterior, Esc limpa), com Anterior | Próxima
           rotulados (só os ícones em janelas estreitas; o nome fica na dica e no Narrador). -->
      <!-- Redesign do cabeçalho (2026-11-17, referência visual do usuário): identidade | estado da análise | Desfazer, Refazer | pesquisa |
           Anterior | Próxima, todos centrados na altura da barra, com 12 entre os grupos. Os segmentos habilitados ganham brilho ao passar o ponteiro. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
        <!-- Novo relatório (desenho §12.7): o estado da análise (em andamento, concluída, pausada, com erro; sem análise, some). Clicar abre a
             vista da execução (ou o resultado, quando ela já terminou). Texto principal e secundário (processo · tempo) com reticências. -->
        <Border x:Name="MolduraAnalise" CornerRadius="21" VerticalAlignment="Center" Visibility="Collapsed"
                Background="{ThemeResource ControlFillColorDefaultBrush}">
        <Grid>
        <Button x:Name="BotaoAnalise" Style="{StaticResource PmvniBarraButtonStyle}" Visibility="Collapsed"
                AutomationProperties.Name="Análise em andamento" ToolTipService.ToolTip="Abrir a vista da análise em andamento"
                Height="42" CornerRadius="21" Padding="12,0,18,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Grid Width="24" Height="24" VerticalAlignment="Center">
              <ProgressRing x:Name="AnelAnalise" IsActive="False" Width="22" Height="22" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            AutomationProperties.AccessibilityView="Raw"/>
              <FontIcon x:Name="IconeAnaliseConcluida" Glyph="&#xE930;" FontSize="18" Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw"/>
              <FontIcon x:Name="IconeAnalisePausada" Glyph="&#xE769;" FontSize="16" Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw"/>
              <FontIcon x:Name="IconeAnaliseErro" Glyph="&#xEA39;" FontSize="18" Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
            <StackPanel x:Name="TextosAnalise" VerticalAlignment="Center" MaxWidth="260">
              <TextBlock x:Name="TextoBotaoAnalise" FontWeight="SemiBold" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                         TextTrimming="CharacterEllipsis" MaxLines="1"/>
              <TextBlock x:Name="DetalheBotaoAnalise" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
          </StackPanel>
        </Button>
        <!-- Borda discreta do tema; em andamento, o contorno na cor de destaque do Windows no lugar dela (nenhuma recebe clique). -->
        <Border x:Name="BordaAnalise" CornerRadius="21" BorderThickness="1" IsHitTestVisible="False"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        </Grid>
        </Border>
        <!-- 1.0.0: Desfazer | Refazer numa pílula segmentada só (uma moldura, cantos totalmente redondos, divisória central), como a
             pesquisa; só ícones Fluent, o nome e o atalho ficam na dica e no Narrador. -->
        <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="NAVEGAÇÃO" Style="{StaticResource PmvniPainelRotulo}"/>
        <Border x:Name="GrupoOcorrencias" Style="{StaticResource PmvniGrupoCabecalho}">
          <Border.Resources><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/></Border.Resources>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BotaoPesquisaAnterior" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False" CornerRadius="17,0,0,17"
                    AutomationProperties.Name="Ocorrência anterior" ToolTipService.ToolTip="Ocorrência anterior (Shift+Enter)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE76B;" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="RotuloAnterior" Text="Anterior" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Border Style="{StaticResource PmvniDivisoriaGrupoCabecalho}"/>
            <Button x:Name="BotaoPesquisaProxima" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False" CornerRadius="0,17,17,0"
                    Padding="14,0,16,1" AutomationProperties.Name="Próxima ocorrência" ToolTipService.ToolTip="Próxima ocorrência (Enter)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="RotuloProximo" Text="Próxima" VerticalAlignment="Center"/>
                <FontIcon Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </StackPanel>
        <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="PESQUISA GLOBAL" Style="{StaticResource PmvniPainelRotulo}"/>
        <Grid x:Name="MolduraPesquisa" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
          <!-- Pesquisa geral (2026-11-17): além do módulo à vista, acha ajustes, funções, arquivos e leis (lista abaixo da caixa). TextBox nativo
               em pílula: a borda de foco é a do tema (cor de destaque do Windows). -->
          <TextBox x:Name="CaixaPesquisa" Background="Transparent" BorderThickness="0" Width="340" Height="30" MinHeight="30" CornerRadius="16" Padding="32,3,58,3" VerticalAlignment="Center"
                   PlaceholderText="Pesquisar arquivos, funções, leis e configurações..." AutomationProperties.Name="Pesquisar no app"
                   ToolTipService.ToolTip="Pesquisar no app (Ctrl+F)">
            <TextBox.Resources>
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            </TextBox.Resources>
          </TextBox>
          <TextBlock TextAlignment="Center" x:Name="AtalhoPesquisa" Text="Ctrl + K" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
          <FontIcon x:Name="IconePesquisa" Glyph="&#xE721;" FontSize="15" Margin="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <TextBlock x:Name="TextoPesquisa" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"
                   Style="{StaticResource PmvniSecondaryTextStyle}" AutomationProperties.Name="Resultado da pesquisa"/>
        </StackPanel>
        <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="EDIÇÃO" Style="{StaticResource PmvniPainelRotulo}"/>
        <Border x:Name="GrupoHistorico" Style="{StaticResource PmvniGrupoCabecalho}">
          <Border.Resources><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/></Border.Resources>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BotaoDesfazer" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False" CornerRadius="17,0,0,17"
                    Padding="10,0" AutomationProperties.Name="Desfazer" ToolTipService.ToolTip="Desfazer (Ctrl+Z)">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A7;" FontSize="16"/><TextBlock x:Name="RotuloDesfazer" Text="Desfazer"/></StackPanel>
            </Button>
            <Border Style="{StaticResource PmvniDivisoriaGrupoCabecalho}"/>
            <Button x:Name="BotaoRefazer" Style="{StaticResource PmvniBotaoGrupoCabecalhoStyle}" IsEnabled="False" CornerRadius="0,17,17,0"
                    Padding="10,0" AutomationProperties.Name="Refazer" ToolTipService.ToolTip="Refazer (Ctrl+Y)">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A6;" FontSize="16"/><TextBlock x:Name="RotuloRefazer" Text="Refazer"/></StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </StackPanel>
      </StackPanel>
    </Grid>

    <local:FaixaDeOpcoes x:Name="Faixa" Grid.Row="1" Grid.Column="1"/>

    <local:Trilho x:Name="TrilhoModulos" Grid.Row="2" Grid.Column="0"/>
    <!-- Páginas dos módulos: criadas uma vez e trocadas por Visibility (o WebView2 nunca é recriado). -->
    <Grid x:Name="AreaPaginas" Grid.Row="2" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
      <local:PaginaRelatorios x:Name="Relatorios"/>
      <local:PaginaNovoRelatorio x:Name="PaginaDeNovoRelatorio" Visibility="Collapsed"/>
      <local:PaginaDespachos x:Name="PaginaDeDespachos" Visibility="Collapsed"/>
      <local:PaginaNovoDespacho x:Name="PaginaDeNovoDespacho" Visibility="Collapsed"/>
      <local:PaginaProcessos x:Name="PaginaDeProcessos" Visibility="Collapsed"/>
      <local:PaginaLegislacao x:Name="PaginaDeLegislacao" Visibility="Collapsed"/>
      <local:PaginaAjustes x:Name="PaginaDeAjustes" Visibility="Collapsed"/>
      <local:PaginaSites x:Name="PaginaDeSites" Visibility="Collapsed"/>
      <local:PaginaImoveis x:Name="PaginaDeImoveis" Visibility="Collapsed"/>
      <local:PaginaAcompanhamento x:Name="PaginaDeAcompanhamento" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
