<Window x:Class="Pmvni.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Microsoft.UI.Xaml.Controls"
  xmlns:media="using:Microsoft.UI.Xaml.Media"
  xmlns:local="using:Pmvni.App"
  Title="Editor de Relatórios PMVNI">
  <Window.SystemBackdrop>
    <media:MicaBackdrop/>
  </Window.SystemBackdrop>

  <Grid x:Name="Raiz">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Barra de título própria: painel, "Processo nº — Requerente", estado, Abrir e Exportar PDF. -->
    <Grid x:Name="BarraTitulo" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="ReservaBotoesDaJanela" Width="150"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BotaoPainel" Grid.Column="0" Style="{StaticResource PmvniBarraButtonStyle}" Margin="8,0,0,0"
              Click="AoAlternarPainel" AutomationProperties.Name="Mostrar ou ocultar a lista de seções"
              ToolTipService.ToolTip="Seções e itens">
        <FontIcon Glyph="&#xE700;" FontSize="16"/>
      </Button>
      <Grid x:Name="ZonaDeArrasto" Grid.Column="1" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock x:Name="TextoTitulo" Text="Editor de Relatórios Técnicos — PMVNI" Style="{StaticResource BodyStrongTextBlockStyle}"
                     TextTrimming="CharacterEllipsis" MaxWidth="640"/>
          <TextBlock x:Name="TextoEstado" Text="" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Button x:Name="BotaoAbrir" Grid.Column="2" Style="{StaticResource PmvniBarraButtonStyle}" Click="AoAbrir"
              AutomationProperties.Name="Abrir relatório">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
          <TextBlock Text="Abrir"/>
        </StackPanel>
      </Button>
      <!-- A dica fica no invólucro: um botão desabilitado não mostra a própria. -->
      <Grid x:Name="InvolucroExportar" Grid.Column="3" Margin="2,0,8,0" Background="Transparent">
        <Button x:Name="BotaoExportar" Style="{StaticResource PmvniBarraButtonStyle}" Click="AoExportar" IsEnabled="False"
                AutomationProperties.Name="Exportar PDF">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
            <TextBlock Text="Exportar PDF"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>

    <!-- Avisos (InfoBar): largura, blocos que não cabem, conteúdo além da borda da área e resultado da exportação. -->
    <StackPanel x:Name="Avisos" Grid.Row="1" Spacing="1">
      <InfoBar x:Name="AvisoLargura" Severity="Informational" IsOpen="False" IsClosable="True"/>
      <InfoBar x:Name="AvisoEstouro" Severity="Error" IsOpen="False" IsClosable="False"/>
      <InfoBar x:Name="AvisoForaDaArea" Severity="Informational" IsOpen="False" IsClosable="True"/>
      <InfoBar x:Name="AvisoMensagem" Severity="Informational" IsOpen="False" IsClosable="True"/>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Esquerda: seções e itens (recolhível). -->
      <Grid x:Name="PainelNavegacao" Grid.Column="0" Width="292" Padding="0,4,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="SEÇÕES E ITENS" Style="{StaticResource PmvniSecondaryTextStyle}" Margin="18,8,12,6"/>
        <ListView x:Name="ListaNavegacao" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AoClicarItem"
                  Padding="6,0,6,8" AutomationProperties.Name="Seções e itens do relatório">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="MinHeight" Value="30"/>
              <Setter Property="Padding" Value="6,0,6,0"/>
              <Setter Property="Margin" Value="0,1,0,1"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:ItemNavegacao">
              <Grid MinHeight="28" ColumnSpacing="8" Padding="0,0,4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PmvniRailIndicatorStyle}" Visibility="{x:Bind IndicadorVisivel, Mode=OneWay}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Rotulo}" Margin="{x:Bind Recuo}" FontWeight="{x:Bind Peso}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind FolhaTexto}" Style="{StaticResource PmvniSecondaryTextStyle}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <!-- Centro: o relatório inteiro, em folhas A4 empilhadas (a página web desenha as folhas sobre o fundo cinza). -->
      <Grid Grid.Column="1" x:Name="AreaCentral">
        <controls:WebView2 x:Name="Navegador"/>
        <Grid x:Name="Espera" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.94">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <ProgressRing x:Name="Anel" IsActive="False" Width="48" Height="48"/>
            <TextBlock x:Name="TextoEspera" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="TextoVazio" Text="Abra um relatório (dados.json do kit) para ver as folhas."
                   Style="{StaticResource PmvniSecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Grid>
    </Grid>

    <!-- Rodapé da janela: zoom e indicador de folha. -->
    <Grid x:Name="Rodape" Grid.Row="3" Height="44" Padding="12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="BotaoMenos" Style="{StaticResource PmvniBarraButtonStyle}" Click="AoDiminuir" AutomationProperties.Name="Diminuir o zoom"
                MinWidth="36" IsEnabled="False">
          <TextBlock Text="−" FontSize="16"/>
        </Button>
        <TextBlock x:Name="TextoZoom" Text="100 %" Width="52" TextAlignment="Center" VerticalAlignment="Center"/>
        <Button x:Name="BotaoMais" Style="{StaticResource PmvniBarraButtonStyle}" Click="AoAumentar" AutomationProperties.Name="Aumentar o zoom"
                MinWidth="36" IsEnabled="False">
          <TextBlock Text="+" FontSize="16"/>
        </Button>
        <Button x:Name="BotaoLargura" Style="{StaticResource PmvniBarraButtonStyle}" Click="AoAjustarLargura" Content="Ajustar largura" Margin="10,0,0,0" IsEnabled="False"/>
        <Button x:Name="BotaoPagina" Style="{StaticResource PmvniBarraButtonStyle}" Click="AoPaginaInteira" Content="Página inteira" IsEnabled="False"/>
      </StackPanel>
      <TextBlock x:Name="TextoFolha" Grid.Column="2" Text="" VerticalAlignment="Center" Margin="0,0,6,0"/>
    </Grid>
  </Grid>
</Window>
